+static cf_id_t
+id_from_json_field(const cJSON *root, const char *field_name)
+{
+    cf_id_t id = {0};
+    const cJSON *field = cJSON_GetObjectItemCaseSensitive(root, field_name);
+    if (cJSON_IsNumber(field) && field->valuedouble > 0)
+    {
+        id.value = (uint64_t)field->valuedouble;
+    }
+    else if (cJSON_IsString(field) && field->valuestring)
+    {
+        char *end = NULL;
+        unsigned long long parsed = strtoull(field->valuestring, &end, 10);
+        if (end && *end == '\0')
+        {
+            id.value = (uint64_t)parsed;
+        }
+    }
+    return id;
+}
+
+static char *
+json_dependency_payload(const cf_task_dependency_t *dependency)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddNumberToObject(root, "id", (double)dependency->id.value);
+    cJSON_AddNumberToObject(root, "dependentTaskId", (double)dependency->dependent_task_id.value);
+    cJSON_AddNumberToObject(root, "blockingTaskId", (double)dependency->blocking_task_id.value);
+    cJSON_AddNullToObject(root, "blockingTask");
+
+    char *json = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    return json;
+}
+
+static chrono_gql_error_t
+resolve_task_blocking_tasks(void *user_data,
+                            const char *field_name,
+                            const char *arguments_json,
+                            char **out_json)
+{
+    (void)user_data;
+    (void)field_name;
+    if (!arguments_json || !out_json)
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    cJSON *args = cJSON_Parse(arguments_json);
+    if (!args)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    cf_id_t task_id = id_from_json_field(args, "id");
+    if (cf_id_is_null(task_id))
+    {
+        task_id = id_from_json_field(args, "taskId");
+    }
+    cJSON_Delete(args);
+
+    if (cf_id_is_null(task_id))
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    cf_get_task_dependencies_query_t query = { .task_id = task_id };
+    cf_get_task_dependencies_result_t deps = {0};
+    CfError err = {0};
+    if (cf_handle_task_dependencies_query(&query, &deps, &err) != 0)
+    {
+        return CHRONO_GQL_ERR_RESOLVER;
+    }
+
+    cJSON *array = cJSON_CreateArray();
+    for (size_t i = 0; i < deps.count; ++i)
+    {
+        cJSON *task = cJSON_CreateObject();
+        cJSON_AddNumberToObject(task, "id", (double)deps.dependencies[i].blocking_task_id.value);
+        cJSON_AddItemToArray(array, task);
+    }
+
+    *out_json = cJSON_PrintUnformatted(array);
+    cJSON_Delete(array);
+    cf_task_dependencies_result_free(&deps);
+    return *out_json ? CHRONO_GQL_OK : CHRONO_GQL_ERR_OOM;
+}
+
+static chrono_gql_error_t
+resolve_create_task_dependency(void *user_data,
+                               const char *field_name,
+                               const char *arguments_json,
+                               char **out_json)
+{
+    (void)user_data;
+    (void)field_name;
+    if (!arguments_json || !out_json)
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    cJSON *args = cJSON_Parse(arguments_json);
+    if (!args)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    cf_graphql_create_task_dependency_command_t payload = {
+        .dependent_task_id = id_from_json_field(args, "dependentTaskId"),
+        .blocking_task_id = id_from_json_field(args, "blockingTaskId")
+    };
+    cJSON_Delete(args);
+
+    if (cf_id_is_null(payload.dependent_task_id) || cf_id_is_null(payload.blocking_task_id))
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    CF_Command cmd = {
+        .type = CF_CMD_CREATE_TASK_DEPENDENCY,
+        .payload = &payload
+    };
+    CF_CommandResult result = cf_dispatch_command(&cmd);
+    if (result.status != CF_STATUS_OK)
+    {
+        cf_free_command_result(&result);
+        return result.status == CF_STATUS_CONFLICT ? CHRONO_GQL_ERR_RESOLVER : CHRONO_GQL_ERR_INTERNAL;
+    }
+
+    cf_task_dependency_t dependency = {
+        .dependent_task_id = payload.dependent_task_id,
+        .blocking_task_id = payload.blocking_task_id
+    };
+    *out_json = json_dependency_payload(&dependency);
+    cf_free_command_result(&result);
+    return *out_json ? CHRONO_GQL_OK : CHRONO_GQL_ERR_OOM;
+}
