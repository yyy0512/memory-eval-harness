+/*-----------------------------------------------------------------------------
+ *  /v1/tasks/{taskId}/dependencies  (POST)
+ *---------------------------------------------------------------------------*/
+static void
+handle_post_task_dependency(const http_request_t *req, http_response_t *res,
+                            cf_api_id_t dependent_task_id)
+{
+    if (strcmp(req->content_type, "application/json") != 0)
+    {
+        json_error(res, 415, "Unsupported Media Type", "Expecting application/json payload");
+        return;
+    }
+
+    cJSON *root = cJSON_ParseWithLength(req->body, req->body_length);
+    if (!root || !cJSON_IsObject(root))
+    {
+        json_error(res, 400, "Bad Request", "Malformed JSON");
+        if (root) cJSON_Delete(root);
+        return;
+    }
+
+    const cJSON *blocking_id = cJSON_GetObjectItemCaseSensitive(root, "blocking_task_id");
+    if (!cJSON_IsNumber(blocking_id) || blocking_id->valuedouble <= 0)
+    {
+        json_error(res, 422, "Unprocessable Entity", "Field [blocking_task_id] is mandatory");
+        cJSON_Delete(root);
+        return;
+    }
+
+    cf_api_create_task_dependency_command_t payload = {
+        .blocking_task_id = { .value = (uint64_t)blocking_id->valuedouble },
+        .dependent_task_id = dependent_task_id
+    };
+    CF_Command cmd = {
+        .type = CF_CMD_CREATE_TASK_DEPENDENCY,
+        .payload = &payload
+    };
+
+    CF_CommandResult result = cf_dispatch_command(&cmd);
+    if (result.status != CF_STATUS_OK)
+    {
+        json_error(res, status_to_http(result.status),
+                   result.status == CF_STATUS_CONFLICT ? "Conflict" : "Unprocessable Entity",
+                   result.message[0] ? result.message : NULL);
+        cf_free_command_result(&result);
+        cJSON_Delete(root);
+        return;
+    }
+
+    write_dependency_response(res, &payload);
+    cf_free_command_result(&result);
+    cJSON_Delete(root);
+}
