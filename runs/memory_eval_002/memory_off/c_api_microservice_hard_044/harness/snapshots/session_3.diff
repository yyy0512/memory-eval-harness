+static CF_CommandResult
+handle_create_task_dependency(const cf_create_task_dependency_command_t *payload)
+{
+    CF_CHECK(payload, CF_STATUS_INVALID_ARGUMENT,
+             "Task dependency payload is NULL");
+    CF_CHECK(!cf_id_is_null(payload->blocking_task_id) &&
+             !cf_id_is_null(payload->dependent_task_id),
+             CF_STATUS_VALIDATION_FAILED,
+             "Task dependency ids must be provided");
+    CF_CHECK(payload->blocking_task_id.value != payload->dependent_task_id.value,
+             CF_STATUS_VALIDATION_FAILED,
+             "Task cannot depend on itself");
+
+    if (cf_task_dependency_path_exists(payload->dependent_task_id,
+                                       payload->blocking_task_id)) {
+        return (CF_CommandResult){
+            .status = CF_STATUS_CONFLICT,
+            .message = "Task dependency would create a cycle"
+        };
+    }
+
+    cf_task_dependency_t dependency = {
+        .blocking_task_id = payload->blocking_task_id,
+        .dependent_task_id = payload->dependent_task_id
+    };
+    cf_task_dependency_t created = {0};
+
+    cf_service_write_lock();
+    int rc = create_task_dependency(&dependency, &created);
+    cf_service_write_unlock();
+
+    if (rc != 0) {
+        return (CF_CommandResult){
+            .status = CF_STATUS_INTERNAL_ERROR,
+            .message = "Failed to persist task dependency"
+        };
+    }
+
+    CF_CommandResult result = {
+        .status = CF_STATUS_OK
+    };
+    snprintf(result.message, sizeof(result.message),
+             "Task dependency created (id=%llu)",
+             (unsigned long long)created.id.value);
+    return result;
+}
+
+static CF_CommandResult
+handle_update_task(const cf_update_task_command_t *payload)
+{
+    CF_CHECK(payload, CF_STATUS_INVALID_ARGUMENT,
+             "Update task payload is NULL");
+    CF_CHECK(!cf_id_is_null(payload->task_id), CF_STATUS_VALIDATION_FAILED,
+             "Invalid task id");
+
+    if (payload->completed) {
+        cf_task_dependency_t *dependencies = NULL;
+        size_t dependency_count = 0;
+        int dep_rc = get_blocking_tasks_for_task(payload->task_id,
+                                                 &dependencies,
+                                                 &dependency_count);
+        if (dep_rc != 0) {
+            free(dependencies);
+            return (CF_CommandResult){
+                .status = CF_STATUS_INTERNAL_ERROR,
+                .message = "Failed to load task dependencies"
+            };
+        }
+
+        for (size_t i = 0; i < dependency_count; ++i) {
+            cf_task_record_t blocking_task = {0};
+            int task_rc = repository_get_task(dependencies[i].blocking_task_id,
+                                              &blocking_task);
+            if (task_rc != 0) {
+                free(dependencies);
+                return (CF_CommandResult){
+                    .status = CF_STATUS_INTERNAL_ERROR,
+                    .message = "Failed to load prerequisite task"
+                };
+            }
+
+            if (!blocking_task.completed) {
+                free(dependencies);
+                return (CF_CommandResult){
+                    .status = CF_STATUS_CONFLICT,
+                    .message = "Cannot complete task until prerequisites are completed"
+                };
+            }
+        }
+
+        free(dependencies);
+    }
+
+    cf_service_write_lock();
+    int update_rc = repository_update_task_status(payload->task_id,
+                                                  payload->completed);
+    cf_service_write_unlock();
+
+    if (update_rc != 0) {
+        return (CF_CommandResult){
+            .status = CF_STATUS_INTERNAL_ERROR,
+            .message = "Failed to update task"
+        };
+    }
+
+    return (CF_CommandResult){
+        .status = CF_STATUS_OK,
+        .message = "Task updated"
+    };
+}
+
+static bool
+cf_task_dependency_path_exists(cf_id_t from_task_id, cf_id_t target_task_id)
+{
+    if (cf_id_is_null(from_task_id) || cf_id_is_null(target_task_id)) {
+        return false;
+    }
+    if (from_task_id.value == target_task_id.value) {
+        return true;
+    }
+
+    cf_task_dependency_t *dependencies = NULL;
+    size_t dependency_count = 0;
+    if (get_blocking_tasks_for_task(from_task_id, &dependencies,
+                                    &dependency_count) != 0) {
+        free(dependencies);
+        return false;
+    }
+
+    for (size_t i = 0; i < dependency_count; ++i) {
+        cf_id_t next_task_id = dependencies[i].blocking_task_id;
+        if (next_task_id.value == target_task_id.value) {
+            free(dependencies);
+            return true;
+        }
+        if (cf_task_dependency_path_exists(next_task_id, target_task_id)) {
+            free(dependencies);
+            return true;
+        }
+    }
+
+    free(dependencies);
+    return false;
+}
