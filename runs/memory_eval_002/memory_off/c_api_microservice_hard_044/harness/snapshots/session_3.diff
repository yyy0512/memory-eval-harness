+static void
+write_dependency_response(http_response_t *res,
+                          const cf_api_create_task_dependency_command_t *cmd)
+{
+    cJSON *resp = cJSON_CreateObject();
+    cJSON_AddNumberToObject(resp, "dependent_task_id", (double)cmd->dependent_task_id.value);
+    cJSON_AddNumberToObject(resp, "blocking_task_id", (double)cmd->blocking_task_id.value);
+
+    char *body = cJSON_PrintUnformatted(resp);
+    cJSON_Delete(resp);
+
+    http_response_set_status(res, 201);
+    http_response_set_header(res, "Content-Type", "application/json; charset=utf-8");
+    http_response_set_body(res, body, strlen(body));
+
+    free(body);
+}
