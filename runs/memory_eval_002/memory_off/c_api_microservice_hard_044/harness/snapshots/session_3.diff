+static bool
+parse_task_dependencies_uri(const char *uri, cf_api_id_t *task_id)
+{
+    static const char prefix[] = "/v1/tasks/";
+    static const char suffix[] = "/dependencies";
+
+    if (!uri || !task_id || strncmp(uri, prefix, sizeof(prefix) - 1) != 0)
+    {
+        return false;
+    }
+
+    const char *id_start = uri + sizeof(prefix) - 1;
+    char *id_end = NULL;
+    errno = 0;
+    unsigned long long id = strtoull(id_start, &id_end, 10);
+    if (errno != 0 || id_end == id_start || id == 0)
+    {
+        return false;
+    }
+
+    if (strcmp(id_end, suffix) != 0)
+    {
+        return false;
+    }
+
+    task_id->value = (uint64_t)id;
+    return true;
+}
+
+static int
+status_to_http(int status)
+{
+    switch (status)
+    {
+        case CF_STATUS_OK:
+            return 201;
+        case CF_STATUS_CONFLICT:
+            return 409;
+        case CF_STATUS_INVALID_ARGUMENT:
+            return 400;
+        case CF_STATUS_VALIDATION_FAILED:
+            return 422;
+        default:
+            return 500;
+    }
+}
