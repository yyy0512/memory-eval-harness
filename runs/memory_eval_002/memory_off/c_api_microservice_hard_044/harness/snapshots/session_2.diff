+/*--------------------------------------------------------------------
+ * CRUD – Task dependencies
+ *------------------------------------------------------------------*/
+cf_error_t create_task_dependency(const cf_task_dependency_t *dependency,
+                                  cf_task_dependency_t *out_created)
+{
+    if (!dependency || !out_created ||
+        cf_id_is_null(dependency->blocking_task_id) ||
+        cf_id_is_null(dependency->dependent_task_id)) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    const char *sql =
+        "INSERT INTO task_dependencies (blocking_task_id, dependent_task_id, created_at) "
+        "VALUES ($1, $2, EXTRACT(EPOCH FROM NOW())::bigint) "
+        "RETURNING dependency_id, blocking_task_id, dependent_task_id";
+
+    char blocking_id[32];
+    char dependent_id[32];
+    _cf_id_to_param(dependency->blocking_task_id, blocking_id, sizeof blocking_id);
+    _cf_id_to_param(dependency->dependent_task_id, dependent_id, sizeof dependent_id);
+
+    const char *params[2] = { blocking_id, dependent_id };
+
+    struct {
+        int found;
+        cf_task_dependency_t created;
+    } ctx = { .found = 0 };
+
+    int rc = cf_repo_execute(sql, 2, params,
+        [](int row, PGresult *res, void *ud) -> int {
+            (void)row;
+            struct { int found; cf_task_dependency_t created; } *ctx = ud;
+            ctx->created.id = _cf_id_from_db(PQgetvalue(res, row, 0));
+            ctx->created.blocking_task_id = _cf_id_from_db(PQgetvalue(res, row, 1));
+            ctx->created.dependent_task_id = _cf_id_from_db(PQgetvalue(res, row, 2));
+            ctx->found = 1;
+            return 0;
+        },
+        &ctx);
+
+    if (rc != CF_ERR_OK) {
+        return rc;
+    }
+    if (!ctx.found) {
+        return CF_ERR_NOT_FOUND;
+    }
+
+    *out_created = ctx.created;
+    return CF_ERR_OK;
+}
+
+cf_error_t get_blocking_tasks_for_task(cf_id_t task_id,
+                                       cf_task_dependency_t **out_dependencies,
+                                       size_t *out_count)
+{
+    if (cf_id_is_null(task_id) || !out_dependencies || !out_count) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    *out_dependencies = NULL;
+    *out_count = 0;
+
+    const char *sql =
+        "SELECT dependency_id, blocking_task_id, dependent_task_id "
+        "FROM task_dependencies "
+        "WHERE dependent_task_id = $1 "
+        "ORDER BY dependency_id";
+
+    char dependent_id[32];
+    _cf_id_to_param(task_id, dependent_id, sizeof dependent_id);
+    const char *params[1] = { dependent_id };
+
+    struct {
+        cf_task_dependency_t *items;
+        size_t count;
+        size_t capacity;
+        int failed;
+    } ctx = { .items = NULL, .count = 0, .capacity = 0, .failed = 0 };
+
+    int rc = cf_repo_execute(sql, 1, params,
+        [](int row, PGresult *res, void *ud) -> int {
+            (void)row;
+            struct {
+                cf_task_dependency_t *items;
+                size_t count;
+                size_t capacity;
+                int failed;
+            } *ctx = ud;
+
+            if (ctx->count == ctx->capacity) {
+                size_t next_capacity = ctx->capacity == 0 ? 4 : ctx->capacity * 2;
+                cf_task_dependency_t *next_items = realloc(ctx->items,
+                    next_capacity * sizeof *next_items);
+                if (!next_items) {
+                    ctx->failed = 1;
+                    return -1;
+                }
+                ctx->items = next_items;
+                ctx->capacity = next_capacity;
+            }
+
+            ctx->items[ctx->count++] = (cf_task_dependency_t){
+                .id = _cf_id_from_db(PQgetvalue(res, row, 0)),
+                .blocking_task_id = _cf_id_from_db(PQgetvalue(res, row, 1)),
+                .dependent_task_id = _cf_id_from_db(PQgetvalue(res, row, 2))
+            };
+            return 0;
+        },
+        &ctx);
+
+    if (rc != CF_ERR_OK) {
+        free(ctx.items);
+        return rc;
+    }
+    if (ctx.failed) {
+        free(ctx.items);
+        return CF_ERR_INTERNAL;
+    }
+
+    *out_dependencies = ctx.items;
+    *out_count = ctx.count;
+    return CF_ERR_OK;
+}
+
+cf_error_t delete_dependency(cf_id_t dependency_id)
+{
+    if (cf_id_is_null(dependency_id)) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    const char *sql =
+        "DELETE FROM task_dependencies "
+        "WHERE dependency_id = $1";
+
+    char id[32];
+    _cf_id_to_param(dependency_id, id, sizeof id);
+    const char *params[1] = { id };
+
+    return cf_repo_execute(sql, 1, params, NULL, NULL);
+}
