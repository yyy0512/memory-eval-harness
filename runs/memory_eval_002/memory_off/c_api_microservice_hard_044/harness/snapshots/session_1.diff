+static cf_id_t _cf_id_from_db(const char *value)
+{
+    if (!value) {
+        return CF_ID_NULL;
+    }
+
+    errno = 0;
+    char *end = NULL;
+    unsigned long long parsed = strtoull(value, &end, 10);
+    if (errno != 0 || end == value) {
+        return CF_ID_NULL;
+    }
+
+    return (cf_id_t){ .value = (uint64_t)parsed };
+}
+
+static void _cf_id_to_param(cf_id_t id, char *buffer, size_t buffer_len)
+{
+    snprintf(buffer, buffer_len, "%llu", (unsigned long long)id.value);
+}
