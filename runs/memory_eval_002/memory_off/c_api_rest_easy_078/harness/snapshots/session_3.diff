 }
 
+/* Return the first request IP header value supplied by the HTTP adapter. */
+static const char *get_client_ip(const http_request_t *req)
+{
+    const char *ip = http_req_header(req, HEADER_REAL_IP);
+
+    if (ip && *ip) {
+        return ip;
+    }
+
+    ip = http_req_header(req, HEADER_FORWARDED_FOR);
+    if (ip && *ip) {
+        return ip;
+    }
+
+    return "unknown";
+}
