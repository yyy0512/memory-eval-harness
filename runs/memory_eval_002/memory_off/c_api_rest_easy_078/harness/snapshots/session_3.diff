+/* Adds the standard rate-limit headers */
+static void add_rate_limit_headers(http_response_t *res, const char *client_ip)
+{
+    char limit[32];
+    char remaining[32];
+    char reset[32];
+
+    snprintf(limit, sizeof(limit), "%d", RATE_LIMIT_MAX_REQUESTS);
+    snprintf(remaining, sizeof(remaining), "%d",
+             rate_limiter_get_remaining(client_ip));
+    snprintf(reset, sizeof(reset), "%ld", rate_limiter_get_reset_epoch(client_ip));
+
+    http_resp_header(res, "X-RateLimit-Limit", limit);
+    http_resp_header(res, "X-RateLimit-Remaining", remaining);
+    http_resp_header(res, "X-RateLimit-Reset", reset);
+}
+
