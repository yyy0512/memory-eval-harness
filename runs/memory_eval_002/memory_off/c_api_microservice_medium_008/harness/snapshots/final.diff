+static int connect_upstream(const char *host, const char *port) {
+    struct addrinfo hints;
+    struct addrinfo *result = NULL;
+    struct addrinfo *it;
+    int fd = -1;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+
+    if (getaddrinfo(host, port, &hints, &result) != 0) {
+        return -1;
+    }
+
+    for (it = result; it; it = it->ai_next) {
+        fd = socket(it->ai_family, it->ai_socktype, it->ai_protocol);
+        if (fd < 0) {
+            continue;
+        }
+        if (connect(fd, it->ai_addr, it->ai_addrlen) == 0) {
+            break;
+        }
+        close(fd);
+        fd = -1;
+    }
+
+    freeaddrinfo(result);
+    return fd;
+}
+
+static void handle_create_order_proxy(struct mg_connection *c,
+                                      struct mg_http_message *hm) {
+    char request[12288];
+    char response[UPSTREAM_RESPONSE_MAX + 1U];
+    ssize_t nread;
+    int fd;
+    int request_len;
+
+    if (hm->method.len != 4 || strncasecmp(hm->method.ptr, "POST", 4) != 0) {
+        send_text(c, 405, "Orders endpoint expects POST");
+        return;
+    }
+
+    fd = connect_upstream(g_cfg.order_service_host, g_cfg.order_service_port);
+    if (fd < 0) {
+        slog(LL_ERROR, "orders", "failed to connect to order_service at %s:%s",
+             g_cfg.order_service_host, g_cfg.order_service_port);
+        send_text(c, 502, "Order service unavailable");
+        return;
+    }
+
+    request_len = snprintf(request, sizeof(request),
+                           "POST %s HTTP/1.1\r\n"
+                           "Host: %s:%s\r\n"
+                           "Content-Type: application/json\r\n"
+                           "Content-Length: %zu\r\n"
+                           "Connection: close\r\n\r\n"
+                           "%.*s",
+                           ORDERS_PATH,
+                           g_cfg.order_service_host,
+                           g_cfg.order_service_port,
+                           hm->body.len,
+                           (int)hm->body.len,
+                           hm->body.ptr);
+    if (request_len <= 0 || (size_t)request_len >= sizeof(request)) {
+        close(fd);
+        send_text(c, 413, "Order request is too large");
+        return;
+    }
+
+    if (send(fd, request, (size_t)request_len, 0) != request_len) {
+        close(fd);
+        send_text(c, 502, "Order service request failed");
+        return;
+    }
+
+    nread = recv(fd, response, UPSTREAM_RESPONSE_MAX, 0);
+    close(fd);
+    if (nread <= 0) {
+        send_text(c, 502, "Order service returned no response");
+        return;
+    }
+
+    response[nread] = '\0';
+    mg_send(c, response, (size_t)nread);
+}
