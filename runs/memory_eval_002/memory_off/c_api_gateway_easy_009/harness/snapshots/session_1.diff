+static const char *
+client_ip_from_connection(struct MHD_Connection *conn, char *buf, size_t buf_len)
+{
+    const union MHD_ConnectionInfo *info =
+        MHD_get_connection_info(conn, MHD_CONNECTION_INFO_CLIENT_ADDRESS);
+
+    if (!info || !info->client_addr)
+        return "unknown";
+
+    const struct sockaddr *addr = info->client_addr;
+    if (addr->sa_family == AF_INET) {
+        const struct sockaddr_in *ipv4 = (const struct sockaddr_in *)addr;
+        return inet_ntop(AF_INET, &ipv4->sin_addr, buf, (socklen_t)buf_len) ? buf : "unknown";
+    }
+
+    if (addr->sa_family == AF_INET6) {
+        const struct sockaddr_in6 *ipv6 = (const struct sockaddr_in6 *)addr;
+        return inet_ntop(AF_INET6, &ipv6->sin6_addr, buf, (socklen_t)buf_len) ? buf : "unknown";
+    }
+
+    return "unknown";
+}
 
