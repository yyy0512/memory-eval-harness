+/* Rate-limit configuration parser                                           */
 /* ------------------------------------------------------------------------- */
 
+typedef struct {
+    char version[32];
+    unsigned int requests;
+    unsigned int window_seconds;
+} rate_limit_version_config_t;
+
+typedef struct {
+    bool enabled;
+    unsigned int requests;
+    unsigned int window_seconds;
+    rate_limit_version_config_t versions[MAX_RATE_LIMIT_VERSION_CONFIGS];
+    size_t version_count;
+} rate_limit_config_t;
+
+static char *
+trim_whitespace(char *s)
+{
+    while (*s && isspace((unsigned char)*s))
+        ++s;
+
+    char *end = s + strlen(s);
+    while (end > s && isspace((unsigned char)end[-1]))
+        *--end = '\0';
+
+    return s;
+}
+
+static bool
+parse_bool_value(const char *value, bool *out)
+{
+    if (strcmp(value, "true") == 0) {
+        *out = true;
+        return true;
+    }
+
+    if (strcmp(value, "false") == 0) {
+        *out = false;
+        return true;
+    }
+
+    return false;
+}
+
+static bool
+parse_unsigned_value(const char *value, unsigned int *out)
+{
+    if (!*value)
+        return false;
+
+    char *end = NULL;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (*trim_whitespace(end) != '\0' || parsed == 0 || parsed > UINT32_MAX)
+        return false;
+
+    *out = (unsigned int)parsed;
+    return true;
+}
+
+static bool
+parse_rate_limit_pair(const char *value, unsigned int *requests,
+                      unsigned int *window_seconds)
+{
+    char buf[128];
+    snprintf(buf, sizeof(buf), "%s", value);
+
+    char *separator = strchr(buf, ':');
+    if (!separator)
+        return false;
+
+    *separator = '\0';
+    char *request_value = trim_whitespace(buf);
+    char *window_value = trim_whitespace(separator + 1);
+
+    return parse_unsigned_value(request_value, requests) &&
+           parse_unsigned_value(window_value, window_seconds);
+}
+
+static void
+add_version_rate_limit(rate_limit_config_t *cfg, const char *version,
+                       unsigned int requests, unsigned int window_seconds)
+{
+    for (size_t i = 0; i < cfg->version_count; ++i) {
+        if (strcmp(cfg->versions[i].version, version) == 0) {
+            cfg->versions[i].requests = requests;
+            cfg->versions[i].window_seconds = window_seconds;
+            return;
+        }
+    }
+
+    if (cfg->version_count >= MAX_RATE_LIMIT_VERSION_CONFIGS)
+        return;
+
+    rate_limit_version_config_t *version_cfg = &cfg->versions[cfg->version_count++];
+    snprintf(version_cfg->version, sizeof(version_cfg->version), "%s", version);
+    version_cfg->requests = requests;
+    version_cfg->window_seconds = window_seconds;
+}
+
+static void
+load_rate_limit_config(rate_limit_config_t *cfg)
+{
+    cfg->enabled = DEFAULT_RATE_LIMIT_ENABLED;
+    cfg->requests = DEFAULT_RATE_LIMIT_REQUESTS;
+    cfg->window_seconds = DEFAULT_RATE_LIMIT_WINDOW_SECONDS;
+    cfg->version_count = 0;
+
+    FILE *fp = fopen(GATEWAY_CONFIG_PATH, "r");
+    if (!fp) {
+        LOG_WARN("config/gateway.conf not found; using default rate-limit settings");
+        return;
+    }
+
+    char line[256];
+    while (fgets(line, sizeof(line), fp)) {
+        char *comment = strchr(line, '#');
+        if (comment)
+            *comment = '\0';
+
+        char *key = trim_whitespace(line);
+        if (!*key)
+            continue;
+
+        char *separator = strchr(key, '=');
+        if (!separator)
+            continue;
+
+        *separator = '\0';
+        char *value = trim_whitespace(separator + 1);
+        key = trim_whitespace(key);
+
+        if (strcmp(key, "rate_limit_enabled") == 0) {
+            bool enabled;
+            if (parse_bool_value(value, &enabled))
+                cfg->enabled = enabled;
+        } else if (strcmp(key, "rate_limit_requests") == 0) {
+            unsigned int requests;
+            if (parse_unsigned_value(value, &requests))
+                cfg->requests = requests;
+        } else if (strcmp(key, "rate_limit_window_seconds") == 0) {
+            unsigned int window_seconds;
+            if (parse_unsigned_value(value, &window_seconds))
+                cfg->window_seconds = window_seconds;
+        } else if (strncmp(key, "rate_limit_", strlen("rate_limit_")) == 0) {
+            const char *version = key + strlen("rate_limit_");
+            unsigned int requests;
+            unsigned int window_seconds;
+            if (*version && parse_rate_limit_pair(value, &requests, &window_seconds))
+                add_version_rate_limit(cfg, version, requests, window_seconds);
+        }
+    }
+
+    fclose(fp);
+}
