diff --git a/UtiliREST_EchoHub/Makefile b/UtiliREST_EchoHub/Makefile
index ee95d30..f4b23dc 100644
--- a/UtiliREST_EchoHub/Makefile
+++ b/UtiliREST_EchoHub/Makefile
@@ -43,7 +43,7 @@ OPT_DEBUG      = -O0 -g3
 STD            = -std=c11
 DEFINES        = -DPROJECT_VERSION=\"$(VERSION)\"
 
-CFLAGS_COMMON  = $(STD) $(WARNINGS) $(DEFINES) -fPIC
+CFLAGS_COMMON  = $(STD) $(WARNINGS) $(DEFINES) -Iinclude -I. -fPIC
 LDFLAGS_COMMON =
 
 # Libraries discovered via pkg-config
@@ -90,8 +90,9 @@ JOBS ?= $(shell nproc 2>/dev/null || echo 4)
 SRC  := $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c))
 OBJ  := $(patsubst %.c,$(OBJ_DIR)/%.o,$(SRC))
 
-TEST_SRC := $(wildcard $(TEST_DIR)/*.c)
-TEST_OBJ := $(patsubst %.c,$(OBJ_DIR)/%.o,$(TEST_SRC))
+TEST_SRC := tests/test_rate_limiter.c
+TEST_SUPPORT_SRC := src/rate_limiter.c
+TEST_OBJ := $(patsubst %.c,$(OBJ_DIR)/%.o,$(TEST_SRC) $(TEST_SUPPORT_SRC))
 
 #------------------------------------------------------------------------------
 # Default target
@@ -122,7 +123,7 @@ test: $(UNIT_TEST_BIN)
 	@echo "Running unit tests…"
 	@./$(UNIT_TEST_BIN)
 
-$(UNIT_TEST_BIN): $(OBJ) $(TEST_OBJ)
+$(UNIT_TEST_BIN): $(TEST_OBJ)
 	@$(MKDIR_P) $(BIN_DIR)
 	$(CC) $^ $(LDFLAGS) -o $@
 
