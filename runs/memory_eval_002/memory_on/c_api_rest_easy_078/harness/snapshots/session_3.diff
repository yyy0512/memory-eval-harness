+/* Extracts the best available client IP from forwarding headers */
+static const char *client_ip_address(const http_request_t *req,
+                                     char                *buf,
+                                     size_t               buf_len)
+{
+    const char *forwarded_for = http_req_header(req, HEADER_FORWARDED_FOR);
+    if (forwarded_for && *forwarded_for != '\0') {
+        while (*forwarded_for && isspace((unsigned char)*forwarded_for)) {
+            forwarded_for++;
+        }
+        size_t len = strcspn(forwarded_for, ",");
+        while (len > 0 && isspace((unsigned char)forwarded_for[len - 1])) {
+            len--;
+        }
+        if (len >= buf_len) {
+            len = buf_len - 1;
+        }
+        memcpy(buf, forwarded_for, len);
+        buf[len] = '\0';
+        return buf;
+    }
+
+    const char *real_ip = http_req_header(req, HEADER_REAL_IP);
+    if (real_ip && *real_ip != '\0') {
+        return real_ip;
+    }
+
+    return "unknown";
+}
+
+/* Updates rate limit metadata headers with request-specific client state */
+static void add_request_rate_limit_headers(http_response_t      *res,
+                                           const http_request_t *req)
+{
+    char client_ip[64];
+    add_rate_limit_headers(res, client_ip_address(req, client_ip,
+                                                  sizeof client_ip));
+}
