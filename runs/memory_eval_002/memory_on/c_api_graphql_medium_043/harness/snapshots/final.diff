+/* ────────────────────────────────────────────────────────────────────────── */
+/* GraphQL WebSocket message handling                                        */
+
+static char *
+json_object_string_dup(struct json_object *obj, const char *key)
+{
+    struct json_object *value;
+    if (!json_object_object_get_ex(obj, key, &value) ||
+        !json_object_is_type(value, json_type_string)) {
+        return NULL;
+    }
+
+    const char *s = json_object_get_string(value);
+    return s ? strdup(s) : NULL;
+}
+
+static char *
+json_object_compact_dup(struct json_object *obj, const char *key)
+{
+    struct json_object *value;
+    if (!json_object_object_get_ex(obj, key, &value) ||
+        !json_object_is_type(value, json_type_object)) {
+        return NULL;
+    }
+
+    const char *s = json_object_to_json_string_ext(value, JSON_C_TO_STRING_PLAIN);
+    return s ? strdup(s) : NULL;
+}
+
+static int
+operation_kind_for_query(const char *query, gql_operation_kind_t *out)
+{
+    gql_document_t doc;
+    char errbuf[256];
+
+    if (graphql_parse_document(query, &doc, errbuf, sizeof(errbuf)) != 0) {
+        log_warn("websocket: failed to parse GraphQL document: %s", errbuf);
+        return -1;
+    }
+
+    if (doc.op_cnt == 0) {
+        graphql_free_document(&doc);
+        log_warn("websocket: GraphQL document had no operations");
+        return -1;
+    }
+
+    *out = doc.operations[0].kind;
+    graphql_free_document(&doc);
+    return 0;
+}
+
+static int
+handle_graphql_ws_message(pstream_ws_client_t *client,
+                          const uint8_t *payload,
+                          size_t len)
+{
+    struct json_tokener *tok = json_tokener_new();
+    if (!tok)
+        return -1;
+
+    struct json_object *root = json_tokener_parse_ex(tok, (const char *)payload, (int)len);
+    enum json_tokener_error jerr = json_tokener_get_error(tok);
+    json_tokener_free(tok);
+
+    if (jerr != json_tokener_success || !root ||
+        !json_object_is_type(root, json_type_object)) {
+        if (root)
+            json_object_put(root);
+        log_warn("websocket: invalid GraphQL WS JSON payload from uid=%"PRIu64,
+                 client->claims.user_id);
+        return 0;
+    }
+
+    char *type = json_object_string_dup(root, "type");
+    if (!type) {
+        json_object_put(root);
+        log_warn("websocket: GraphQL WS message missing type from uid=%"PRIu64,
+                 client->claims.user_id);
+        return 0;
+    }
+
+    if (strcmp(type, "start") != 0) {
+        log_debug("websocket: ignoring GraphQL WS message type=%s uid=%"PRIu64,
+                  type, client->claims.user_id);
+        free(type);
+        json_object_put(root);
+        return 0;
+    }
+
+    struct json_object *payload_obj;
+    if (!json_object_object_get_ex(root, "payload", &payload_obj) ||
+        !json_object_is_type(payload_obj, json_type_object)) {
+        free(type);
+        json_object_put(root);
+        log_warn("websocket: start message missing payload from uid=%"PRIu64,
+                 client->claims.user_id);
+        return 0;
+    }
+
+    char *id = json_object_string_dup(root, "id");
+    char *query = json_object_string_dup(payload_obj, "query");
+    char *operation_name = json_object_string_dup(payload_obj, "operationName");
+    char *variables_json = json_object_compact_dup(payload_obj, "variables");
+
+    gql_operation_kind_t op_kind;
+    if (!query || operation_kind_for_query(query, &op_kind) != 0) {
+        free(variables_json);
+        free(operation_name);
+        free(query);
+        free(id);
+        free(type);
+        json_object_put(root);
+        return 0;
+    }
+
+    switch (op_kind) {
+    case GQL_OP_SUBSCRIPTION:
+        register_subscription(client, id, query, operation_name, variables_json);
+        break;
+    case GQL_OP_QUERY:
+        log_debug("websocket: received query operation from uid=%"PRIu64,
+                  client->claims.user_id);
+        break;
+    case GQL_OP_MUTATION:
+        log_debug("websocket: received mutation operation from uid=%"PRIu64,
+                  client->claims.user_id);
+        break;
+    }
+
+    free(variables_json);
+    free(operation_name);
+    free(query);
+    free(id);
+    free(type);
+    json_object_put(root);
+    return 0;
+}
+
+static int
+register_subscription(pstream_ws_client_t *client,
+                      const char *id,
+                      const char *query,
+                      const char *operation_name,
+                      const char *variables_json)
+{
+    pstream_ws_subscription_t *sub = calloc(1, sizeof(*sub));
+    if (!sub)
+        return -1;
+
+    sub->id = strdup(id ? id : "");
+    sub->connection_id = (uintptr_t)client->wsi;
+    sub->query = strdup(query);
+    sub->operation_name = operation_name ? strdup(operation_name) : NULL;
+    sub->variables_json = variables_json ? strdup(variables_json) : NULL;
+
+    if (!sub->id || !sub->query || (variables_json && !sub->variables_json)) {
+        free_subscription(sub);
+        return -1;
+    }
+
+    pthread_mutex_lock(&g_ws.lock);
+    sub->next = g_ws.subscriptions;
+    g_ws.subscriptions = sub;
+    pthread_mutex_unlock(&g_ws.lock);
+
+    log_info("websocket: registered subscription id=%s uid=%"PRIu64,
+             sub->id, client->claims.user_id);
+    return 0;
+}
+
+static void
+remove_client_subscriptions(uintptr_t connection_id)
+{
+    pthread_mutex_lock(&g_ws.lock);
+
+    pstream_ws_subscription_t **cur = &g_ws.subscriptions;
+    while (*cur) {
+        pstream_ws_subscription_t *sub = *cur;
+        if (sub->connection_id == connection_id) {
+            *cur = sub->next;
+            free_subscription(sub);
+        } else {
+            cur = &(*cur)->next;
+        }
+    }
+
+    pthread_mutex_unlock(&g_ws.lock);
+}
+
+static void
+free_subscription(pstream_ws_subscription_t *sub)
+{
+    if (!sub)
+        return;
+    free(sub->id);
+    free(sub->query);
+    free(sub->operation_name);
+    free(sub->variables_json);
+    free(sub);
+}
 /* ────────────────────────────────────────────────────────────────────────── */
 /* Helper: JWT authentication                                               */
 
@@ -405,6 +660,14 @@ websocket_handler_shutdown(void)
 {
     event_bus_unsubscribe("stream.*", event_bus_listener, NULL);
 
+    pthread_mutex_lock(&g_ws.lock);
+    while (g_ws.subscriptions) {
+        pstream_ws_subscription_t *sub = g_ws.subscriptions;
+        g_ws.subscriptions = sub->next;
+        free_subscription(sub);
+    }
+    pthread_mutex_unlock(&g_ws.lock);
+
     lws_context_destroy(g_ws.ctx);
     pthread_mutex_destroy(&g_ws.lock);
 
