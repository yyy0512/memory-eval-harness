-/* Paginated list (naïve: skip/limit) */
-typedef struct
-{
-    mmx_order_t *orders;
-    size_t       len;
-} mmx_order_list_t;
-
-/* Caller responsible for freeing result->orders */
-int
-mmx_order_list(const mmx_order_store_t *store,
-               const char *tenant_id,
-               size_t skip, size_t limit,
-               mmx_order_list_t *result)
-{
-    if (!store || !tenant_id || !result) return MMX_ERR_ARGUMENT;
-
-    pthread_rwlock_rdlock(&((mmx_order_store_t *)store)->lock);
-
-    size_t total_alloc = 0;
-    mmx_order_t *orders = NULL;
-
-    mmx_order_t *cur, *tmp;
-    HASH_ITER(hh, store->hash_root, cur, tmp) {
-        if (strcmp(cur->tenant_id, tenant_id) != 0)
-            continue;
-        if (skip > 0) { --skip; continue; }
-        if (limit == 0) break;
-
-        mmx_order_t *new_mem = realloc(orders, (total_alloc + 1) * sizeof(*orders));
-        if (!new_mem) {
-            pthread_rwlock_unlock(&((mmx_order_store_t *)store)->lock);
-            free(orders);
-            return MMX_ERR_INTERNAL;
-        }
-        orders = new_mem;
-        memcpy(&orders[total_alloc], cur, sizeof(*cur));
-        ++total_alloc;
-        --limit;
-    }
-
-    pthread_rwlock_unlock(&((mmx_order_store_t *)store)->lock);
-    result->orders = orders;
-    result->len    = total_alloc;
-    return MMX_OK;
-}
