-/* ────────────────────────────────────────────────────────────────────────── */
-/* Rate Limiter (naïve token bucket per tenant)                              */
-/* ────────────────────────────────────────────────────────────────────────── */
-
-typedef struct
-{
-    char            tenant_id[32]; /* key */
-    uint64_t        tokens;
-    uint64_t        last_refill_us;
-    UT_hash_handle  hh;
-} tenant_bucket_t;
-
-static tenant_bucket_t *g_buckets = NULL;
-static pthread_mutex_t  g_bucket_mtx = PTHREAD_MUTEX_INITIALIZER;
-
-#define TOKENS_PER_SEC   5
-#define BUCKET_CAPACITY  10
-
-static int
-ratelimit_check(const char *tenant_id)
-{
-    uint64_t now = mmx_now_us();
-
-    pthread_mutex_lock(&g_bucket_mtx);
-
-    tenant_bucket_t *b = NULL;
-    HASH_FIND_STR(g_buckets, tenant_id, b);
-    if (!b)
-    {
-        b = calloc(1, sizeof(*b));
-        strncpy(b->tenant_id, tenant_id, sizeof(b->tenant_id) - 1);
-        b->tokens = BUCKET_CAPACITY;
-        b->last_refill_us = now;
-        HASH_ADD_STR(g_buckets, tenant_id, b);
-    }
-
-    /* Refill */
-    double elapsed_sec = (double)(now - b->last_refill_us) / 1000000.0;
-    uint64_t add = (uint64_t)(elapsed_sec * TOKENS_PER_SEC);
-    if (add > 0)
-    {
-        b->tokens = (b->tokens + add > BUCKET_CAPACITY) ? BUCKET_CAPACITY : b->tokens + add;
-        b->last_refill_us = now;
-    }
-
-    int ok = (b->tokens > 0) ? MMX_OK : MMX_ERR_LIMIT;
-    if (ok == MMX_OK)
-        --b->tokens;
-
-    pthread_mutex_unlock(&g_bucket_mtx);
-    return ok;
-}
