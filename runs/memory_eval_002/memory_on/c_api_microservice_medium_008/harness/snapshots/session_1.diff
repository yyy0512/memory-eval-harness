-/*
- * Creates a new order.  The caller supplies:
- *   - pre-allocated mmx_order_t with id + items + tenant_id set
- *   - items_len populated
- *
- * The function computes pricing, sets timestamps, and persists.
- */
-int
-mmx_order_create(mmx_order_store_t *store, mmx_order_t *inout)
-{
-    if (!store || !inout) return MMX_ERR_ARGUMENT;
-
-    /* rate limiting per tenant */
-    int rl = ratelimit_check(inout->tenant_id);
-    if (rl != MMX_OK) return rl;
-
-    /* validation */
-    if (validate_order(inout) != MMX_OK) return MMX_ERR_ARGUMENT;
-
-    /* pricing */
-    inout->total = price_compute_total(inout->tenant_id, inout->items, inout->items_len);
-
-    uint64_t now = mmx_now_us();
-    inout->state         = MMX_ORDER_PENDING;
-    inout->created_ts_us = now;
-    inout->updated_ts_us = now;
-
-    /* persist */
-    int rc = store->put(store, inout);
-    if (rc != MMX_OK) return rc;
-
-    LOG_INFO("Order '%s' created for tenant '%s' ($%.2f)",
-             inout->id, inout->tenant_id, inout->total.amount_cents / 100.0);
-    return MMX_OK;
-}
-
-/* Transition order to CANCELLED state. */
-int
-mmx_order_cancel(mmx_order_store_t *store, const char *order_id)
-{
-    if (!store || !order_id) return MMX_ERR_ARGUMENT;
-
-    mmx_order_t o;
-    int rc = store->get(store, order_id, &o);
-    if (rc != MMX_OK) return rc;
-
-    if (o.state == MMX_ORDER_CANCELLED) return MMX_OK; /* idempotent */
-    if (o.state == MMX_ORDER_COMPLETED) return MMX_ERR_ARGUMENT;
-
-    o.state = MMX_ORDER_CANCELLED;
-    o.updated_ts_us = mmx_now_us();
-
-    rc = store->put(store, &o);
-    if (rc != MMX_OK) return rc;
-
-    LOG_INFO("Order '%s' cancelled.", order_id);
-    return MMX_OK;
-}
-
-/* Retrieve by ID */
-int
-mmx_order_get(const mmx_order_store_t *store, const char *order_id, mmx_order_t *out)
-{
-    if (!store || !order_id || !out) return MMX_ERR_ARGUMENT;
-    return store->get((mmx_order_store_t *)store, order_id, out);
-}
