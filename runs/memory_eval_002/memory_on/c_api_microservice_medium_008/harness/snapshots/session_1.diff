-    } else {
-        mmx_order_t *copy = malloc(sizeof(*copy));
-        if (!copy) {
-            pthread_rwlock_unlock(&self->lock);
-            return MMX_ERR_INTERNAL;
-        }
-        memcpy(copy, order, sizeof(*copy));
-        HASH_ADD_STR(self->hash_root, id, copy);
-    }
-    pthread_rwlock_unlock(&self->lock);
