-/* Apply tenant-specific discount (e.g., 5 % for VIP), taxes etc.
- * For demonstration we apply a flat 5 % discount and 10 % tax afterwards.
- */
-static mmx_money_t
-price_compute_total(const char *tenant_id, const mmx_order_item_t *items, size_t items_len)
-{
-    (void)tenant_id; /* would lookup rules per tenant */
-
-    uint64_t subtotal = 0;
-    for (size_t i = 0; i < items_len; ++i)
-    {
-        subtotal += (uint64_t)items[i].unit_price_cents * items[i].quantity;
-    }
-
-    uint64_t discount  = (subtotal * 5u)  / 100u; /* 5% */
-    uint64_t after_disc = subtotal - discount;
-    uint64_t tax       = (after_disc * 10u) / 100u; /* 10% */
-    uint64_t grand     = after_disc + tax;
-
-    mmx_money_t m = { .amount_cents = (uint32_t)grand };
-    strncpy(m.currency, "USD", MMX_CURRENCY_LEN);
-    m.currency[MMX_CURRENCY_LEN] = '\0';
-    return m;
-}
