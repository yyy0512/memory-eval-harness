-        b = calloc(1, sizeof(*b));
-        strncpy(b->tenant_id, tenant_id, sizeof(b->tenant_id) - 1);
-        b->tokens = BUCKET_CAPACITY;
-        b->last_refill_us = now;
-        HASH_ADD_STR(g_buckets, tenant_id, b);
-    }
-
-    /* Refill */
-    double elapsed_sec = (double)(now - b->last_refill_us) / 1000000.0;
-    uint64_t add = (uint64_t)(elapsed_sec * TOKENS_PER_SEC);
-    if (add > 0)
-    {
-        b->tokens = (b->tokens + add > BUCKET_CAPACITY) ? BUCKET_CAPACITY : b->tokens + add;
-        b->last_refill_us = now;
-    }
-
-    int ok = (b->tokens > 0) ? MMX_OK : MMX_ERR_LIMIT;
-    if (ok == MMX_OK)
-        --b->tokens;
-
-    pthread_mutex_unlock(&g_bucket_mtx);
-    return ok;
