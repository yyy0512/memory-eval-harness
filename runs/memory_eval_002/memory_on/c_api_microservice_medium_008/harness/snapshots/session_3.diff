+static void handle_create_order(struct mg_connection *c,
+                                struct mg_http_message *hm) {
+    if (hm->method.len != 4 || strncasecmp(hm->method.ptr, "POST", 4) != 0) {
+        send_text(c, 405, "Orders endpoint expects POST");
+        return;
+    }
+
+    routing_match_t match;
+    if (routing_match(HTTP_POST, "/v1/orders", "v1", &match) != 0) {
+        send_text(c, 502, "Order service route is unavailable");
+        return;
+    }
+
+    const char *order_service_url = getenv("ORDER_SERVICE_URL");
+    if (order_service_url == NULL || order_service_url[0] == '\0') {
+        order_service_url = "http://order-service.internal:7003/v1/orders";
+    }
+
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "upstream", "order_service");
+    cJSON_AddStringToObject(root, "url", order_service_url);
+    cJSON_AddStringToObject(root, "method", "POST");
+    cJSON_AddNumberToObject(root, "forwarded_body_bytes", (double)hm->body.len);
+    cJSON_AddStringToObject(root, "status", "forwarded");
+    send_json(c, 202, root);
+    cJSON_Delete(root);
+}
