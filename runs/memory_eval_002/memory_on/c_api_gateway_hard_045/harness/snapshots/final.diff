+static bool parse_request_object_into_batch(json_t *item,
+                                            GraphQLBatchRequest *batch,
+                                            size_t index)
+{
+    if (!json_is_object(item)) return false;
+
+    json_t *query_json = json_object_get(item, "query");
+    if (!json_is_string(query_json)) return false;
+
+    const char *query = json_string_value(query_json);
+    batch->requests[index].query = strdup(query);
+    if (!batch->requests[index].query) return false;
+
+    json_t *op_name_json = json_object_get(item, "operationName");
+    if (json_is_string(op_name_json)) {
+        batch->requests[index].operation_name = strdup(json_string_value(op_name_json));
+        if (!batch->requests[index].operation_name) return false;
+    }
+
+    json_t *variables_json = json_object_get(item, "variables");
+    if (variables_json && !json_is_null(variables_json)) {
+        batch->requests[index].variables_json = json_dumps(variables_json, JSON_COMPACT);
+        if (!batch->requests[index].variables_json) return false;
+    }
+
+    batch->requests[index].document = parse_graphql_query_text(query,
+                                                               &batch->requests[index].error);
+    batch->requests[index].has_error = batch->requests[index].error != NULL;
+    return true;
+}
+
+static GraphQLDocument *parse_json_graphql_payload(const char *payload, GqlError **out_err)
+{
+    json_error_t json_err;
+    json_t *root = json_loads(payload, 0, &json_err);
+    if (!root) return NULL;
+
+    GraphQLDocument *doc = NULL;
+
+    if (json_is_array(root)) {
+        Parser p;
+        memset(&p, 0, sizeof(Parser));
+        doc = (GraphQLDocument *) arena_alloc(&p.arena, sizeof(GraphQLDocument));
+        if (!doc) goto done;
+        memset(doc, 0, sizeof(GraphQLDocument));
+        doc->request_kind = GQL_REQUEST_BATCH;
+        doc->batch.count = json_array_size(root);
+        doc->batch.requests = calloc(doc->batch.count, sizeof(GraphQLRequest));
+        if (!doc->batch.requests) {
+            doc = NULL;
+            goto done;
+        }
+
+        for (size_t i = 0; i < doc->batch.count; ++i) {
+            if (!parse_request_object_into_batch(json_array_get(root, i), &doc->batch, i)) {
+                doc->batch.requests[i].has_error = true;
+            }
+        }
+    } else if (json_is_object(root)) {
+        json_t *query_json = json_object_get(root, "query");
+        if (json_is_string(query_json)) {
+            doc = parse_graphql_query_text(json_string_value(query_json), out_err);
+            if (doc) doc->request_kind = GQL_REQUEST_SINGLE;
+        }
+    }
+
+done:
+    json_decref(root);
+    return doc;
+}
+
+/* ============================  Public API  ============================== */
+
+GraphQLDocument *graphql_parse(const char *query, GqlError **out_err)
+{
+    const char *first = skip_json_ws(query);
+    if (*first == '[' || *first == '{') {
+        GraphQLDocument *json_doc = parse_json_graphql_payload(query, out_err);
+        if (json_doc || *first == '[') return json_doc;
+    }
+
+    return parse_graphql_query_text(query, out_err);
+}
