+static sp_gql_status_t _sp_gql_parse_request_object(json_t *obj,
+                                                    uint32_t max_depth,
+                                                    sp_gql_request_t *out_req)
+{
+    if (!json_is_object(obj)) return SP_GQL_ERR_TYPE_MISMATCH;
+
+    json_t *query_json = json_object_get(obj, "query");
+    if (!json_is_string(query_json)) return SP_GQL_ERR_TYPE_MISMATCH;
+
+    const char *query_text = json_string_value(query_json);
+    if (!query_text) return SP_GQL_ERR_TYPE_MISMATCH;
+
+    memset(out_req, 0, sizeof(*out_req));
+    out_req->query = _sp_gql_strdup_len(query_text, strlen(query_text));
+    if (!out_req->query) return SP_GQL_ERR_OOM;
+
+    json_t *op_name_json = json_object_get(obj, "operationName");
+    if (json_is_string(op_name_json)) {
+        const char *op_name = json_string_value(op_name_json);
+        out_req->operation_name = _sp_gql_strdup_len(op_name, strlen(op_name));
+        if (!out_req->operation_name) {
+            sp_gql_request_free(out_req);
+            return SP_GQL_ERR_OOM;
+        }
+    }
+
+    json_t *variables_json = json_object_get(obj, "variables");
+    if (variables_json && !json_is_null(variables_json)) {
+        out_req->variables_json = json_dumps(variables_json, JSON_COMPACT);
+        if (!out_req->variables_json) {
+            sp_gql_request_free(out_req);
+            return SP_GQL_ERR_OOM;
+        }
+    }
+
+    sp_gql_status_t status = _sp_gql_parse_document_text(out_req->query,
+                                                         strlen(out_req->query),
+                                                         max_depth,
+                                                         &out_req->document,
+                                                         &out_req->error);
+    if (status != SP_GQL_OK) {
+        out_req->has_error = true;
+    }
+    return SP_GQL_OK;
+}
+
+static sp_gql_status_t _sp_gql_parse_json_payload(const char *json,
+                                                  size_t json_len,
+                                                  uint32_t max_depth,
+                                                  sp_gql_doc_t **out_doc,
+                                                  sp_gql_error_t *out_err)
+{
+    json_error_t json_err;
+    json_t *root = json_loadb(json, json_len, 0, &json_err);
+    if (!root) {
+        if (out_err) {
+            out_err->code = SP_GQL_ERR_SYNTAX;
+            out_err->where.line = (uint32_t)json_err.line;
+            out_err->where.column = (uint32_t)json_err.column;
+            snprintf(out_err->message, sizeof out_err->message, "%s", json_err.text);
+        }
+        return SP_GQL_ERR_SYNTAX;
+    }
+
+    sp_gql_doc_t *doc = (sp_gql_doc_t*)calloc(1U, sizeof(*doc));
+    if (!doc) {
+        json_decref(root);
+        return SP_GQL_ERR_OOM;
+    }
+
+    sp_gql_status_t status = SP_GQL_OK;
+    if (json_is_array(root)) {
+        doc->request_kind = SP_GQL_REQUEST_BATCH;
+        doc->batch.len = json_array_size(root);
+        doc->batch.cap = doc->batch.len;
+        if (doc->batch.len > 0U) {
+            doc->batch.items = (sp_gql_request_t*)calloc(doc->batch.len, sizeof(*doc->batch.items));
+            if (!doc->batch.items) {
+                status = SP_GQL_ERR_OOM;
+                goto done;
+            }
+        }
+        for (size_t i = 0U; i < doc->batch.len; ++i) {
+            sp_gql_request_t *req = &doc->batch.items[i];
+            status = _sp_gql_parse_request_object(json_array_get(root, i), max_depth, req);
+            if (status != SP_GQL_OK) {
+                req->has_error = true;
+                req->error.code = status;
+                snprintf(req->error.message, sizeof req->error.message,
+                         "invalid GraphQL request at batch index %zu", i);
+                status = SP_GQL_OK;
+            }
+        }
+    } else if (json_is_object(root)) {
+        sp_gql_request_t req;
+        status = _sp_gql_parse_request_object(root, max_depth, &req);
+        if (status != SP_GQL_OK) goto done;
+        *doc = *req.document;
+        doc->request_kind = SP_GQL_REQUEST_SINGLE;
+        free(req.document);
+        free(req.query);
+        free(req.operation_name);
+        free(req.variables_json);
+    } else {
+        status = SP_GQL_ERR_TYPE_MISMATCH;
+        if (out_err) {
+            out_err->code = status;
+            snprintf(out_err->message, sizeof out_err->message,
+                     "GraphQL JSON payload must be an object or an array of objects");
+        }
+    }
+
+done:
+    json_decref(root);
+    if (status != SP_GQL_OK) {
+        sp_gql_doc_free(doc);
+        return status;
+    }
+    *out_doc = doc;
+    return SP_GQL_OK;
+}
+
+sp_gql_status_t
+sp_gql_parse(const char   *query,
+             size_t        query_len,
+             uint32_t      max_depth,
+             sp_gql_doc_t **out_doc,
+             sp_gql_error_t *out_err)
+{
+    if (!query || !out_doc) return SP_GQL_ERR_INTERNAL;
+    *out_doc = NULL;
+
+    const char *first = _sp_gql_skip_json_ws(query, query_len);
+    if (first < query + query_len && (*first == '[' || *first == '{')) {
+        sp_gql_status_t json_status = _sp_gql_parse_json_payload(query, query_len, max_depth, out_doc, out_err);
+        if (json_status == SP_GQL_OK || *first == '[') {
+            return json_status;
+        }
+        /* Preserve existing behavior for raw GraphQL shorthand documents that start with '{'. */
+    }
+
+    return _sp_gql_parse_document_text(query, query_len, max_depth, out_doc, out_err);
+}
