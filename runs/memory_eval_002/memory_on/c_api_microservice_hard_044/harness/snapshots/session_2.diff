+typedef struct {
+    cf_task_dependency_t dependency;
+    int                  found;
+} cf_task_dependency_row_ctx_t;
+
+static int cf_repo_read_task_dependency_row(int row, PGresult *res, void *user_data)
+{
+    cf_task_dependency_row_ctx_t *ctx = user_data;
+    if (cf_repo_uuid_from_string(PQgetvalue(res, row, 0), &ctx->dependency.id) != 0 ||
+        cf_repo_uuid_from_string(PQgetvalue(res, row, 1), &ctx->dependency.blocking_task_id) != 0 ||
+        cf_repo_uuid_from_string(PQgetvalue(res, row, 2), &ctx->dependency.dependent_task_id) != 0) {
+        return -1;
+    }
+    ctx->dependency.created_utc = (cf_timestamp_t)strtoll(PQgetvalue(res, row, 3), NULL, 10);
+    ctx->found = 1;
+    return 0;
+}
+
+static int cf_repo_hex_value(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int cf_repo_uuid_from_string(const char *text, cf_uuid_t *out_uuid)
+{
+    if (!text || !out_uuid) return -1;
+
+    size_t j = 0;
+    for (size_t i = 0; text[i] != '\0';) {
+        if (text[i] == '-') {
+            ++i;
+            continue;
+        }
+        if (j >= sizeof out_uuid->bytes) return -1;
+
+        int hi = cf_repo_hex_value(text[i++]);
+        int lo = cf_repo_hex_value(text[i++]);
+        if (hi < 0 || lo < 0) return -1;
+        out_uuid->bytes[j++] = (uint8_t)((hi << 4) | lo);
+    }
+
+    return j == sizeof out_uuid->bytes ? 0 : -1;
+}
+
+static void cf_repo_uuid_to_string(const cf_uuid_t *uuid, char out[CF_UUID_STR_LEN])
+{
+    static const char hex[] = "0123456789abcdef";
+    size_t j = 0;
+    for (size_t i = 0; i < sizeof uuid->bytes; ++i) {
+        if (i == 4 || i == 6 || i == 8 || i == 10) out[j++] = '-';
+        out[j++] = hex[(uuid->bytes[i] >> 4) & 0x0f];
+        out[j++] = hex[uuid->bytes[i] & 0x0f];
+    }
+    out[j] = '\0';
+}
