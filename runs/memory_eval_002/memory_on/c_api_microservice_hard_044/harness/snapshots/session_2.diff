+cf_error_t cf_repository_create_task_dependency(
+    cf_repository_t *repo,
+    const cf_task_dependency_t *in_dependency,
+    cf_task_dependency_t *out_created)
+{
+    (void)repo;
+    if (!in_dependency || !out_created) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(&in_dependency->blocking_task_id) ||
+        cf_uuid_is_nil(&in_dependency->dependent_task_id)) {
+        return CF_ERR_INVALID_UUID;
+    }
+    if (cf_uuid_equal(&in_dependency->blocking_task_id,
+                      &in_dependency->dependent_task_id)) {
+        return CF_ERR_INVALID_ARGUMENT;
+    }
+
+    char blocking_task_id[CF_UUID_STR_LEN];
+    char dependent_task_id[CF_UUID_STR_LEN];
+    cf_repo_uuid_to_string(&in_dependency->blocking_task_id, blocking_task_id);
+    cf_repo_uuid_to_string(&in_dependency->dependent_task_id, dependent_task_id);
+
+    const char *sql =
+        "INSERT INTO task_dependencies (blocking_task_id, dependent_task_id) "
+        "VALUES ($1::uuid, $2::uuid) "
+        "RETURNING dependency_id::text, blocking_task_id::text, "
+        "          dependent_task_id::text, EXTRACT(EPOCH FROM created_at)::bigint";
+
+    const char *params[2] = { blocking_task_id, dependent_task_id };
+
+    cf_task_dependency_row_ctx_t ctx = {0};
+
+    int rc = cf_repo_execute(sql, 2, params,
+                             cf_repo_read_task_dependency_row,
+                             &ctx);
+
+    if (rc != CF_ERR_OK) return rc;
+    if (!ctx.found) return CF_ERR_INTERNAL;
+
+    *out_created = ctx.dependency;
+    return CF_OK;
+}
+
+cf_error_t cf_repository_get_blocking_tasks_for_task(
+    cf_repository_t *repo,
+    const cf_uuid_t *task_id,
+    cf_cursor_t **out_cursor)
+{
+    (void)repo;
+    if (!task_id || !out_cursor) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(task_id)) return CF_ERR_INVALID_UUID;
+
+    char dependent_task_id[CF_UUID_STR_LEN];
+    cf_repo_uuid_to_string(task_id, dependent_task_id);
+
+    const char *sql =
+        "SELECT blocking_task_id "
+        "  FROM task_dependencies "
+        " WHERE dependent_task_id = $1::uuid "
+        " ORDER BY created_at ASC";
+    const char *params[1] = { dependent_task_id };
+
+    *out_cursor = NULL;
+    return (cf_error_t)cf_repo_execute(sql, 1, params, NULL, NULL);
+}
+
+cf_error_t cf_repository_delete_dependency(
+    cf_repository_t *repo,
+    const cf_uuid_t *dependency_id)
+{
+    (void)repo;
+    if (!dependency_id) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(dependency_id)) return CF_ERR_INVALID_UUID;
+
+    char dependency_id_str[CF_UUID_STR_LEN];
+    cf_repo_uuid_to_string(dependency_id, dependency_id_str);
+
+    const char *sql = "DELETE FROM task_dependencies WHERE dependency_id = $1::uuid";
+    const char *params[1] = { dependency_id_str };
+
+    return (cf_error_t)cf_repo_execute(sql, 1, params, NULL, NULL);
+}
