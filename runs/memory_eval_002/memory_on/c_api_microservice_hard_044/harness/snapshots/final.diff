+    const cJSON *dependent_arg = cJSON_GetObjectItemCaseSensitive(args, "dependentTaskId");
+    const cJSON *blocking_arg = cJSON_GetObjectItemCaseSensitive(args, "blockingTaskId");
+    if (!cJSON_IsString(dependent_arg) || !cJSON_IsString(blocking_arg))
+    {
+        cJSON_Delete(args);
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
