+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "id", dependency_id);
+    cJSON_AddItemToObject(root, "dependentTask", dependent_obj);
+    cJSON_AddItemToObject(root, "blockingTask", blocking_obj);
+    cJSON_AddNumberToObject(root, "createdAt", (double)created.created_utc);
