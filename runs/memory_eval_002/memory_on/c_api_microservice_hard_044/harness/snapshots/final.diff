+                   (str[i] >= 'A' && str[i] <= 'F')))
+        {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static bool
+dependency_path_exists_locked(const char *from_task_id,
+                              const char *target_task_id,
+                              unsigned depth)
+{
+    if (depth > 64) return true;
+    if (strcmp(from_task_id, target_task_id) == 0) return true;
+
+    task_dependency_t *dep, *tmp;
+    HASH_ITER(hh, g_dependencies, dep, tmp)
+    {
+        if (strcmp(dep->dependent_task_id, from_task_id) == 0)
+        {
+            if (strcmp(dep->blocking_task_id, target_task_id) == 0) return true;
+            if (dependency_path_exists_locked(dep->blocking_task_id, target_task_id, depth + 1))
+                return true;
+        }
+    }
+
+    return false;
+}
