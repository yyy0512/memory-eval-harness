+    char dependency_id[CF_UUID_STR_LEN];
+    uuid_to_graphql_id(&created.id, dependency_id);
+
+    char *dependent_json = format_task_json(&dependent_task);
+    char *blocking_json = format_task_json(&blocking_task);
+    cJSON *dependent_obj = dependent_json ? cJSON_Parse(dependent_json) : NULL;
+    cJSON *blocking_obj = blocking_json ? cJSON_Parse(blocking_json) : NULL;
+    free(dependent_json);
+    free(blocking_json);
+    if (!dependent_obj || !blocking_obj)
+    {
+        if (dependent_obj) cJSON_Delete(dependent_obj);
+        if (blocking_obj) cJSON_Delete(blocking_obj);
