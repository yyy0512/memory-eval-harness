 /*-----------------------------------------------------------------------------
- *  Top-level dispatcher for all /v1/* resources
+ *  /v1/tasks/{taskId}/dependencies  (POST)
  *---------------------------------------------------------------------------*/
+static void
+handle_post_task_dependency(const http_request_t *req, http_response_t *res)
+{
+    if (strcmp(req->content_type, "application/json") != 0)
+    {
+        json_error(res, 415, "Unsupported Media Type", "Expecting application/json payload");
+        return;
+    }
+
+    const char *prefix = "/v1/tasks/";
+    const char *suffix = "/dependencies";
+    const char *task_id_start = req->uri + strlen(prefix);
+    const char *suffix_start = strstr(task_id_start, suffix);
+    if (strncmp(req->uri, prefix, strlen(prefix)) != 0 || !suffix_start || suffix_start == task_id_start)
+    {
+        json_error(res, 404, "Not Found", NULL);
+        return;
+    }
+
+    size_t dependent_len = (size_t)(suffix_start - task_id_start);
+    if (dependent_len != 36)
+    {
+        json_error(res, 422, "Unprocessable Entity", "taskId must be an RFC-4122 UUID");
+        return;
+    }
+
+    char dependent_task_id[37];
+    memcpy(dependent_task_id, task_id_start, dependent_len);
+    dependent_task_id[dependent_len] = '\0';
+    if (!is_uuid_text(dependent_task_id))
+    {
+        json_error(res, 422, "Unprocessable Entity", "taskId must be an RFC-4122 UUID");
+        return;
+    }
+
+    cJSON *root = cJSON_ParseWithLength(req->body, req->body_length);
+    if (!root || !cJSON_IsObject(root))
+    {
+        json_error(res, 400, "Bad Request", "Malformed JSON");
+        if (root) cJSON_Delete(root);
+        return;
+    }
+
+    const cJSON *blocking = cJSON_GetObjectItemCaseSensitive(root, "blocking_task_id");
+    if (!cJSON_IsString(blocking) || !is_uuid_text(blocking->valuestring))
+    {
+        json_error(res, 422, "Unprocessable Entity", "Field [blocking_task_id] must be an RFC-4122 UUID");
+        cJSON_Delete(root);
+        return;
+    }
+
+    if (strcmp(dependent_task_id, blocking->valuestring) == 0)
+    {
+        json_error(res, 409, "Conflict", "A task cannot depend on itself");
+        cJSON_Delete(root);
+        return;
+    }
+
+    pthread_rwlock_wrlock(&g_tasks_lock);
+
+    task_t *dependent_task = NULL;
+    task_t *blocking_task = NULL;
+    HASH_FIND_STR(g_tasks, dependent_task_id, dependent_task);
+    HASH_FIND_STR(g_tasks, blocking->valuestring, blocking_task);
+    if (!dependent_task || !blocking_task)
+    {
+        pthread_rwlock_unlock(&g_tasks_lock);
+        json_error(res, 404, "Not Found", "dependent task or blocking task not found");
+        cJSON_Delete(root);
+        return;
+    }
+
+    if (dependency_path_exists_locked(blocking->valuestring, dependent_task_id, 0))
+    {
+        pthread_rwlock_unlock(&g_tasks_lock);
+        json_error(res, 409, "Conflict", "Dependency would create a cycle");
+        cJSON_Delete(root);
+        return;
+    }
+
+    task_dependency_t *existing, *tmp;
+    HASH_ITER(hh, g_dependencies, existing, tmp)
+    {
+        if (strcmp(existing->dependent_task_id, dependent_task_id) == 0 &&
+            strcmp(existing->blocking_task_id, blocking->valuestring) == 0)
+        {
+            pthread_rwlock_unlock(&g_tasks_lock);
+            json_error(res, 409, "Conflict", "Dependency already exists");
+            cJSON_Delete(root);
+            return;
+        }
+    }
+
+    task_dependency_t *dependency = calloc(1, sizeof(*dependency));
+    if (!dependency)
+    {
+        pthread_rwlock_unlock(&g_tasks_lock);
+        json_error(res, 500, "Internal Server Error", "OOM while creating dependency");
+        cJSON_Delete(root);
+        return;
+    }
+
+    uuid_generate_text(dependency->id);
+    strncpy(dependency->dependent_task_id, dependent_task_id, sizeof(dependency->dependent_task_id) - 1);
+    strncpy(dependency->blocking_task_id, blocking->valuestring, sizeof(dependency->blocking_task_id) - 1);
+    dependency->created_ts = time(NULL);
+    HASH_ADD_STR(g_dependencies, id, dependency);
+
+    pthread_rwlock_unlock(&g_tasks_lock);
+
+    cJSON *resp = cJSON_CreateObject();
+    cJSON_AddStringToObject(resp, "id", dependency->id);
+    cJSON_AddStringToObject(resp, "dependent_task_id", dependency->dependent_task_id);
+    cJSON_AddStringToObject(resp, "blocking_task_id", dependency->blocking_task_id);
+    cJSON_AddNumberToObject(resp, "created_at", (double)dependency->created_ts);
+
+    char *body = cJSON_PrintUnformatted(resp);
+    cJSON_Delete(resp);
+
+    http_response_set_status(res, 201);
+    http_response_set_header(res, "Content-Type", "application/json; charset=utf-8");
+    http_response_set_body(res, body, strlen(body));
+
+    free(body);
+    cJSON_Delete(root);
+}
