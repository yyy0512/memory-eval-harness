+
+    char body[128];
+    snprintf(body, sizeof(body), "{ \"blocking_task_id\": \"%s\" }", blocking_id);
+
+    long status;
+    struct memory_block mb;
+    assert_int_equal(http_post_json(path, &mb, &status, body), 0);
+    assert_int_equal(status, 201);
+
+    json_object *jo = parse_json_or_fail(&mb);
+    json_object *dep_id = NULL;
+    json_object *dependent_field = NULL;
+    json_object *blocking_field = NULL;
+    assert_true(json_object_object_get_ex(jo, "id", &dep_id));
+    assert_true(json_object_object_get_ex(jo, "dependent_task_id", &dependent_field));
+    assert_true(json_object_object_get_ex(jo, "blocking_task_id", &blocking_field));
+    assert_string_equal(json_object_get_string(dependent_field), dependent_id);
+    assert_string_equal(json_object_get_string(blocking_field), blocking_id);
