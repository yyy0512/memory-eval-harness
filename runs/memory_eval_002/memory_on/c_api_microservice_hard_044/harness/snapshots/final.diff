+    cf_task_dependency_t dependency = {0};
+    if (uuid_from_graphql_id(dependent_arg->valuestring, &dependency.dependent_task_id) != 0 ||
+        uuid_from_graphql_id(blocking_arg->valuestring, &dependency.blocking_task_id) != 0)
+    {
+        cJSON_Delete(args);
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+    cJSON_Delete(args);
