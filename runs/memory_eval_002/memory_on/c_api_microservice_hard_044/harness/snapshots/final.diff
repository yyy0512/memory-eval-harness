+/* Creating the reverse edge should be rejected because it creates a cycle */
+static void test_task_dependency_cycle_rejected(void **state)
+{
+    (void)state;
+    char *task_a = create_task_or_fail("Cycle task A");
+    char *task_b = create_task_or_fail("Cycle task B");
+
+    char path[128];
+    char body[128];
+    long status;
+    struct memory_block mb;
+
+    snprintf(path, sizeof(path), "/api/v1/tasks/%s/dependencies", task_a);
+    snprintf(body, sizeof(body), "{ \"blocking_task_id\": \"%s\" }", task_b);
+    assert_int_equal(http_post_json(path, &mb, &status, body), 0);
+    assert_int_equal(status, 201);
+    free(mb.data);
+
+    snprintf(path, sizeof(path), "/api/v1/tasks/%s/dependencies", task_b);
+    snprintf(body, sizeof(body), "{ \"blocking_task_id\": \"%s\" }", task_a);
+    assert_int_equal(http_post_json(path, &mb, &status, body), 0);
+    assert_int_equal(status, 409);
+
+    json_object *jo = parse_json_or_fail(&mb);
+    json_object *error = NULL;
+    assert_true(json_object_object_get_ex(jo, "error", &error));
+    assert_string_equal(json_object_get_string(error), "Conflict");
+
+    json_object_put(jo);
+    free(mb.data);
+    free(task_a);
+    free(task_b);
+}
