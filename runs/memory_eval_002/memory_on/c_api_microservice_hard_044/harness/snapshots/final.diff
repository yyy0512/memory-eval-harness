+    if (!cJSON_IsString(task_id_arg))
+    {
+        cJSON_Delete(args);
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    cf_uuid_t task_id;
+    if (uuid_from_graphql_id(task_id_arg->valuestring, &task_id) != 0)
+    {
+        cJSON_Delete(args);
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    cf_cursor_t *cursor = NULL;
+    cf_error_t rc = cf_repository_get_blocking_tasks_for_task((cf_repository_t *)user_data,
