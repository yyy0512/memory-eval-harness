+static bool
+cf_uuid_bytes_equal(const cf_uuid_t *a, const cf_uuid_t *b)
+{
+    return a && b && memcmp(a->bytes, b->bytes, sizeof(a->bytes)) == 0;
+}
+
+static bool
+cf_uuid_bytes_nil(const cf_uuid_t *id)
+{
+    static const uint8_t zero[16] = {0};
+    return !id || memcmp(id->bytes, zero, sizeof(zero)) == 0;
+}
+
+static void
+cf_uuid_bytes_copy(cf_uuid_t *dst, const uint8_t src[16])
+{
+    memcpy(dst->bytes, src, sizeof(dst->bytes));
+}
+
+static cf_error_t
+cf_dependency_path_exists(cf_repository_t *repo,
+                          const cf_uuid_t *from_task_id,
+                          const cf_uuid_t *target_task_id,
+                          unsigned depth)
+{
+    if (depth > 64) return CF_ERR_CONFLICT;
+    if (cf_uuid_bytes_equal(from_task_id, target_task_id)) return CF_ERR_CONFLICT;
+
+    cf_cursor_t *cursor = NULL;
+    cf_error_t rc = cf_repository_get_blocking_tasks_for_task(repo, from_task_id, &cursor);
+    if (rc != CF_OK) return rc;
+
+    cf_task_t blocker;
+    while ((rc = cf_cursor_next_task(cursor, &blocker)) == CF_OK) {
+        if (cf_uuid_bytes_equal(&blocker.id, target_task_id)) {
+            cf_cursor_free(cursor);
+            return CF_ERR_CONFLICT;
+        }
+
+        rc = cf_dependency_path_exists(repo, &blocker.id, target_task_id, depth + 1);
+        if (rc == CF_ERR_CONFLICT) {
+            cf_cursor_free(cursor);
+            return rc;
+        }
+        if (rc != CF_ERR_NOT_FOUND && rc != CF_OK) {
+            cf_cursor_free(cursor);
+            return rc;
+        }
+    }
+
+    cf_cursor_free(cursor);
+    return rc == CF_ERR_NOT_FOUND ? CF_OK : rc;
+}
+
+cf_status_t
+cf_handle_create_task_dependency(cf_repository_t *repo,
+                                 const cf_create_task_dependency_command_t *cmd,
+                                 cf_task_dependency_t *out_created)
+{
+    if (!repo || !cmd || !out_created) return CF_ERR_INVALID_ARG;
+
+    cf_task_dependency_t dependency = {0};
+    cf_uuid_bytes_copy(&dependency.blocking_task_id, cmd->blocking_task_id);
+    cf_uuid_bytes_copy(&dependency.dependent_task_id, cmd->dependent_task_id);
+
+    if (cf_uuid_bytes_nil(&dependency.blocking_task_id) ||
+        cf_uuid_bytes_nil(&dependency.dependent_task_id) ||
+        cf_uuid_bytes_equal(&dependency.blocking_task_id, &dependency.dependent_task_id)) {
+        return CF_ERR_INVALID_ARG;
+    }
+
+    cf_error_t rc = cf_dependency_path_exists(repo,
+                                             &dependency.blocking_task_id,
+                                             &dependency.dependent_task_id,
+                                             0);
+    if (rc == CF_ERR_CONFLICT) return CF_BUS_ERR_CONFLICT;
+    if (rc != CF_OK) return CF_BUS_ERR_INTERNAL;
+
+    rc = cf_repository_create_task_dependency(repo, &dependency, out_created);
+    if (rc == CF_OK) return CF_BUS_OK;
+    if (rc == CF_ERR_CONFLICT) return CF_BUS_ERR_CONFLICT;
+    if (rc == CF_ERR_INVALID_ARGUMENT || rc == CF_ERR_INVALID_UUID || rc == CF_ERR_NULL_POINTER)
+        return CF_ERR_INVALID_ARG;
+    return CF_BUS_ERR_INTERNAL;
+}
+
+cf_status_t
+cf_handle_delete_task_dependency(cf_repository_t *repo,
+                                 const cf_delete_task_dependency_command_t *cmd)
+{
+    if (!repo || !cmd) return CF_ERR_INVALID_ARG;
+
+    cf_uuid_t dependency_id;
+    cf_uuid_bytes_copy(&dependency_id, cmd->dependency_id);
+    if (cf_uuid_bytes_nil(&dependency_id)) return CF_ERR_INVALID_ARG;
+
+    cf_error_t rc = cf_repository_delete_dependency(repo, &dependency_id);
+    if (rc == CF_OK) return CF_BUS_OK;
+    if (rc == CF_ERR_NOT_FOUND) return CF_BUS_ERR_NOT_FOUND;
+    if (rc == CF_ERR_INVALID_ARGUMENT || rc == CF_ERR_INVALID_UUID || rc == CF_ERR_NULL_POINTER)
+        return CF_ERR_INVALID_ARG;
+    return CF_BUS_ERR_INTERNAL;
+}
+
+cf_status_t
+cf_handle_update_task_status(cf_repository_t *repo,
+                             const cf_update_task_status_command_t *cmd)
+{
+    if (!repo || !cmd || cmd->state > CF_TASK_ARCHIVED) return CF_ERR_INVALID_ARG;
+
+    cf_uuid_t task_id;
+    cf_uuid_bytes_copy(&task_id, cmd->task_id);
+    if (cf_uuid_bytes_nil(&task_id)) return CF_ERR_INVALID_ARG;
+
+    cf_task_t task;
+    cf_error_t rc = cf_repository_get_task(repo, &task_id, &task);
+    if (rc == CF_ERR_NOT_FOUND) return CF_BUS_ERR_NOT_FOUND;
+    if (rc != CF_OK) return CF_BUS_ERR_INTERNAL;
+
+    if ((cf_task_state_t)cmd->state == CF_TASK_DONE) {
+        cf_cursor_t *cursor = NULL;
+        rc = cf_repository_get_blocking_tasks_for_task(repo, &task_id, &cursor);
+        if (rc != CF_OK) return CF_BUS_ERR_INTERNAL;
+
+        cf_task_t blocker;
+        while ((rc = cf_cursor_next_task(cursor, &blocker)) == CF_OK) {
+            if (blocker.state != CF_TASK_DONE) {
+                cf_cursor_free(cursor);
+                return CF_BUS_ERR_CONFLICT;
+            }
+        }
+        cf_cursor_free(cursor);
+        if (rc != CF_ERR_NOT_FOUND) return CF_BUS_ERR_INTERNAL;
+    }
+
+    task.state = (cf_task_state_t)cmd->state;
+    rc = cf_repository_update_task(repo, &task);
+    if (rc == CF_OK) return CF_BUS_OK;
+    if (rc == CF_ERR_NOT_FOUND) return CF_BUS_ERR_NOT_FOUND;
+    return CF_BUS_ERR_INTERNAL;
+}
