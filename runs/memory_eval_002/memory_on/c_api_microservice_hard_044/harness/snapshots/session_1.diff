+static inline cf_err_t
+cf_validate_task_dependency(const cf_task_dependency_t *dependency)
+{
+    if (!dependency) return CF_E_NULL_PTR;
+    if (cf_id_is_null(dependency->blocking_task_id)) return CF_E_INVALID_STATE;
+    if (cf_id_is_null(dependency->dependent_task_id)) return CF_E_INVALID_STATE;
