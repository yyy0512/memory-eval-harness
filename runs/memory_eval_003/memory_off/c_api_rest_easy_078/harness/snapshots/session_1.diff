diff --git a/UtiliREST_EchoHub/Makefile b/UtiliREST_EchoHub/Makefile
index ee95d30..94454d7 100644
--- a/UtiliREST_EchoHub/Makefile
+++ b/UtiliREST_EchoHub/Makefile
@@ -27,6 +27,7 @@ DIST_DIR      = $(BUILD_DIR)/dist
 
 TARGET        = $(BIN_DIR)/$(PROJECT)
 UNIT_TEST_BIN = $(BIN_DIR)/$(PROJECT)_tests
+RATE_LIMITER_TEST_BIN = $(BIN_DIR)/test_rate_limiter
 
 #––– Toolchain & flags –––––––––––––––––––––––––––––––––––––––––––––––––––––––––
 # Override on CLI: `make CC=clang`
@@ -43,7 +44,7 @@ OPT_DEBUG      = -O0 -g3
 STD            = -std=c11
 DEFINES        = -DPROJECT_VERSION=\"$(VERSION)\"
 
-CFLAGS_COMMON  = $(STD) $(WARNINGS) $(DEFINES) -fPIC
+CFLAGS_COMMON  = $(STD) $(WARNINGS) $(DEFINES) -Iinclude -I. -fPIC
 LDFLAGS_COMMON =
 
 # Libraries discovered via pkg-config
@@ -90,6 +91,7 @@ JOBS ?= $(shell nproc 2>/dev/null || echo 4)
 SRC  := $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c))
 OBJ  := $(patsubst %.c,$(OBJ_DIR)/%.o,$(SRC))
 
+RATE_LIMITER_TEST_OBJ := $(OBJ_DIR)/src/rate_limiter.o $(OBJ_DIR)/tests/test_rate_limiter.o
 TEST_SRC := $(wildcard $(TEST_DIR)/*.c)
 TEST_OBJ := $(patsubst %.c,$(OBJ_DIR)/%.o,$(TEST_SRC))
 
@@ -117,11 +119,24 @@ $(TARGET): $(OBJ)
 # Tests
 #------------------------------------------------------------------------------
 .PHONY: test
-test: CFLAGS += -DUNIT_TESTING
-test: $(UNIT_TEST_BIN)
+
+test: rate-limiter-test
+
+test-all: CFLAGS += -DUNIT_TESTING
+test-all: $(UNIT_TEST_BIN)
 	@echo "Running unit tests…"
 	@./$(UNIT_TEST_BIN)
 
+.PHONY: rate-limiter-test
+rate-limiter-test: CFLAGS += -DUNIT_TESTING
+rate-limiter-test: $(RATE_LIMITER_TEST_BIN)
+	@echo "Running rate limiter tests…"
+	@./$(RATE_LIMITER_TEST_BIN)
+
+$(RATE_LIMITER_TEST_BIN): $(RATE_LIMITER_TEST_OBJ)
+	@$(MKDIR_P) $(BIN_DIR)
+	$(CC) $^ $(LDFLAGS) -o $@
+
 $(UNIT_TEST_BIN): $(OBJ) $(TEST_OBJ)
 	@$(MKDIR_P) $(BIN_DIR)
 	$(CC) $^ $(LDFLAGS) -o $@
