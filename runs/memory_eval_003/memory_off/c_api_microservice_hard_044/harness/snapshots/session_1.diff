+/*--------------------------------------------------------------------
+ * CRUD – Task dependencies
+ *------------------------------------------------------------------*/
+int create_task_dependency(const cf_task_dependency_t *dependency)
+{
+    if (!dependency ||
+        dependency->blocking_task_id == 0 ||
+        dependency->dependent_task_id == 0 ||
+        dependency->blocking_task_id == dependency->dependent_task_id) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    const char *sql =
+        "INSERT INTO task_dependencies (blocking_task_id, dependent_task_id, created_at) "
+        "VALUES ($1, $2, EXTRACT(EPOCH FROM NOW())::bigint)";
+
+    char blocking_id[32];
+    char dependent_id[32];
+    snprintf(blocking_id, sizeof blocking_id, "%llu",
+             (unsigned long long)dependency->blocking_task_id);
+    snprintf(dependent_id, sizeof dependent_id, "%llu",
+             (unsigned long long)dependency->dependent_task_id);
+
+    const char *params[2] = { blocking_id, dependent_id };
+    return cf_repo_execute(sql, 2, params, NULL, NULL);
+}
+
+int get_blocking_tasks_for_task(uint64_t dependent_task_id,
+                                cf_task_dependency_list_t *out_dependencies)
+{
+    if (dependent_task_id == 0 || !out_dependencies) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    out_dependencies->items = NULL;
+    out_dependencies->count = 0;
+
+    const char *sql =
+        "SELECT dependency_id, blocking_task_id, dependent_task_id "
+        "FROM task_dependencies "
+        "WHERE dependent_task_id = $1 "
+        "ORDER BY dependency_id";
+
+    char dependent_id[32];
+    snprintf(dependent_id, sizeof dependent_id, "%llu",
+             (unsigned long long)dependent_task_id);
+
+    const char *params[1] = { dependent_id };
+
+    struct {
+        cf_task_dependency_t *items;
+        size_t count;
+        size_t capacity;
+        int failed;
+    } ctx = { .items = NULL, .count = 0, .capacity = 0, .failed = 0 };
+
+    int rc = cf_repo_execute(sql, 1, params,
+        [](int row, PGresult *res, void *ud) -> int {
+            (void)row;
+            struct { cf_task_dependency_t *items; size_t count; size_t capacity; int failed; } *ctx = ud;
+            if (ctx->count == ctx->capacity) {
+                size_t new_capacity = ctx->capacity == 0 ? 4 : ctx->capacity * 2;
+                cf_task_dependency_t *new_items = realloc(ctx->items,
+                    new_capacity * sizeof *new_items);
+                if (!new_items) {
+                    ctx->failed = 1;
+                    return -1;
+                }
+                ctx->items = new_items;
+                ctx->capacity = new_capacity;
+            }
+
+            cf_task_dependency_t *dependency = &ctx->items[ctx->count++];
+            dependency->id = strtoull(PQgetvalue(res, row, 0), NULL, 10);
+            dependency->blocking_task_id = strtoull(PQgetvalue(res, row, 1), NULL, 10);
+            dependency->dependent_task_id = strtoull(PQgetvalue(res, row, 2), NULL, 10);
+            return 0;
+        },
+        &ctx);
+
+    if (rc != CF_ERR_OK) {
+        free(ctx.items);
+        return rc;
+    }
+
+    if (ctx.failed) {
+        free(ctx.items);
+        return CF_ERR_INTERNAL;
+    }
+
+    out_dependencies->items = ctx.items;
+    out_dependencies->count = ctx.count;
+    return CF_ERR_OK;
+}
+
+int delete_dependency(uint64_t dependency_id)
+{
+    if (dependency_id == 0) {
+        return CF_ERR_BAD_ARGUMENT;
+    }
+
+    const char *sql =
+        "DELETE FROM task_dependencies "
+        "WHERE dependency_id = $1 "
+        "RETURNING dependency_id";
+
+    char id[32];
+    snprintf(id, sizeof id, "%llu", (unsigned long long)dependency_id);
+
+    const char *params[1] = { id };
+
+    struct { int deleted; } ctx = { .deleted = 0 };
+    int rc = cf_repo_execute(sql, 1, params,
+        [](int row, PGresult *res, void *ud) -> int {
+            (void)row;
+            (void)res;
+            struct { int deleted; } *ctx = ud;
+            ctx->deleted = 1;
+            return 0;
+        },
+        &ctx);
+
+    if (rc != CF_ERR_OK) {
+        return rc;
+    }
+
+    return ctx.deleted ? CF_ERR_OK : CF_ERR_NOT_FOUND;
+}
+
+void cf_task_dependency_list_free(cf_task_dependency_list_t *dependencies)
+{
+    if (!dependencies) {
+        return;
+    }
+
+    free(dependencies->items);
+    dependencies->items = NULL;
+    dependencies->count = 0;
+}
