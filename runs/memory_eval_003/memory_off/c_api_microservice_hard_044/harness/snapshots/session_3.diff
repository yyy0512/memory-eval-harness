+static bool
+gql_json_read_u64(const cJSON *root, const char *name, uint64_t *out)
+{
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, name);
+    if (!value || !out)
+    {
+        return false;
+    }
+
+    if (cJSON_IsNumber(value) && value->valuedouble > 0)
+    {
+        *out = (uint64_t)value->valuedouble;
+        return true;
+    }
+
+    if (cJSON_IsString(value) && value->valuestring && value->valuestring[0] != '\0')
+    {
+        char *end = NULL;
+        unsigned long long parsed = strtoull(value->valuestring, &end, 10);
+        if (parsed > 0 && end && *end == '\0')
+        {
+            *out = (uint64_t)parsed;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static bool
+gql_dependency_path_exists(uint64_t from_task_id, uint64_t target_task_id)
+{
+    if (from_task_id == target_task_id)
+    {
+        return true;
+    }
+
+    cf_task_dependency_list_t dependencies = {0};
+    if (get_blocking_tasks_for_task(from_task_id, &dependencies) != CF_OK)
+    {
+        return false;
+    }
+
+    for (size_t i = 0; i < dependencies.count; ++i)
+    {
+        uint64_t next = dependencies.items[i].blocking_task_id;
+        if (next == target_task_id || gql_dependency_path_exists(next, target_task_id))
+        {
+            cf_task_dependency_list_free(&dependencies);
+            return true;
+        }
+    }
+
+    cf_task_dependency_list_free(&dependencies);
+    return false;
+}
+
+chrono_gql_error_t
+cf_graphql_resolve_task_blocking_tasks(void *user_data,
+                            const char *field_name,
+                            const char *arguments_json,
+                            char **out_json)
+{
+    (void)user_data;
+    (void)field_name;
+
+    if (!arguments_json || !out_json)
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    cJSON *args = cJSON_Parse(arguments_json);
+    if (!args)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    uint64_t dependent_task_id = 0;
+    bool has_id = gql_json_read_u64(args, "taskId", &dependent_task_id) ||
+                  gql_json_read_u64(args, "id", &dependent_task_id);
+    cJSON_Delete(args);
+
+    if (!has_id)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    cf_task_dependency_list_t dependencies = {0};
+    if (get_blocking_tasks_for_task(dependent_task_id, &dependencies) != CF_OK)
+    {
+        return CHRONO_GQL_ERR_RESOLVER;
+    }
+
+    cJSON *array = cJSON_CreateArray();
+    for (size_t i = 0; i < dependencies.count; ++i)
+    {
+        char id_buf[32];
+        snprintf(id_buf, sizeof id_buf, "%llu",
+                 (unsigned long long)dependencies.items[i].blocking_task_id);
+
+        cJSON *task = cJSON_CreateObject();
+        cJSON_AddStringToObject(task, "id", id_buf);
+        cJSON_AddItemToArray(array, task);
+    }
+
+    *out_json = cJSON_PrintUnformatted(array);
+    cJSON_Delete(array);
+    cf_task_dependency_list_free(&dependencies);
+
+    return *out_json ? CHRONO_GQL_OK : CHRONO_GQL_ERR_OOM;
+}
+
+chrono_gql_error_t
+cf_graphql_resolve_create_task_dependency(void *user_data,
+                               const char *field_name,
+                               const char *arguments_json,
+                               char **out_json)
+{
+    (void)user_data;
+    (void)field_name;
+
+    if (!arguments_json || !out_json)
+    {
+        return CHRONO_GQL_ERR_INVALID_ARG;
+    }
+
+    cJSON *args = cJSON_Parse(arguments_json);
+    if (!args)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    uint64_t dependent_task_id = 0;
+    uint64_t blocking_task_id = 0;
+    bool ok = gql_json_read_u64(args, "dependentTaskId", &dependent_task_id) &&
+              gql_json_read_u64(args, "blockingTaskId", &blocking_task_id);
+    cJSON_Delete(args);
+
+    if (!ok || dependent_task_id == blocking_task_id)
+    {
+        return CHRONO_GQL_ERR_VARIABLES;
+    }
+
+    if (gql_dependency_path_exists(blocking_task_id, dependent_task_id))
+    {
+        return CHRONO_GQL_ERR_RESOLVER;
+    }
+
+    cf_task_dependency_t dependency = {
+        .blocking_task_id = blocking_task_id,
+        .dependent_task_id = dependent_task_id
+    };
+
+    if (create_task_dependency(&dependency) != CF_OK)
+    {
+        return CHRONO_GQL_ERR_RESOLVER;
+    }
+
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "id", "0");
+    cJSON_AddNumberToObject(root, "blockingTaskId", (double)blocking_task_id);
+    cJSON_AddNumberToObject(root, "dependentTaskId", (double)dependent_task_id);
+
+    *out_json = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    return *out_json ? CHRONO_GQL_OK : CHRONO_GQL_ERR_OOM;
+}
