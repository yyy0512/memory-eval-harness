+static bool
+rest_dependency_path_exists(uint64_t from_task_id, uint64_t target_task_id)
+{
+    if (from_task_id == target_task_id)
+    {
+        return true;
+    }
+
+    cf_task_dependency_list_t dependencies = {0};
+    if (get_blocking_tasks_for_task(from_task_id, &dependencies) != CF_OK)
+    {
+        return false;
+    }
+
+    for (size_t i = 0; i < dependencies.count; ++i)
+    {
+        uint64_t next = dependencies.items[i].blocking_task_id;
+        if (next == target_task_id || rest_dependency_path_exists(next, target_task_id))
+        {
+            cf_task_dependency_list_free(&dependencies);
+            return true;
+        }
+    }
+
+    cf_task_dependency_list_free(&dependencies);
+    return false;
+}
+
+static int
+parse_task_dependency_uri(const char *uri, uint64_t *out_task_id)
+{
+    const char *prefix = "/v1/tasks/";
+    const char *suffix = "/dependencies";
+    size_t prefix_len = strlen(prefix);
+
+    if (!uri || !out_task_id || strncmp(uri, prefix, prefix_len) != 0)
+    {
+        return -1;
+    }
+
+    const char *id_start = uri + prefix_len;
+    char *id_end = NULL;
+    errno = 0;
+    unsigned long long parsed = strtoull(id_start, &id_end, 10);
+    if (errno != 0 || parsed == 0 || id_end == id_start || strcmp(id_end, suffix) != 0)
+    {
+        return -1;
+    }
+
+    *out_task_id = (uint64_t)parsed;
+    return 0;
+}
+
+/*-----------------------------------------------------------------------------
+ *  /v1/tasks/{taskId}/dependencies  (POST)
+ *---------------------------------------------------------------------------*/
+static void
+handle_post_task_dependency(const http_request_t *req, http_response_t *res)
+{
+    if (strcmp(req->content_type, "application/json") != 0)
+    {
+        json_error(res, 415, "Unsupported Media Type", "Expecting application/json payload");
+        return;
+    }
+
+    uint64_t dependent_task_id = 0;
+    if (parse_task_dependency_uri(req->uri, &dependent_task_id) != 0)
+    {
+        json_error(res, 404, "Not Found", NULL);
+        return;
+    }
+
+    cJSON *root = cJSON_ParseWithLength(req->body, req->body_length);
+    if (!root || !cJSON_IsObject(root))
+    {
+        json_error(res, 400, "Bad Request", "Malformed JSON");
+        if (root) cJSON_Delete(root);
+        return;
+    }
+
+    const cJSON *blocking_task_id_json = cJSON_GetObjectItemCaseSensitive(root, "blocking_task_id");
+    if (!cJSON_IsNumber(blocking_task_id_json) || blocking_task_id_json->valuedouble <= 0)
+    {
+        json_error(res, 422, "Unprocessable Entity", "Field [blocking_task_id] is mandatory");
+        cJSON_Delete(root);
+        return;
+    }
+
+    uint64_t blocking_task_id = (uint64_t)blocking_task_id_json->valuedouble;
+    if (blocking_task_id == dependent_task_id)
+    {
+        json_error(res, 409, "Conflict", "Task cannot depend on itself");
+        cJSON_Delete(root);
+        return;
+    }
+
+    if (rest_dependency_path_exists(blocking_task_id, dependent_task_id))
+    {
+        json_error(res, 409, "Conflict", "Task dependency would create a cycle");
+        cJSON_Delete(root);
+        return;
+    }
+
+    cf_task_dependency_t dependency = {
+        .blocking_task_id = blocking_task_id,
+        .dependent_task_id = dependent_task_id
+    };
+
+    int rc = create_task_dependency(&dependency);
+    if (rc != CF_OK)
+    {
+        json_error(res, rc == CF_ERR_CONFLICT ? 409 : 500,
+                   rc == CF_ERR_CONFLICT ? "Conflict" : "Internal Server Error",
+                   "Failed to create task dependency");
+        cJSON_Delete(root);
+        return;
+    }
+
+    cJSON *resp = cJSON_CreateObject();
+    cJSON_AddNumberToObject(resp, "blocking_task_id", (double)blocking_task_id);
+    cJSON_AddNumberToObject(resp, "dependent_task_id", (double)dependent_task_id);
+
+    char *body = cJSON_PrintUnformatted(resp);
+    cJSON_Delete(resp);
+
+    http_response_set_status(res, 201);
+    http_response_set_header(res, "Content-Type", "application/json; charset=utf-8");
+    http_response_set_body(res, body, strlen(body));
+
+    free(body);
+    cJSON_Delete(root);
+}
