+/* --- 7. Completing a task is rejected when a prerequisite is incomplete -----*/
+static void test_update_task_completed_rejects_incomplete_dependency(void **state)
+{
+    (void)state;
+
+    CF_TaskDependency deps[] = {
+        { .id = 1, .blocking_task_id = 10, .dependent_task_id = 20 },
+    };
+    CF_TaskDependencyList list = { .items = deps, .count = 1 };
+    CF_UpdateTaskStatusPayload payload = { .task_id = 20, .status = 2 };
+
+    expect_function_call(get_blocking_tasks_for_task);
+    expect_value(get_blocking_tasks_for_task, dependent_task_id, 20);
+    will_return(get_blocking_tasks_for_task, &list);
+    will_return(get_blocking_tasks_for_task, 0);
+
+    expect_function_call(get_task_completed_status);
+    expect_value(get_task_completed_status, task_id, 10);
+    will_return(get_task_completed_status, false);
+    will_return(get_task_completed_status, 0);
+
+    expect_not_function_call(update_task_status);
+
+    CF_CommandResult result = UpdateTaskCommandHandler(&payload);
+    assert_int_equal(result.status, 409);
+}
