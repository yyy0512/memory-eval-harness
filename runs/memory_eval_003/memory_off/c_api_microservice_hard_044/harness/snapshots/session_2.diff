+static bool
+cf_dependency_path_exists(uint64_t from_task_id, uint64_t target_task_id)
+{
+    if (from_task_id == target_task_id) {
+        return true;
+    }
+
+    CF_TaskDependencyList dependencies = {0};
+    if (get_blocking_tasks_for_task(from_task_id, &dependencies) != CF_DEP_OK) {
+        return false;
+    }
+
+    for (size_t i = 0; i < dependencies.count; ++i) {
+        uint64_t next = dependencies.items[i].blocking_task_id;
+        if (next == target_task_id || cf_dependency_path_exists(next, target_task_id)) {
+            cf_task_dependency_list_free(&dependencies);
+            return true;
+        }
+    }
+
+    cf_task_dependency_list_free(&dependencies);
+    return false;
+}
+
+static CF_CommandResult
+handle_create_task_dependency(const CF_CreateTaskDependencyPayload *payload)
+{
+    CF_CHECK(payload, CF_STATUS_INVALID_ARGUMENT,
+             "Task dependency payload is NULL");
+    CF_CHECK(payload->blocking_task_id != 0 && payload->dependent_task_id != 0,
+             CF_STATUS_VALIDATION_FAILED,
+             "Task dependency ids must be provided");
+    CF_CHECK(payload->blocking_task_id != payload->dependent_task_id,
+             CF_STATUS_VALIDATION_FAILED,
+             "Task cannot depend on itself");
+
+    if (cf_dependency_path_exists(payload->blocking_task_id,
+                                  payload->dependent_task_id)) {
+        return (CF_CommandResult){
+            .status = CF_STATUS_CONFLICT,
+            .message = "Task dependency would create a cycle"
+        };
+    }
+
+    CF_TaskDependency dependency = {
+        .blocking_task_id = payload->blocking_task_id,
+        .dependent_task_id = payload->dependent_task_id
+    };
+
+    cf_service_write_lock();
+    int rc = create_task_dependency(&dependency);
+    cf_service_write_unlock();
+
+    if (rc != CF_DEP_OK) {
+        return (CF_CommandResult){
+            .status = rc == CF_DEP_ERR_CONFLICT ? CF_STATUS_CONFLICT : CF_STATUS_INTERNAL_ERROR,
+            .message = "Failed to create task dependency"
+        };
+    }
+
+    CF_CommandResult result = { .status = CF_STATUS_OK };
+    snprintf(result.message, sizeof(result.message),
+             "Task dependency created (%llu -> %llu)",
+             (unsigned long long)payload->blocking_task_id,
+             (unsigned long long)payload->dependent_task_id);
+    return result;
+}
+
+CF_CommandResult
+UpdateTaskCommandHandler(const CF_UpdateTaskStatusPayload *payload)
+{
+    return handle_update_task_status(payload);
+}
+
+static CF_CommandResult
+handle_update_task_status(const CF_UpdateTaskStatusPayload *payload)
+{
+    CF_CHECK(payload, CF_STATUS_INVALID_ARGUMENT,
+             "Update task status payload is NULL");
+    CF_CHECK(payload->task_id != 0, CF_STATUS_VALIDATION_FAILED,
+             "Invalid task_id");
+
+    if (payload->status == CF_TASK_STATUS_COMPLETED) {
+        CF_TaskDependencyList dependencies = {0};
+        int dep_rc = get_blocking_tasks_for_task(payload->task_id, &dependencies);
+        if (dep_rc != CF_DEP_OK) {
+            return (CF_CommandResult){
+                .status = CF_STATUS_INTERNAL_ERROR,
+                .message = "Failed to load task dependencies"
+            };
+        }
+
+        for (size_t i = 0; i < dependencies.count; ++i) {
+            bool completed = false;
+            int status_rc = get_task_completed_status(
+                dependencies.items[i].blocking_task_id,
+                &completed
+            );
+            if (status_rc != CF_DEP_OK || !completed) {
+                cf_task_dependency_list_free(&dependencies);
+                return (CF_CommandResult){
+                    .status = CF_STATUS_CONFLICT,
+                    .message = "Cannot complete task before prerequisites are completed"
+                };
+            }
+        }
+
+        cf_task_dependency_list_free(&dependencies);
+    }
+
+    cf_service_write_lock();
+    int rc = update_task_status(payload->task_id, payload->status);
+    cf_service_write_unlock();
+
+    if (rc != CF_DEP_OK) {
+        return (CF_CommandResult){
+            .status = rc == CF_DEP_ERR_NOT_FOUND ? CF_STATUS_NOT_FOUND : CF_STATUS_INTERNAL_ERROR,
+            .message = "Failed to update task status"
+        };
+    }
+
+    CF_CommandResult result = { .status = CF_STATUS_OK };
+    snprintf(result.message, sizeof(result.message),
+             "Task id=%llu status updated", (unsigned long long)payload->task_id);
+    return result;
+}
