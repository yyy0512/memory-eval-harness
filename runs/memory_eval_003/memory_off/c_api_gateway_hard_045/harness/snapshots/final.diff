+static GqlError *make_heap_error(uint32_t line,
+                                 uint32_t col,
+                                 GqlErrorCode code,
+                                 const char *fmt, ...)
+{
+    GqlError *err = (GqlError *) calloc(1, sizeof(GqlError));
+    if (!err) { return NULL; }
+
+    err->code = code;
+    err->line = line;
+    err->column = col;
+
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(err->message, sizeof(err->message), fmt, ap);
+    va_end(ap);
+
+    return err;
+}
+
+static char *copy_json_string(json_t *obj, const char *key)
+{
+    json_t *value = json_object_get(obj, key);
+    if (!value || json_is_null(value)) { return NULL; }
+    if (!json_is_string(value)) { return NULL; }
+
+    const char *s = json_string_value(value);
+    if (!s) { return NULL; }
+
+    size_t len = strlen(s);
+    char *copy = (char *) malloc(len + 1);
+    if (!copy) { return NULL; }
+    memcpy(copy, s, len + 1);
+    return copy;
+}
+
+static bool parse_request_item(json_t *obj, GraphQLRequestItem *item)
+{
+    if (!json_is_object(obj)) {
+        item->error = make_heap_error(1, 1, GQL_ERR_INVALID_REQUEST,
+                                      "GraphQL request entry must be an object");
+        return false;
+    }
+
+    json_t *query = json_object_get(obj, "query");
+    if (!json_is_string(query)) {
+        item->error = make_heap_error(1, 1, GQL_ERR_INVALID_REQUEST,
+                                      "GraphQL request object must include string field 'query'");
+        return false;
+    }
+
+    item->query = copy_json_string(obj, "query");
+    item->operation_name = copy_json_string(obj, "operationName");
+
+    json_t *variables = json_object_get(obj, "variables");
+    if (variables && !json_is_null(variables)) {
+        item->variables_json = json_dumps(variables, JSON_COMPACT);
+        if (!item->variables_json) {
+            item->error = make_heap_error(1, 1, GQL_ERR_INVALID_REQUEST,
+                                          "Unable to serialize GraphQL variables");
+            return false;
+        }
+    }
+
+    GqlError *parse_error = NULL;
+    item->document = graphql_parse(item->query, &parse_error);
+    if (parse_error) {
+        item->error = make_heap_error(parse_error->line, parse_error->column,
+                                      parse_error->code, "%s",
+                                      parse_error->message);
+    }
+    return item->error == NULL;
+}
+
+GraphQLRequest *graphql_request_parse(const char *payload, GqlError **out_err)
+{
+    if (out_err) { *out_err = NULL; }
+    if (!payload) {
+        if (out_err) {
+            *out_err = make_heap_error(1, 1, GQL_ERR_INVALID_REQUEST,
+                                       "GraphQL request payload is NULL");
+        }
+        return NULL;
+    }
+
+    json_error_t json_err;
+    json_t *root = json_loads(payload, 0, &json_err);
+    if (!root) {
+        if (out_err) {
+            *out_err = make_heap_error((uint32_t) json_err.line,
+                                       (uint32_t) json_err.column,
+                                       GQL_ERR_INVALID_REQUEST,
+                                       "Invalid GraphQL JSON payload: %s",
+                                       json_err.text);
+        }
+        return NULL;
+    }
+
+    bool is_batch = json_is_array(root);
+    bool is_single = json_is_object(root);
+    if (!is_batch && !is_single) {
+        json_decref(root);
+        if (out_err) {
+            *out_err = make_heap_error(1, 1, GQL_ERR_INVALID_REQUEST,
+                                       "GraphQL request payload must be an object or array");
+        }
+        return NULL;
+    }
+
+    size_t count = is_batch ? json_array_size(root) : 1;
+    GraphQLRequest *request = (GraphQLRequest *) calloc(1, sizeof(GraphQLRequest));
+    if (!request) {
+        json_decref(root);
+        if (out_err) {
+            *out_err = make_heap_error(1, 1, GQL_ERR_OOM,
+                                       "Unable to allocate GraphQL request");
+        }
+        return NULL;
+    }
+
+    request->kind = is_batch ? GRAPHQL_REQUEST_BATCH : GRAPHQL_REQUEST_SINGLE;
+    request->count = count;
+    request->items = (GraphQLRequestItem *) calloc(count ? count : 1,
+                                                   sizeof(GraphQLRequestItem));
+    if (!request->items) {
+        free(request);
+        json_decref(root);
+        if (out_err) {
+            *out_err = make_heap_error(1, 1, GQL_ERR_OOM,
+                                       "Unable to allocate GraphQL request items");
+        }
+        return NULL;
+    }
+
+    if (is_batch) {
+        for (size_t i = 0; i < count; ++i) {
+            json_t *entry = json_array_get(root, i);
+            parse_request_item(entry, &request->items[i]);
+        }
+    } else {
+        parse_request_item(root, &request->items[0]);
+    }
+
+    json_decref(root);
+    return request;
+}
+
+void graphql_request_free(GraphQLRequest *request)
+{
+    if (!request) { return; }
+    for (size_t i = 0; i < request->count; ++i) {
+        free(request->items[i].query);
+        free(request->items[i].operation_name);
+        free(request->items[i].variables_json);
+        free(request->items[i].error);
+        if (request->items[i].document) {
+            graphql_doc_free(request->items[i].document);
+        }
+    }
+    free(request->items);
+    free(request);
+}
