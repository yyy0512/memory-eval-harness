 /* ────────────────────────────────────────────────────────────────────────── */
-/* Helper: JWT authentication                                               */
+/* GraphQL WS message processing and subscription registry                    */
+
+static void
+make_subscription_key(struct lws *wsi, const char *id, char *out, size_t out_cap)
+{
+    snprintf(out, out_cap, "%p:%s", (void *)wsi, id ? id : "");
+}
+
+static void
+free_subscription(pstream_ws_subscription_t *sub)
+{
+    if (!sub)
+        return;
+
+    graphql_free_document(&sub->document);
+    free(sub->query);
+    free(sub->variables_json);
+    free(sub);
+}
+
+static const char *
+operation_kind_name(gql_operation_kind_t kind)
+{
+    switch (kind) {
+    case GQL_OP_QUERY:        return "query";
+    case GQL_OP_MUTATION:     return "mutation";
+    case GQL_OP_SUBSCRIPTION: return "subscription";
+    default:                  return "unknown";
+    }
+}
+
+static int
+send_ws_error(pstream_ws_client_t *client, const char *id, const char *message)
+{
+    json_t *root = json_pack("{s:s, s:s}", "type", "error", "message", message);
+    if (!root)
+        return -1;
+
+    if (id)
+        json_object_set_new(root, "id", json_string(id));
+
+    char *payload = json_dumps(root, JSON_COMPACT);
+    json_decref(root);
+    if (!payload)
+        return -1;
+
+    int rc = queue_outbound_json(client, (const uint8_t *)payload, strlen(payload));
+    free(payload);
+    return rc;
+}
+
+static int
+register_subscription(pstream_ws_client_t *client,
+                      const char *id,
+                      const char *query,
+                      json_t *variables)
+{
+    if (!id || id[0] == '\0' || strlen(id) >= WS_SUBSCRIPTION_ID_MAX)
+        return send_ws_error(client, id, "Subscription id is required");
+    if (!query || query[0] == '\0')
+        return send_ws_error(client, id, "Subscription query is required");
+
+    pstream_ws_subscription_t *sub = calloc(1, sizeof(*sub));
+    if (!sub)
+        return send_ws_error(client, id, "Unable to allocate subscription");
+
+    strncpy(sub->id, id, sizeof(sub->id) - 1);
+    make_subscription_key(client->wsi, id, sub->key, sizeof(sub->key));
+    sub->wsi = client->wsi;
+    sub->user_id = client->claims.user_id;
+    sub->query = strdup(query);
+    if (!sub->query) {
+        free_subscription(sub);
+        return send_ws_error(client, id, "Unable to allocate subscription query");
+    }
+
+    char errbuf[256];
+    if (graphql_parse_document(query, &sub->document, errbuf, sizeof(errbuf)) != 0) {
+        free_subscription(sub);
+        return send_ws_error(client, id, errbuf[0] ? errbuf : "Invalid GraphQL document");
+    }
+
+    if (sub->document.op_cnt == 0 ||
+        sub->document.operations[0].kind != GQL_OP_SUBSCRIPTION) {
+        free_subscription(sub);
+        return send_ws_error(client, id, "GraphQL operation is not a subscription");
+    }
+
+    if (variables) {
+        sub->variables_json = json_dumps(variables, JSON_COMPACT);
+        if (!sub->variables_json) {
+            free_subscription(sub);
+            return send_ws_error(client, id, "Unable to serialize variables");
+        }
+    }
+
+    pthread_mutex_lock(&g_ws.lock);
+
+    pstream_ws_subscription_t *existing = NULL;
+    HASH_FIND_STR(g_ws.subscriptions, sub->key, existing);
+    if (existing) {
+        HASH_DEL(g_ws.subscriptions, existing);
+        free_subscription(existing);
+    }
+
+    HASH_ADD_STR(g_ws.subscriptions, key, sub);
+    pthread_mutex_unlock(&g_ws.lock);
+
+    log_info("websocket: registered subscription id=%s uid=%"PRIu64,
+             id, client->claims.user_id);
+    return 0;
+}
+
+static void
+remove_subscription(pstream_ws_client_t *client, const char *id)
+{
+    if (!id)
+        return;
+
+    char key[WS_SUBSCRIPTION_ID_MAX + 32];
+    make_subscription_key(client->wsi, id, key, sizeof(key));
+
+    pthread_mutex_lock(&g_ws.lock);
+    pstream_ws_subscription_t *sub = NULL;
+    HASH_FIND_STR(g_ws.subscriptions, key, sub);
+    if (sub) {
+        HASH_DEL(g_ws.subscriptions, sub);
+        log_info("websocket: removed subscription id=%s uid=%"PRIu64,
+                 id, client->claims.user_id);
+    }
+    pthread_mutex_unlock(&g_ws.lock);
+
+    free_subscription(sub);
+}
+
+static void
+remove_client_subscriptions(pstream_ws_client_t *client)
+{
+    pstream_ws_subscription_t *sub, *tmp;
+
+    pthread_mutex_lock(&g_ws.lock);
+    HASH_ITER(hh, g_ws.subscriptions, sub, tmp) {
+        if (sub->wsi == client->wsi) {
+            HASH_DEL(g_ws.subscriptions, sub);
+            free_subscription(sub);
+        }
+    }
+    pthread_mutex_unlock(&g_ws.lock);
+}
+
+static int
+handle_graphql_ws_message(pstream_ws_client_t *client,
+                          const uint8_t *payload,
+                          size_t len)
+{
+    char *text = malloc(len + 1);
+    if (!text)
+        return -1;
+
+    memcpy(text, payload, len);
+    text[len] = '\0';
+
+    json_error_t jerr;
+    json_t *root = json_loads(text, 0, &jerr);
+    free(text);
+    if (!root) {
+        log_warn("websocket: malformed json at line %d: %s", jerr.line, jerr.text);
+        send_ws_error(client, NULL, "Malformed JSON message");
+        return 0;
+    }
+
+    const char *type = json_string_value(json_object_get(root, "type"));
+    const char *id = json_string_value(json_object_get(root, "id"));
+
+    if (type && strcmp(type, "stop") == 0) {
+        remove_subscription(client, id);
+        json_decref(root);
+        return 0;
+    }
+
+    if (type && strcmp(type, "terminate") == 0) {
+        remove_client_subscriptions(client);
+        json_decref(root);
+        return -1;
+    }
+
+    if (type && strcmp(type, "start") != 0 && strcmp(type, "subscribe") != 0) {
+        log_debug("websocket: ignoring graphql-ws message type=%s from uid=%"PRIu64,
+                  type, client->claims.user_id);
+        json_decref(root);
+        return 0;
+    }
+
+    json_t *request = json_object_get(root, "payload");
+    if (!json_is_object(request))
+        request = root;
+
+    const char *query = json_string_value(json_object_get(request, "query"));
+    if (!query || query[0] == '\0') {
+        int rc = send_ws_error(client, id, "GraphQL query is required");
+        json_decref(root);
+        return rc;
+    }
+
+    gql_document_t doc;
+    char errbuf[256];
+    if (graphql_parse_document(query, &doc, errbuf, sizeof(errbuf)) != 0) {
+        int rc = send_ws_error(client, id, errbuf[0] ? errbuf : "Invalid GraphQL document");
+        json_decref(root);
+        return rc;
+    }
+
+    gql_operation_kind_t kind = doc.op_cnt > 0
+                              ? doc.operations[0].kind
+                              : GQL_OP_QUERY;
+    graphql_free_document(&doc);
+
+    if (kind != GQL_OP_SUBSCRIPTION) {
+        log_debug("websocket: received %s operation over ws from uid=%"PRIu64,
+                  operation_kind_name(kind), client->claims.user_id);
+        json_decref(root);
+        return 0;
+    }
+
+    json_t *variables = json_object_get(request, "variables");
+    int rc = register_subscription(client, id, query, variables);
+
+    json_decref(root);
+    return rc;
+}
+
