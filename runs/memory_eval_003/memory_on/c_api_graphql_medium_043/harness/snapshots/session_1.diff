 /* ────────────────────────────────────────────────────────────────────────── */
+/* Helper: GraphQL WebSocket message processing                              */
+
+static char *
+json_dump_compact_or_empty(json_t *value)
+{
+    if (!value)
+        return strdup("");
+
+    char *dumped = json_dumps(value, JSON_COMPACT);
+    if (dumped)
+        return dumped;
+
+    return strdup("");
+}
+
+static const char *
+operation_kind_name(gql_operation_kind_t kind)
+{
+    switch (kind) {
+    case GQL_OP_QUERY:
+        return "query";
+    case GQL_OP_MUTATION:
+        return "mutation";
+    case GQL_OP_SUBSCRIPTION:
+        return "subscription";
+    default:
+        return "unknown";
+    }
+}
+
+static void
+free_subscription(pstream_subscription_t *sub)
+{
+    if (!sub)
+        return;
+
+    free(sub->subscription_id);
+    free(sub->connection_id);
+    free(sub->query);
+    free(sub->operation_name);
+    free(sub->variables_json);
+    free(sub);
+}
+
+static void
+remove_client_subscriptions(pstream_ws_client_t *client)
+{
+    pstream_subscription_t *sub, *tmp;
+
+    pthread_mutex_lock(&g_ws.lock);
+    HASH_ITER(hh, g_ws.subscriptions, sub, tmp) {
+        if (sub->client == client) {
+            HASH_DEL(g_ws.subscriptions, sub);
+            free_subscription(sub);
+        }
+    }
+    pthread_mutex_unlock(&g_ws.lock);
+}
+
+static int
+store_subscription(pstream_subscription_t *sub)
+{
+    pthread_mutex_lock(&g_ws.lock);
+
+    pstream_subscription_t *existing = NULL;
+    HASH_FIND_STR(g_ws.subscriptions, sub->subscription_id, existing);
+    if (existing) {
+        HASH_DEL(g_ws.subscriptions, existing);
+        free_subscription(existing);
+    }
+
+    HASH_ADD_KEYPTR(hh, g_ws.subscriptions, sub->subscription_id,
+                    strlen(sub->subscription_id), sub);
+
+    pthread_mutex_unlock(&g_ws.lock);
+    return 0;
+}
+
+static int
+handle_subscription_operation(pstream_ws_client_t *client,
+                              const char *message_id,
+                              const char *query,
+                              const char *operation_name,
+                              json_t *variables)
+{
+    pstream_subscription_t *sub = calloc(1, sizeof(*sub));
+    if (!sub)
+        return -ENOMEM;
+
+    char fallback_id[64];
+    snprintf(fallback_id, sizeof(fallback_id), "%s:%p",
+             client->connection_id, (const void *)sub);
+
+    const char *subscription_id = message_id && *message_id ? message_id : fallback_id;
+    sub->subscription_id = strdup(subscription_id);
+    sub->connection_id = strdup(client->connection_id);
+    sub->query = strdup(query);
+    sub->operation_name = strdup(operation_name ? operation_name : "");
+    sub->variables_json = json_dump_compact_or_empty(variables);
+    sub->client = client;
+
+    if (!sub->subscription_id || !sub->connection_id || !sub->query ||
+        !sub->operation_name || !sub->variables_json) {
+        free_subscription(sub);
+        return -ENOMEM;
+    }
+
+    store_subscription(sub);
+
+    log_info("websocket: registered subscription id=%s conn=%s uid=%"PRIu64,
+             sub->subscription_id, sub->connection_id, client->claims.user_id);
+    return 0;
+}
+
+static int
+process_graphql_ws_message(pstream_ws_client_t *client, const char *payload, size_t len)
+{
+    char *json_text = malloc(len + 1);
+    if (!json_text)
+        return -ENOMEM;
+
+    memcpy(json_text, payload, len);
+    json_text[len] = '\0';
+
+    json_error_t jerr;
+    json_t *root = json_loads(json_text, 0, &jerr);
+    free(json_text);
+
+    if (!root) {
+        log_warn("websocket: malformed JSON frame at line %d: %s",
+                 jerr.line, jerr.text);
+        return -EINVAL;
+    }
+
+    const char *message_id = json_string_value(json_object_get(root, "id"));
+    json_t *message_payload = json_object_get(root, "payload");
+    json_t *request = json_is_object(message_payload) ? message_payload : root;
+
+    const char *query = json_string_value(json_object_get(request, "query"));
+    const char *operation_name =
+        json_string_value(json_object_get(request, "operationName"));
+    json_t *variables = json_object_get(request, "variables");
+
+    if (!query) {
+        json_decref(root);
+        log_warn("websocket: GraphQL frame missing query");
+        return -EINVAL;
+    }
+
+    gql_document_t doc;
+    char errbuf[256];
+    if (graphql_parse_document(query, &doc, errbuf, sizeof(errbuf)) != 0) {
+        json_decref(root);
+        log_warn("websocket: GraphQL parse failed: %s", errbuf);
+        return -EINVAL;
+    }
+
+    if (doc.op_cnt == 0) {
+        graphql_free_document(&doc);
+        json_decref(root);
+        log_warn("websocket: GraphQL frame contained no operations");
+        return -EINVAL;
+    }
+
+    gql_operation_t *op = &doc.operations[0];
+    log_debug("websocket: received %s operation from uid=%"PRIu64,
+              operation_kind_name(op->kind), client->claims.user_id);
+
+    int rc = 0;
+    if (op->kind == GQL_OP_SUBSCRIPTION) {
+        rc = handle_subscription_operation(client, message_id, query,
+                                           operation_name, variables);
+    } else {
+        log_debug("websocket: leaving %s operation on existing execution path",
+                  operation_kind_name(op->kind));
+    }
+
+    graphql_free_document(&doc);
+    json_decref(root);
+    return rc;
+}
