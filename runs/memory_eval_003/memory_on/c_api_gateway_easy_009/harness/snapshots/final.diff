+static const char *
+client_ip_address(struct MHD_Connection *connection, char *buf, size_t buf_size)
+{
+    const union MHD_ConnectionInfo *info =
+        MHD_get_connection_info(connection, MHD_CONNECTION_INFO_CLIENT_ADDRESS);
+
+    if (!info || !info->client_addr)
+        return "unknown";
+
+    const struct sockaddr *addr = info->client_addr;
+    void *src = NULL;
+
+    if (addr->sa_family == AF_INET) {
+        src = &((const struct sockaddr_in *)addr)->sin_addr;
+    } else if (addr->sa_family == AF_INET6) {
+        src = &((const struct sockaddr_in6 *)addr)->sin6_addr;
+    }
+
+    if (!src || !inet_ntop(addr->sa_family, src, buf, (socklen_t)buf_size))
+        return "unknown";
+
+    return buf;
+}
+
+static const char *
+api_version_from_url(const char *url, char *buf, size_t buf_size)
+{
+    if (!url || url[0] != '/' || url[1] == '\0' || buf_size == 0)
+        return NULL;
+
+    const char *start = url + 1;
+    const char *end = strchr(start, '/');
+    size_t len = end ? (size_t)(end - start) : strlen(start);
+    if (len == 0 || len >= buf_size)
+        return NULL;
+
+    memcpy(buf, start, len);
+    buf[len] = '\0';
+    return buf;
+}
