+GraphQLDocument *graphql_parse_request(const char *payload,
+                                       size_t payload_len,
+                                       GqlError **out_err)
+{
+    if (out_err) *out_err = NULL;
+    if (!payload) return NULL;
+
+    cJSON *root = cJSON_ParseWithLength(payload, payload_len);
+    if (!root) {
+        return graphql_parse(payload, out_err);
+    }
+
+    if (!cJSON_IsArray(root)) {
+        cJSON *query = cJSON_GetObjectItemCaseSensitive(root, "query");
+        if (!cJSON_IsString(query) || !query->valuestring) {
+            if (out_err) *out_err = NULL;
+            cJSON_Delete(root);
+            return NULL;
+        }
+        GraphQLDocument *doc = graphql_parse(query->valuestring, out_err);
+        cJSON_Delete(root);
+        return doc;
+    }
+
+    MemArena batch_arena = {0};
+    GraphQLDocument *batch = (GraphQLDocument *) arena_alloc(&batch_arena,
+                                                             sizeof(GraphQLDocument));
+    if (!batch) {
+        cJSON_Delete(root);
+        return NULL;
+    }
+    memset(batch, 0, sizeof(GraphQLDocument));
+    batch->arena_head = batch_arena.head;
+    batch->request_kind = GQL_REQUEST_BATCH;
+    batch->batch_count = (size_t) cJSON_GetArraySize(root);
+
+    if (batch->batch_count > 0) {
+        batch->batch_items = (GraphQLDocument **) arena_alloc(
+                &batch_arena, batch->batch_count * sizeof(GraphQLDocument *));
+        batch->batch_errors = (GqlError **) arena_alloc(
+                &batch_arena, batch->batch_count * sizeof(GqlError *));
+        if (!batch->batch_items || !batch->batch_errors) {
+            cJSON_Delete(root);
+            arena_reset(&batch_arena);
+            return NULL;
+        }
+        memset(batch->batch_items, 0,
+               batch->batch_count * sizeof(GraphQLDocument *));
+        memset(batch->batch_errors, 0,
+               batch->batch_count * sizeof(GqlError *));
+    }
+
+    size_t idx = 0;
+    cJSON *item = NULL;
+    cJSON_ArrayForEach(item, root) {
+        cJSON *query = cJSON_IsObject(item)
+                     ? cJSON_GetObjectItemCaseSensitive(item, "query")
+                     : NULL;
+        if (!cJSON_IsString(query) || !query->valuestring) {
+            batch->batch_errors[idx] = (GqlError *) arena_alloc(&batch_arena,
+                                                                sizeof(GqlError));
+            if (batch->batch_errors[idx]) {
+                batch->batch_errors[idx]->code = GQL_ERR_INVALID_REQUEST;
+                batch->batch_errors[idx]->line = 0;
+                batch->batch_errors[idx]->column = 0;
+                snprintf(batch->batch_errors[idx]->message,
+                         sizeof(batch->batch_errors[idx]->message),
+                         "Expected GraphQL request object with string query");
+            }
+            idx++;
+            continue;
+        }
+
+        GqlError *item_err = NULL;
+        batch->batch_items[idx] = graphql_parse(query->valuestring, &item_err);
+        if (item_err) {
+            batch->batch_errors[idx] = clone_error(&batch_arena, item_err);
+        }
+        idx++;
+    }
+
+    batch->arena_head = batch_arena.head;
+    cJSON_Delete(root);
+    return batch;
+}
