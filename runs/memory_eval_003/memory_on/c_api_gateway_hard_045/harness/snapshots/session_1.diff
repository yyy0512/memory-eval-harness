+static char *arena_strdup(MemArena *arena, const char *src)
+{
+    if (!src) return NULL;
+    size_t len = strlen(src);
+    char *dst = (char *) arena_alloc(arena, len + 1U);
+    if (!dst) return NULL;
+    memcpy(dst, src, len + 1U);
+    return dst;
+}
+
+static GqlError *clone_error(MemArena *arena, const GqlError *src)
+{
+    if (!src) return NULL;
+    GqlError *dst = (GqlError *) arena_alloc(arena, sizeof(GqlError));
+    if (!dst) return NULL;
+    memcpy(dst, src, sizeof(GqlError));
+    return dst;
+}
