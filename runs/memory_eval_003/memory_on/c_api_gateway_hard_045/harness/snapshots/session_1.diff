 static void *arena_alloc(MemArena *a, size_t size)
 {
+    if (size == 0) size = 1;
+    size = (size + sizeof(void *) - 1U) & ~(sizeof(void *) - 1U);
+
+    if (size > ARENA_BLOCK_SIZE) {
+        size_t block_size = sizeof(ArenaBlock) + size;
+        ArenaBlock *blk   = (ArenaBlock *) malloc(block_size);
+        if (!blk) { return NULL; }
+        blk->next = a->head;
+        blk->used = size;
+        a->head   = blk;
+        return blk->data;
+    }
+
     if (!a->head || (a->head->used + size > ARENA_BLOCK_SIZE)) {
         size_t block_size = sizeof(ArenaBlock) + ARENA_BLOCK_SIZE;
         ArenaBlock *blk   = (ArenaBlock *) malloc(block_size);
@@ -68,6 +83,25 @@ static void arena_reset(MemArena *a)
