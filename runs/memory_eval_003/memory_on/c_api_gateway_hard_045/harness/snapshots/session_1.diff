+/*───────────────────────────
+ *   Gateway GraphQL Request Model
+ *───────────────────────────*/
+
+typedef enum {
+    GQL_ERR_NONE = 0,
+    GQL_ERR_SYNTAX,
+    GQL_ERR_OOM,
+    GQL_ERR_INVALID_REQUEST
+} GqlErrorCode;
+
+typedef enum {
+    GQL_OP_QUERY = 0,
+    GQL_OP_MUTATION,
+    GQL_OP_SUBSCRIPTION
+} GqlOperationType;
+
+typedef enum {
+    GQL_REQUEST_SINGLE = 0,
+    GQL_REQUEST_BATCH
+} GraphQLRequestKind;
+
+typedef struct GqlError {
+    GqlErrorCode code;
+    uint32_t line;
+    uint32_t column;
+    char message[SP_GQL_MAX_ERROR_MSG];
+} GqlError;
+
+typedef struct GqlArgument {
+    char *name;
+    char *value;
+    struct GqlArgument *next;
+} GqlArgument;
+
+typedef struct GqlField {
+    char *name;
+    char *alias;
+    GqlArgument *arguments;
+    struct GqlField *children;
+    struct GqlField *next;
+} GqlField;
+
+typedef struct GqlOperation {
+    GqlOperationType type;
+    char *name;
+    GqlField *selection_set;
+    struct GqlOperation *next;
+} GqlOperation;
+
+typedef struct GraphQLDocument {
+    void *arena_head;                    /* Private parser arena ownership.        */
+    GraphQLRequestKind request_kind;     /* Single operation payload or batch.     */
+    GqlOperation *operations;
+    struct GraphQLDocument **batch_items;/* Parsed documents for batched payloads. */
+    GqlError **batch_errors;             /* Per-item parse errors, if any.        */
+    size_t batch_count;
+} GraphQLDocument;
+
+GraphQLDocument *graphql_parse(const char *query, GqlError **out_err);
+GraphQLDocument *graphql_parse_request(const char *payload,
+                                       size_t payload_len,
+                                       GqlError **out_err);
+void graphql_doc_free(GraphQLDocument *doc);
+void graphql_doc_debug_print(const GraphQLDocument *doc);
+
 /*───────────────────────────
  *        Public API
  *───────────────────────────*/
