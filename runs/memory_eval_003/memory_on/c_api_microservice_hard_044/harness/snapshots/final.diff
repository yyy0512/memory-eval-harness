+/*-----------------------------------------------------------------------------
+ *  /v1/tasks/{taskId}/dependencies  (POST)
+ *---------------------------------------------------------------------------*/
+static void
+handle_post_task_dependency(const http_request_t *req, http_response_t *res)
+{
+    if (strcmp(req->content_type, "application/json") != 0)
+    {
+        json_error(res, 415, "Unsupported Media Type", "Expecting application/json payload");
+        return;
+    }
+
+    cf_rest_uuid_t dependent_task_id;
+    if (!parse_dependency_uri(req->uri, &dependent_task_id))
+    {
+        json_error(res, 404, "Not Found", NULL);
+        return;
+    }
+
+    cJSON *root = cJSON_ParseWithLength(req->body, req->body_length);
+    if (!root || !cJSON_IsObject(root))
+    {
+        json_error(res, 400, "Bad Request", "Malformed JSON");
+        if (root) cJSON_Delete(root);
+        return;
+    }
+
+    const cJSON *blocking_task_id_json = cJSON_GetObjectItemCaseSensitive(root, "blocking_task_id");
+    if (!cJSON_IsString(blocking_task_id_json) || !blocking_task_id_json->valuestring)
+    {
+        json_error(res, 422, "Unprocessable Entity", "Field [blocking_task_id] is mandatory");
+        cJSON_Delete(root);
+        return;
+    }
+
+    CF_CreateTaskDependencyPayload payload;
+    memset(&payload, 0, sizeof payload);
+    payload.dependent_task_id = dependent_task_id;
+
+    if (uuid_parse_text(blocking_task_id_json->valuestring, &payload.blocking_task_id) != 0)
+    {
+        json_error(res, 422, "Unprocessable Entity", "blocking_task_id must be a UUID");
+        cJSON_Delete(root);
+        return;
+    }
+
+    CF_Command command = {
+        .type = CF_CMD_CREATE_TASK_DEPENDENCY,
+        .payload = &payload
+    };
+    CF_CommandResult result = cf_dispatch_command(&command);
+
+    if (result.status != CF_STATUS_OK)
+    {
+        json_error(res, status_for_command_result(result.status), result.message, NULL);
+        cf_free_command_result(&result);
+        cJSON_Delete(root);
+        return;
+    }
+
+    char dependent_id_buf[37];
+    char blocking_id_buf[37];
+    uuid_unparse_text(&payload.dependent_task_id, dependent_id_buf);
+    uuid_unparse_text(&payload.blocking_task_id, blocking_id_buf);
+
+    cJSON *resp = cJSON_CreateObject();
+    cJSON_AddStringToObject(resp, "dependent_task_id", dependent_id_buf);
+    cJSON_AddStringToObject(resp, "blocking_task_id", blocking_id_buf);
+
+    char *body = cJSON_PrintUnformatted(resp);
+    cJSON_Delete(resp);
+
+    http_response_set_status(res, 201);
+    http_response_set_header(res, "Content-Type", "application/json; charset=utf-8");
+    http_response_set_body(res, body, strlen(body));
+
+    free(body);
+    cf_free_command_result(&result);
+    cJSON_Delete(root);
+}
