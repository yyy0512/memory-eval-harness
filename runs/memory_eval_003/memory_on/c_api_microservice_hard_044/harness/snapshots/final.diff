+static int
+hex_value(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int
+uuid_parse_text(const char *str, cf_rest_uuid_t *out)
+{
+    if (!str || !out || strlen(str) != 36) { return -1; }
+
+    memset(out, 0, sizeof(*out));
+    size_t byte_idx = 0;
+    int high_nibble = -1;
+
+    for (const char *p = str; *p; ++p) {
+        if (*p == '-') continue;
+
+        int value = hex_value(*p);
+        if (value < 0) { return -1; }
+
+        if (high_nibble < 0) {
+            high_nibble = value;
+        } else {
+            if (byte_idx >= sizeof(out->bytes)) { return -1; }
+            out->bytes[byte_idx++] = (uint8_t)((high_nibble << 4) | value);
+            high_nibble = -1;
+        }
+    }
+
+    return (byte_idx == sizeof(out->bytes) && high_nibble < 0) ? 0 : -1;
+}
+
+static void
+uuid_unparse_text(const cf_rest_uuid_t *uuid, char out[37])
+{
+    static const char hex[] = "0123456789abcdef";
+    size_t j = 0;
+
+    for (size_t i = 0; i < sizeof(uuid->bytes); ++i) {
+        if (i == 4 || i == 6 || i == 8 || i == 10) {
+            out[j++] = '-';
+        }
+        out[j++] = hex[(uuid->bytes[i] >> 4) & 0x0f];
+        out[j++] = hex[uuid->bytes[i] & 0x0f];
+    }
+    out[j] = '\0';
+}
+
+static bool
+parse_dependency_uri(const char *uri, cf_rest_uuid_t *dependent_task_id)
+{
+    const char *prefix = "/v1/tasks/";
+    const char *suffix = "/dependencies";
+    size_t prefix_len = strlen(prefix);
+    size_t suffix_len = strlen(suffix);
+    size_t uri_len = strlen(uri);
+
+    if (strncmp(uri, prefix, prefix_len) != 0 || uri_len <= prefix_len + suffix_len) {
+        return false;
+    }
+    if (strcmp(uri + uri_len - suffix_len, suffix) != 0) {
+        return false;
+    }
+
+    size_t id_len = uri_len - prefix_len - suffix_len;
+    if (id_len != 36) { return false; }
+
+    char id_buf[37];
+    memcpy(id_buf, uri + prefix_len, id_len);
+    id_buf[id_len] = '\0';
+
+    return uuid_parse_text(id_buf, dependent_task_id) == 0;
+}
