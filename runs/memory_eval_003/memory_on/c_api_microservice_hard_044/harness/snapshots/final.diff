+static int
+status_for_command_result(CF_Status status)
+{
+    switch (status) {
+        case CF_STATUS_OK:
+            return 201;
+        case CF_STATUS_CONFLICT:
+            return 409;
+        case CF_STATUS_NOT_FOUND:
+            return 404;
+        case CF_STATUS_INVALID_ARGUMENT:
+        case CF_STATUS_VALIDATION_FAILED:
+            return 422;
+        case CF_STATUS_FORBIDDEN:
+            return 403;
+        case CF_STATUS_NOT_IMPLEMENTED:
+            return 501;
+        default:
+            return 500;
+    }
+}
