+static bool
+cf_uuid_equal_local(const cf_repo_uuid_t *a, const cf_repo_uuid_t *b)
+{
+    return memcmp(a->bytes, b->bytes, sizeof(a->bytes)) == 0;
+}
+
+static bool
+cf_uuid_is_nil_local(const cf_repo_uuid_t *uuid)
+{
+    static const uint8_t zero[16] = {0};
+    return memcmp(uuid->bytes, zero, sizeof(zero)) == 0;
+}
+
+static CF_CommandResult
+cf_command_error(CF_Status status, const char *message)
+{
+    CF_CommandResult result = { .status = status };
+    snprintf(result.message, sizeof(result.message), "%s", message);
+    return result;
+}
+
+static CF_Status
+cf_status_from_repo_error(cf_repo_error_t err)
+{
+    switch (err) {
+        case CF_REPO_OK:
+            return CF_STATUS_OK;
+        case CF_REPO_ERR_INVALID_ARGUMENT:
+        case CF_REPO_ERR_NULL_POINTER:
+        case CF_REPO_ERR_INVALID_UUID:
+            return CF_STATUS_VALIDATION_FAILED;
+        case CF_REPO_ERR_NOT_FOUND:
+            return CF_STATUS_NOT_FOUND;
+        case CF_REPO_ERR_CONFLICT:
+            return CF_STATUS_CONFLICT;
+        default:
+            return CF_STATUS_INTERNAL_ERROR;
+    }
+}
+
+static bool
+cf_task_has_dependency_path(const cf_repo_uuid_t *start_task_id,
+                            const cf_repo_uuid_t *target_task_id,
+                            unsigned depth)
+{
+    if (depth > 64) return true;
+    if (cf_uuid_equal_local(start_task_id, target_task_id)) return true;
+
+    cf_cursor_t *cursor = NULL;
+    cf_repo_error_t rc = cf_repository_get_blocking_tasks_for_task(NULL, start_task_id, &cursor);
+    if (rc != CF_REPO_OK || !cursor) return false;
+
+    cf_repo_task_t blocking_task;
+    bool found = false;
+    while (cf_cursor_next_task(cursor, &blocking_task) == CF_REPO_OK) {
+        if (cf_uuid_equal_local(&blocking_task.id, target_task_id) ||
+            cf_task_has_dependency_path(&blocking_task.id, target_task_id, depth + 1)) {
+            found = true;
+            break;
+        }
+    }
+
+    cf_cursor_free(cursor);
+    return found;
+}
