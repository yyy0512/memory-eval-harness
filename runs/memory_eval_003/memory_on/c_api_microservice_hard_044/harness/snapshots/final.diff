+    if (gql_uuid_parse(task_id_json->valuestring, &task_id) != 0) {
+        cJSON_Delete(args);
+        *out_json = gql_json_error("taskId must be a UUID");
+        return CHRONO_GQL_ERR_VARIABLES;
