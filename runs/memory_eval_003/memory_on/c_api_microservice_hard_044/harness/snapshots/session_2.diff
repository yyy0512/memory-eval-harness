+/**
+ * Update-Task Command
+ * -------------------
+ * When marking a task done, all blocking prerequisite tasks must already be done.
+ */
+static CF_CommandResult
+handle_update_task(const CF_UpdateTaskPayload *payload)
+{
+    CF_CHECK(!cf_uuid_is_nil_local(&payload->task_id),
+             CF_STATUS_VALIDATION_FAILED,
+             "Invalid task_id");
+
+    cf_repo_task_t task;
+    memset(&task, 0, sizeof task);
+    cf_repo_error_t rc = cf_repository_get_task(NULL, &payload->task_id, &task);
+    if (rc != CF_REPO_OK) {
+        return cf_command_error(cf_status_from_repo_error(rc), "Task not found");
+    }
+
+    CF_TaskState previous_state = task.state;
+    if (payload->update_state) {
+        task.state = payload->state;
+    }
+
+    if (previous_state != CF_TASK_DONE && task.state == CF_TASK_DONE) {
+        cf_cursor_t *cursor = NULL;
+        rc = cf_repository_get_blocking_tasks_for_task(NULL, &payload->task_id, &cursor);
+        if (rc != CF_REPO_OK) {
+            return cf_command_error(cf_status_from_repo_error(rc),
+                                    "Failed to load task dependencies");
+        }
+
+        cf_repo_task_t blocking_task;
+        while (cursor && cf_cursor_next_task(cursor, &blocking_task) == CF_REPO_OK) {
+            if (blocking_task.state != CF_TASK_DONE) {
+                cf_cursor_free(cursor);
+                return cf_command_error(CF_STATUS_CONFLICT,
+                                        "Cannot complete task until all dependencies are completed");
+            }
+        }
+        cf_cursor_free(cursor);
+    }
+
+    cf_service_write_lock();
+    rc = cf_repository_update_task(NULL, &task);
+    cf_service_write_unlock();
+
+    if (rc != CF_REPO_OK) {
+        return cf_command_error(cf_status_from_repo_error(rc), "Failed to update task");
+    }
+
+    return cf_command_error(CF_STATUS_OK, "Task updated");
+}
+
+/**
+ * Create-Task-Dependency Command
+ * ------------------------------
+ * Rejects self-dependencies and dependency edges that would introduce a cycle.
+ */
+static CF_CommandResult
+handle_create_task_dependency(const CF_CreateTaskDependencyPayload *payload)
+{
+    CF_CHECK(!cf_uuid_is_nil_local(&payload->blocking_task_id) &&
+             !cf_uuid_is_nil_local(&payload->dependent_task_id),
+             CF_STATUS_VALIDATION_FAILED,
+             "Invalid dependency task id");
+    CF_CHECK(!cf_uuid_equal_local(&payload->blocking_task_id,
+                                  &payload->dependent_task_id),
+             CF_STATUS_VALIDATION_FAILED,
+             "A task cannot depend on itself");
+
+    if (cf_task_has_dependency_path(&payload->blocking_task_id,
+                                    &payload->dependent_task_id,
+                                    0)) {
+        return cf_command_error(CF_STATUS_CONFLICT,
+                                "Task dependency would create a cycle");
+    }
+
+    cf_repo_task_dependency_t dependency;
+    memset(&dependency, 0, sizeof dependency);
+    dependency.blocking_task_id = payload->blocking_task_id;
+    dependency.dependent_task_id = payload->dependent_task_id;
+
+    cf_repo_task_dependency_t created;
+    memset(&created, 0, sizeof created);
+
+    cf_service_write_lock();
+    cf_repo_error_t rc = cf_repository_create_task_dependency(NULL, &dependency, &created);
+    cf_service_write_unlock();
+
+    if (rc != CF_REPO_OK) {
+        return cf_command_error(cf_status_from_repo_error(rc),
+                                "Failed to create task dependency");
+    }
+
+    return cf_command_error(CF_STATUS_OK, "Task dependency created");
+}
