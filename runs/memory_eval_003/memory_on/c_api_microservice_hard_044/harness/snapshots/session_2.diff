+/*--------------------------------------------------------------------
+ * CRUD – Task Dependencies
+ *------------------------------------------------------------------*/
+cf_error_t cf_repository_create_task_dependency(cf_repository_t *repo,
+                                                const cf_task_dependency_t *in_dependency,
+                                                cf_task_dependency_t *out_created)
+{
+    (void)repo;
+
+    if (!in_dependency || !out_created) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(&in_dependency->blocking_task_id) ||
+        cf_uuid_is_nil(&in_dependency->dependent_task_id)) {
+        return CF_ERR_INVALID_UUID;
+    }
+    if (cf_uuid_equal(&in_dependency->blocking_task_id,
+                      &in_dependency->dependent_task_id)) {
+        return CF_ERR_INVALID_ARGUMENT;
+    }
+
+    char blocking_id[37];
+    char dependent_id[37];
+    cf_uuid_to_db_string(&in_dependency->blocking_task_id, blocking_id);
+    cf_uuid_to_db_string(&in_dependency->dependent_task_id, dependent_id);
+
+    const char *sql =
+        "INSERT INTO task_dependencies (blocking_task_id, dependent_task_id, created_at) "
+        "VALUES ($1, $2, EXTRACT(EPOCH FROM NOW())::bigint) "
+        "RETURNING dependency_id::text, blocking_task_id::text, dependent_task_id::text, created_at::text";
+
+    const char *params[2] = { blocking_id, dependent_id };
+
+    struct cf_task_dependency_row_ctx ctx;
+    memset(&ctx, 0, sizeof ctx);
+
+    int rc = cf_repo_execute(sql, 2, params, cf_task_dependency_from_row, &ctx);
+
+    if (rc != CF_ERR_OK) return rc;
+    if (!ctx.found) return CF_ERR_INTERNAL;
+
+    *out_created = ctx.dependency;
+    return CF_OK;
+}
+
+cf_error_t cf_repository_get_blocking_tasks_for_task(cf_repository_t *repo,
+                                                     const cf_uuid_t *task_id,
+                                                     cf_cursor_t **out_cursor)
+{
+    (void)repo;
+
+    if (!task_id || !out_cursor) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(task_id)) return CF_ERR_INVALID_UUID;
+
+    char dependent_id[37];
+    cf_uuid_to_db_string(task_id, dependent_id);
+
+    const char *sql =
+        "SELECT t.task_id, t.summary, t.details, t.status, t.priority, "
+        "       t.created_at, t.updated_at "
+        "  FROM tasks t "
+        "  JOIN task_dependencies td ON td.blocking_task_id = t.task_id "
+        " WHERE td.dependent_task_id = $1";
+
+    const char *params[1] = { dependent_id };
+    return (cf_error_t)cf_repo_execute(sql, 1, params, NULL, out_cursor);
+}
+
+cf_error_t cf_repository_delete_dependency(cf_repository_t *repo,
+                                           const cf_uuid_t *dependency_id)
+{
+    (void)repo;
+
+    if (!dependency_id) return CF_ERR_NULL_POINTER;
+    if (cf_uuid_is_nil(dependency_id)) return CF_ERR_INVALID_UUID;
+
+    char dependency_id_str[37];
+    cf_uuid_to_db_string(dependency_id, dependency_id_str);
+
+    const char *sql = "DELETE FROM task_dependencies WHERE dependency_id = $1 RETURNING dependency_id::text";
+    const char *params[1] = { dependency_id_str };
+    int deleted = 0;
+
+    int rc = cf_repo_execute(sql, 1, params, cf_dependency_delete_marker, &deleted);
+    if (rc != CF_ERR_OK) return (cf_error_t)rc;
+
+    return deleted ? CF_OK : CF_ERR_NOT_FOUND;
+}
+
+static int cf_task_dependency_from_row(int row, PGresult *res, void *user_data)
+{
+    struct cf_task_dependency_row_ctx *ctx = user_data;
+
+    if (cf_uuid_from_db_string(PQgetvalue(res, row, 0), &ctx->dependency.id) != 0 ||
+        cf_uuid_from_db_string(PQgetvalue(res, row, 1), &ctx->dependency.blocking_task_id) != 0 ||
+        cf_uuid_from_db_string(PQgetvalue(res, row, 2), &ctx->dependency.dependent_task_id) != 0) {
+        return -1;
+    }
+
+    ctx->dependency.created_utc = (cf_timestamp_t)strtoll(PQgetvalue(res, row, 3), NULL, 10);
+    ctx->found = 1;
+    return 0;
+}
+
+static int cf_dependency_delete_marker(int row, PGresult *res, void *user_data)
+{
+    (void)row;
+    (void)res;
+
+    int *deleted = user_data;
+    *deleted = 1;
+    return 0;
+}
+
+cf_error_t create_task_dependency(const cf_task_dependency_t *in_dependency,
+                                  cf_task_dependency_t *out_created)
+{
+    return cf_repository_create_task_dependency(NULL, in_dependency, out_created);
+}
