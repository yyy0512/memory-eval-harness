+cf_error_t get_blocking_tasks_for_task(const cf_uuid_t *task_id,
+                                       cf_cursor_t **out_cursor)
+{
+    return cf_repository_get_blocking_tasks_for_task(NULL, task_id, out_cursor);
+}
+
+cf_error_t delete_dependency(const cf_uuid_t *dependency_id)
+{
+    return cf_repository_delete_dependency(NULL, dependency_id);
+}
