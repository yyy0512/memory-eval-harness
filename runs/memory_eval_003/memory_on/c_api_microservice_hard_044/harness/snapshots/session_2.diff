+/*--------------------------------------------------------------------
+ * UUID conversion helpers
+ *------------------------------------------------------------------*/
+static void cf_uuid_to_db_string(const cf_uuid_t *uuid, char out[37])
+{
+    static const char hex[] = "0123456789abcdef";
+    size_t j = 0;
+
+    for (size_t i = 0; i < sizeof uuid->bytes; ++i) {
+        if (i == 4 || i == 6 || i == 8 || i == 10) {
+            out[j++] = '-';
+        }
+        out[j++] = hex[(uuid->bytes[i] >> 4) & 0x0f];
+        out[j++] = hex[uuid->bytes[i] & 0x0f];
+    }
+    out[j] = '\0';
+}
+
+static int cf_uuid_from_db_string(const char *str, cf_uuid_t *out_uuid)
+{
+    if (!str || !out_uuid) return -1;
+
+    size_t byte_idx = 0;
+    int high_nibble = -1;
+    memset(out_uuid, 0, sizeof *out_uuid);
+
+    for (const char *p = str; *p; ++p) {
+        if (*p == '-') continue;
+
+        int value;
+        if (*p >= '0' && *p <= '9') value = *p - '0';
+        else if (*p >= 'a' && *p <= 'f') value = *p - 'a' + 10;
+        else if (*p >= 'A' && *p <= 'F') value = *p - 'A' + 10;
+        else return -1;
+
+        if (high_nibble < 0) {
+            high_nibble = value;
+        } else {
+            if (byte_idx >= sizeof out_uuid->bytes) return -1;
+            out_uuid->bytes[byte_idx++] = (uint8_t)((high_nibble << 4) | value);
+            high_nibble = -1;
+        }
+    }
+
+    return (byte_idx == sizeof out_uuid->bytes && high_nibble < 0) ? 0 : -1;
+}
