+/* Gateway configuration parser                                               */
 /* ------------------------------------------------------------------------- */
 
+static char *
+trim(char *value)
+{
+    while (isspace((unsigned char)*value)) {
+        value++;
+    }
+
+    char *end = value + strlen(value);
+    while (end > value && isspace((unsigned char)end[-1])) {
+        *--end = '\0';
+    }
+
+    return value;
+}
+
+static bool
+parse_bool(const char *value, bool *out)
+{
+    if (strcmp(value, "true") == 0 || strcmp(value, "1") == 0) {
+        *out = true;
+        return true;
+    }
+    if (strcmp(value, "false") == 0 || strcmp(value, "0") == 0) {
+        *out = false;
+        return true;
+    }
+
+    return false;
+}
+
+static bool
+parse_uint(const char *value, unsigned int *out)
+{
+    char *end = NULL;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (end == value || *trim(end) != '\0' || parsed == 0 || parsed > UINT_MAX) {
+        return false;
+    }
+
+    *out = (unsigned int)parsed;
+    return true;
+}
+
+static bool
+parse_rate_limit_pair(const char *value,
+                      unsigned int *requests,
+                      unsigned int *window_seconds)
+{
+    char copy[64];
+    if (strlen(value) >= sizeof(copy)) {
+        return false;
+    }
+
+    strcpy(copy, value);
+    char *colon = strchr(copy, ':');
+    if (!colon) {
+        return false;
+    }
+
+    *colon = '\0';
+    return parse_uint(trim(copy), requests) &&
+           parse_uint(trim(colon + 1), window_seconds);
+}
+
+static void
+add_version_rate_limit(gateway_runtime_config_t *cfg,
+                       const char *version,
+                       unsigned int requests,
+                       unsigned int window_seconds)
+{
+    if (!version || !*version || cfg->version_limit_count >= MAX_VERSION_RATE_LIMITS) {
+        return;
+    }
+
+    version_rate_limit_config_t *limit = &cfg->version_limits[cfg->version_limit_count++];
+    snprintf(limit->version, sizeof(limit->version), "%s", version);
+    limit->requests = requests;
+    limit->window_seconds = window_seconds;
+}
+
+static gateway_runtime_config_t
+load_gateway_config(const char *path)
+{
+    gateway_runtime_config_t cfg = {
+        .rate_limit_enabled = true,
+        .rate_limit_requests = 100,
+        .rate_limit_window_seconds = 60,
+    };
+
+    FILE *file = fopen(path, "r");
+    if (!file) {
+        LOG_WARN("config/gateway.conf not found; using default rate limit settings");
+        return cfg;
+    }
+
+    char line[256];
+    while (fgets(line, sizeof(line), file)) {
+        char *comment = strchr(line, '#');
+        if (comment) {
+            *comment = '\0';
+        }
+
+        char *key = trim(line);
+        if (*key == '\0') {
+            continue;
+        }
+
+        char *eq = strchr(key, '=');
+        if (!eq) {
+            continue;
+        }
+
+        *eq = '\0';
+        char *value = trim(eq + 1);
+        key = trim(key);
+
+        size_t value_len = strlen(value);
+        if (value_len > 0 && value[value_len - 1] == ';') {
+            value[value_len - 1] = '\0';
+            value = trim(value);
+        }
+
+        char *last_key_token = strrchr(key, ' ');
+        if (last_key_token) {
+            key = trim(last_key_token + 1);
+        }
+        if (*key == '*') {
+            key++;
+        }
+
+        if (value[0] == '"') {
+            value++;
+            char *quote_end = strrchr(value, '"');
+            if (quote_end) {
+                *quote_end = '\0';
+            }
+        }
+
+        if (strcmp(key, "rate_limit_enabled") == 0) {
+            bool parsed;
+            if (parse_bool(value, &parsed)) {
+                cfg.rate_limit_enabled = parsed;
+            }
+        } else if (strcmp(key, "rate_limit_requests") == 0) {
+            unsigned int parsed;
+            if (parse_uint(value, &parsed)) {
+                cfg.rate_limit_requests = parsed;
+            }
+        } else if (strcmp(key, "rate_limit_window_seconds") == 0) {
+            unsigned int parsed;
+            if (parse_uint(value, &parsed)) {
+                cfg.rate_limit_window_seconds = parsed;
+            }
+        } else if (strncmp(key, "rate_limit_", strlen("rate_limit_")) == 0) {
+            unsigned int requests;
+            unsigned int window_seconds;
+            const char *api_version = key + strlen("rate_limit_");
+            if (parse_rate_limit_pair(value, &requests, &window_seconds)) {
+                add_version_rate_limit(&cfg, api_version, requests, window_seconds);
+            }
+        }
+    }
+
+    fclose(file);
+    return cfg;
+}
