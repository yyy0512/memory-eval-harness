+static const char *
+client_ip_from_connection(struct MHD_Connection *conn,
+                          char *buf, size_t buf_len)
+{
+    const union MHD_ConnectionInfo *info =
+        MHD_get_connection_info(conn, MHD_CONNECTION_INFO_CLIENT_ADDRESS);
+    if (!info || !info->client_addr)
+        return "unknown";
+
+    const struct sockaddr *addr = info->client_addr;
+    const void *src = NULL;
+
+    if (addr->sa_family == AF_INET) {
+        src = &((const struct sockaddr_in *)addr)->sin_addr;
+    } else if (addr->sa_family == AF_INET6) {
+        src = &((const struct sockaddr_in6 *)addr)->sin6_addr;
+    }
+
+    if (!src || !inet_ntop(addr->sa_family, src, buf, buf_len))
+        return "unknown";
+
+    return buf;
+}
+
+static int
+rate_limit_connection(struct MHD_Connection *conn)
+{
+    char client_ip[INET6_ADDRSTRLEN];
+    const char *ip = client_ip_from_connection(conn, client_ip, sizeof(client_ip));
+
+    if (rate_limiter_allow(ip))
+        return MHD_YES;
+
+    atomic_fetch_add_explicit(&g_total_requests, 1, memory_order_relaxed);
+    atomic_fetch_add_explicit(&g_failed_requests, 1, memory_order_relaxed);
+    return respond(conn, MHD_HTTP_TOO_MANY_REQUESTS, JSON_CONTENT_TYPE,
+                   "{ \"error\": \"Rate limit exceeded\" }");
+}
