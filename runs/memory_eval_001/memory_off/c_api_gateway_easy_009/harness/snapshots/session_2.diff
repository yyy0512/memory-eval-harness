+static void log_line(const char *level, const char *msg);
+
+typedef struct {
+    bool rate_limit_enabled;
+    unsigned int rate_limit_requests;
+    unsigned int rate_limit_window_seconds;
+} runtime_config_t;
+
+static char *
+trim_whitespace(char *s)
+{
+    while (isspace((unsigned char)*s))
+        s++;
+
+    if (*s == '\0')
+        return s;
+
+    char *end = s + strlen(s) - 1;
+    while (end > s && isspace((unsigned char)*end)) {
+        *end = '\0';
+        end--;
+    }
+
+    return s;
+}
+
+static bool
+parse_bool_value(const char *value, bool *out)
+{
+    if (strcasecmp(value, "true") == 0 || strcmp(value, "1") == 0) {
+        *out = true;
+        return true;
+    }
+
+    if (strcasecmp(value, "false") == 0 || strcmp(value, "0") == 0) {
+        *out = false;
+        return true;
+    }
+
+    return false;
+}
+
+static bool
+parse_uint_value(const char *value, unsigned int *out)
+{
+    char *end = NULL;
+    errno = 0;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (errno != 0 || end == value)
+        return false;
+
+    end = trim_whitespace(end);
+    if (*end != '\0' || parsed > UINT_MAX)
+        return false;
+
+    *out = (unsigned int)parsed;
+    return true;
+}
+
+static runtime_config_t
+load_runtime_config(const char *path)
+{
+    runtime_config_t cfg = {
+        .rate_limit_enabled = DEFAULT_RATE_LIMIT_ENABLED,
+        .rate_limit_requests = DEFAULT_RATE_LIMIT_REQUESTS,
+        .rate_limit_window_seconds = DEFAULT_RATE_LIMIT_WINDOW_SECONDS,
+    };
+
+    FILE *fp = fopen(path, "r");
+    if (!fp) {
+        log_line("WARN", "Could not open config/gateway.conf; using default rate limit settings");
+        return cfg;
+    }
+
+    char line[512];
+    while (fgets(line, sizeof(line), fp)) {
+        char *comment = strchr(line, '#');
+        if (comment)
+            *comment = '\0';
+
+        char *key = trim_whitespace(line);
+        if (*key == '\0' || *key == '/' || *key == '*' || *key == '.')
+            continue;
+
+        char *equals = strchr(key, '=');
+        if (!equals)
+            continue;
+
+        *equals = '\0';
+        char *value = trim_whitespace(equals + 1);
+        key = trim_whitespace(key);
+
+        size_t value_len = strlen(value);
+        if (value_len > 0 && value[value_len - 1] == ';') {
+            value[value_len - 1] = '\0';
+            value = trim_whitespace(value);
+        }
+
+        if (strcmp(key, "rate_limit_enabled") == 0) {
+            bool enabled;
+            if (parse_bool_value(value, &enabled))
+                cfg.rate_limit_enabled = enabled;
+            else
+                log_line("WARN", "Ignoring invalid rate_limit_enabled value");
+        } else if (strcmp(key, "rate_limit_requests") == 0) {
+            unsigned int requests;
+            if (parse_uint_value(value, &requests))
+                cfg.rate_limit_requests = requests;
+            else
+                log_line("WARN", "Ignoring invalid rate_limit_requests value");
+        } else if (strcmp(key, "rate_limit_window_seconds") == 0) {
+            unsigned int window_seconds;
+            if (parse_uint_value(value, &window_seconds))
+                cfg.rate_limit_window_seconds = window_seconds;
+            else
+                log_line("WARN", "Ignoring invalid rate_limit_window_seconds value");
+        }
+    }
+
+    fclose(fp);
+    return cfg;
+}
 
