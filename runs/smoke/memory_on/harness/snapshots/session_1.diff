+get_client_ip(struct MHD_Connection *conn, char *buf, size_t buf_len)
+{
+    const union MHD_ConnectionInfo *info =
+        MHD_get_connection_info(conn, MHD_CONNECTION_INFO_CLIENT_ADDRESS);
+
+    if (!info || !info->client_addr || buf_len == 0)
+        return "unknown";
+
+    const void *addr = NULL;
+    if (info->client_addr->sa_family == AF_INET) {
+        addr = &((const struct sockaddr_in *)info->client_addr)->sin_addr;
+    } else if (info->client_addr->sa_family == AF_INET6) {
+        addr = &((const struct sockaddr_in6 *)info->client_addr)->sin6_addr;
+    }
+
+    if (!addr || !inet_ntop(info->client_addr->sa_family, addr, buf, buf_len))
+        return "unknown";
+
+    return buf;
+}
