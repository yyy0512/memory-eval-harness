{
  "name": "@paypalsphere/risk-service",
  "version": "1.2.0",
  "description": "Risk Assessment & Fraud Screening microservice for the PayPalsphere fintech ecosystem.",
  "license": "Apache-2.0",
  "author": "PayPalsphere Engineering",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "fintech",
    "payments",
    "risk",
    "fraud-detection",
    "cqrs",
    "event-sourcing",
    "microservices"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paypalsphere/paypalsphere.git",
    "directory": "services/risk-service"
  },
  "engines": {
    "node": ">=18.14 <20"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r dotenv/config dist/index.js",
    "dev": "nodemon --config nodemon.json",
    "lint": "eslint \"src/**/*.{ts,js}\" --quiet",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "test": "jest --coverage",
    "security:audit": "npm audit --production",
    "security:check": "snyk test",
    "docker:build": "docker build -t paypalsphere/risk-service:latest .",
    "deploy": "sls deploy --stage $NODE_ENV",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^2.2.2",
    "ajv": "^8.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "helmet": "^6.0.2",
    "joi": "^17.9.2",
    "kafkajs": "^2.4.1",
    "lodash": "^4.17.21",
    "opentelemetry-api": "^1.3.0",
    "opentelemetry-sdk-node": "^0.39.1",
    "pino": "^8.15.0",
    "pino-pretty": "^10.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@shelf/jest-mongodb": "^3.6.6",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.5.6",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-security-node": "^1.0.20",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "serverless": "^3.34.1",
    "snyk": "^1.1229.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "src/**/*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "sideEffects": false,
  "config": {
    "serviceName": "risk-service"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  }
}