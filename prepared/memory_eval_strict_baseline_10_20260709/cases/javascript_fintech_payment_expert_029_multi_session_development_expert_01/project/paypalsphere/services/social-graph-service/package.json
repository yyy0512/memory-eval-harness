{
  "name": "@paypalsphere/social-graph-service",
  "version": "1.0.0",
  "description": "Social Graph microservice that powers circles, friendships, and payment timeline visibility for the PayPalsphere fintech ecosystem. Handles graph persistence, real-time event propagation and CQRS read projections.",
  "license": "MIT",
  "author": "PayPalsphere Engineering <engineering@paypalsphere.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/paypalsphere/social-graph-service.git"
  },
  "keywords": [
    "fintech",
    "payments",
    "social-graph",
    "microservice",
    "cqrs",
    "event-sourcing",
    "neo4j",
    "kafka"
  ],
  "homepage": "https://github.com/paypalsphere/social-graph-service#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist coverage .turbo",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "npm run test -- --watch",
    "test:ci": "cross-env CI=true npm run test -- --coverage",
    "prepare": "husky install",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^3.0.1",
    "ajv": "^8.12.0",
    "apollo-server-express": "^3.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "graphql": "^16.7.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.10.0",
    "kafkajs": "^2.5.0",
    "neo4j-driver": "^5.10.0",
    "pino": "^8.15.0",
    "pino-http": "^9.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.3",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.17",
    "@types/helmet": "^7.0.2",
    "@types/hpp": "^0.2.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.5.6",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "prisma": "^5.1.1",
    "rimraf": "^5.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,json",
    "exec": "ts-node-dev --respawn --transpileOnly src/index.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all",
    "bracketSpacing": true
  },
  "config": {
    "serviceName": "social-graph-service",
    "debug": false
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false
}