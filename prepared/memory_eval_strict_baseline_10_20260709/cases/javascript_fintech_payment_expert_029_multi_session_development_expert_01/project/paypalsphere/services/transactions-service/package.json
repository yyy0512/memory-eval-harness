{
  "name": "@paypalsphere/transactions-service",
  "version": "1.3.0",
  "description": "Handles payment transaction commands, queries and event emission within the PayPalsphere ecosystem (CQRS + Event-Sourcing).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./schemas/*": "./dist/schemas/*.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "fintech",
    "payments",
    "cqrs",
    "event-sourcing",
    "microservice",
    "transactions"
  ],
  "homepage": "https://github.com/paypalsphere/paypalsphere/tree/main/services/transactions-service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paypalsphere/paypalsphere.git",
    "directory": "services/transactions-service"
  },
  "author": "PayPalsphere Engineering",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json",
    "start": "node --env-file .env.production dist/index.js",
    "dev": "tsx watch --env-file .env.development src/index.ts",
    "lint": "eslint --fix --ext .ts,.js src",
    "test": "cross-env NODE_ENV=test TZ=UTC jest --runInBand --detectOpenHandles --coverage",
    "test:watch": "npm run test -- --watch",
    "docs": "typedoc --out docs src",
    "prepare": "husky install",
    "postinstall": "node ./scripts/postinstall.js"
  },
  "dependencies": {
    "@eventstore/db-client": "^1.7.0",
    "@fastify/helmet": "^9.0.2",
    "@fastify/rate-limit": "^8.5.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^2.31.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.23.2",
    "fastify-autoload": "^5.9.0",
    "fastify-plugin": "^4.5.0",
    "fastify-swagger": "^8.7.0",
    "joi": "^17.10.1",
    "jsonwebtoken": "^9.0.0",
    "node-kafka-rest": "^1.2.0",
    "pino": "^8.17.0",
    "reflect-metadata": "^0.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.8.2",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.1",
    "typedoc": "^0.25.6",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "@paypalsphere/kyc-service-client": "^2.1.0",
    "@paypalsphere/risk-engine-client": "^2.2.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "package.json": [
      "prettier --write"
    ]
  },
  "config": {
    "serviceName": "transactions-service",
    "defaultCurrency": "USD"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/index.ts",
      "!src/**/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "import"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "prettier"
    ],
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "error"
          ]
        }
      ],
      "import/order": [
        "error",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index",
            "object",
            "type"
          ],
          "newlines-between": "always"
        }
      ]
    }
  }
}