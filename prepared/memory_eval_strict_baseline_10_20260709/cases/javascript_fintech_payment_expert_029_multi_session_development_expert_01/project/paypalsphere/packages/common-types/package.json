{
  "name": "@paypalsphere/common-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types, utility types, and validation schemas consumed across all PayPalsphere micro-frontends and micro-services.",
  "keywords": [
    "paypalsphere",
    "fintech",
    "types",
    "typescript",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "author": "PayPalsphere Engineering <engineering@paypalsphere.com>",
  "private": false,
  "homepage": "https://github.com/paypalsphere/fintech_payment/tree/main/packages/common-types#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/paypalsphere/fintech_payment.git",
    "directory": "packages/common-types"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16.14",
    "npm": ">=8.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c rollup.config.mjs",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "test": "jest --coverage",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "peerDependencies": {
    "typescript": ">=4.9"
  },
  "dependencies": {
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.2",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.26.3",
    "rollup-plugin-dts": "^5.3.0",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}