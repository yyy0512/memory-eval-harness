{
  "name": "@paypalsphere/api-gateway",
  "version": "1.2.0",
  "description": "Edge gateway for PayPalsphere; provides request validation, authZ/authN, rate-limiting, routing, observability, and OpenAPI-driven contract enforcement for all bounded-context services.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/paypalsphere/infra/api-gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/paypalsphere/infra.git",
    "directory": "api-gateway"
  },
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage .tsbuildinfo",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests --runInBand",
    "test:watch": "npm run test -- --watch",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky install",
    "commit": "cz",
    "swagger:gen": "node scripts/generate-openapi.js",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "config": {
    "serviceName": "api-gateway",
    "port": 8080
  },
  "dependencies": {
    "@sentry/node": "^7.64.0",
    "@sentry/tracing": "^7.64.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.6.5",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-jwt": "^7.7.8",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "http-proxy-middleware": "^2.0.6",
    "jwks-rsa": "^3.0.1",
    "luxon": "^3.4.1",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "pino": "^8.15.0",
    "pino-pretty": "^10.2.0",
    "swagger-ui-express": "^5.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/express": "^4.17.21",
    "@types/express-jwt": "^6.0.1",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.4",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.7.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/index.ts",
      "!src/**/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "import"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "prettier"
    ],
    "env": {
      "node": true,
      "jest": true,
      "es2022": true
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "import/order": [
        "error",
        {
          "alphabetize": {
            "order": "asc",
            "caseInsensitive": true
          },
          "newlines-between": "always"
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "semi": true,
    "tabWidth": 2,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --cache --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}