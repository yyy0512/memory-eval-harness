{
  "name": "@socialpulse/api-gateway",
  "version": "1.0.0",
  "description": "SocialPulse Gateway — a TypeScript-powered API gateway that aggregates social interactions (posts, reactions, live chats, stories) across a constellation of micro-services. Exposes REST & GraphQL endpoints with strict clean-architecture boundaries, advanced rate-limiting, caching, structured logging, and auto-generated API documentation.",
  "license": "Apache-2.0",
  "author": "SocialPulse Engineering <engineering@socialpulse.io>",
  "homepage": "https://github.com/SocialPulse/api-gateway#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SocialPulse/api-gateway.git"
  },
  "keywords": [
    "api-gateway",
    "graphql",
    "rest",
    "nestjs",
    "typescript",
    "microservices",
    "social-media",
    "clean-architecture"
  ],
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "engines": {
    "node": ">=18.16",
    "npm": ">=9.5"
  },
  "sideEffects": false,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build --config tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:debug": "cross-env NODE_ENV=debug nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" -c .eslintrc.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.e2e.json",
    "docs:openapi": "nest build && node dist/scripts/generate-openapi.js",
    "docs:graphql": "graphql-codegen --config codegen.yml",
    "prepare": "husky install",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/prompt"
    }
  },
  "dependencies": {
    "@apollo/gateway": "^2.11.3",
    "@apollo/server": "^4.9.3",
    "@graphql-tools/schema": "^10.0.0",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.2.4",
    "@nestjs/throttler": "^3.2.0",
    "@nestjs/versioning": "^2.1.0",
    "apollo-server-express": "^3.12.0",
    "cache-manager": "^5.2.4",
    "cache-manager-redis-store": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^3.2.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jwks-rsa": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "pino": "^8.15.0",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@graphql-codegen/cli": "^3.1.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.3.0",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.5.9",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "nest-typed-config": "^2.3.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}