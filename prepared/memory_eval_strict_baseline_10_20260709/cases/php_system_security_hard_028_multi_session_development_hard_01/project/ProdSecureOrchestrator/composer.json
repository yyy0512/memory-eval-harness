{
    "name": "prodsecure/system-security-orchestrator",
    "description": "ProdSecure Orchestrator is an enterprise-grade, PHP-based system-security productivity suite designed around the MVVM pattern to streamline DevSecOps workflows.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/prodsecure/orchestrator",
    "keywords": [
        "devsecops",
        "security",
        "orchestrator",
        "mvvm",
        "service-mesh",
        "observer-pattern",
        "chain-of-responsibility",
        "command-pattern",
        "strategy-pattern"
    ],
    "authors": [
        {
            "name": "ProdSecure Engineering",
            "email": "engineering@prodsecure.io",
            "homepage": "https://prodsecure.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.3",
        "symfony/console": "^6.3",
        "symfony/event-dispatcher": "^6.3",
        "symfony/messenger": "^6.3",
        "symfony/serializer": "^6.3",
        "symfony/cache": "^6.3",
        "symfony/yaml": "^6.3",
        "guzzlehttp/guzzle": "^7.8",
        "ramsey/uuid": "^4.7",
        "doctrine/dbal": "^3.7",
        "league/flysystem": "^3.17",
        "league/flysystem-aws-s3-v3": "^3.18",
        "spatie/async": "^1.6",
        "brick/math": "^0.11",
        "symfony/panther": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.31"
    },
    "autoload": {
        "psr-4": {
            "ProdSecure\\": "src/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ],
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProdSecure\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php vendor/bin/php-cs-fixer fix --allow-risky=yes --diff"
        ],
        "post-update-cmd": [
            "@php vendor/bin/php-cs-fixer fix --allow-risky=yes --diff"
        ],
        "test": [
            "@phpunit"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "security-check": [
            "@php -r \"echo 'Running security advisories...' . PHP_EOL;\"",
            "symfony check:security"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.18"
        },
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "monolog": {
            "handler": "monolog\\handler\\StreamHandler",
            "level": "DEBUG"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}