# -----------------------------------------------------------------------------
# ProdSecure Orchestrator - Example Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values with real ones
# that match your infrastructure. DO NOT commit the resulting ".env" file
# to source-control.                                                         
# -----------------------------------------------------------------------------

###############################################################################
# Core Application Settings
###############################################################################
APP_NAME="ProdSecure Orchestrator"
APP_ENV=production                # (production|staging|testing|local)
APP_DEBUG=false                   # (true|false)
APP_URL=https://prodsecure.local   # Base URL of the orchestrator UI

# 32-character random string; generate via: `php -r "echo base64_encode(random_bytes(32));"` 
APP_KEY=base64:base64EncodedRandomStringGoesHere== 

LOG_CHANNEL=stack
LOG_LEVEL=info                    # (debug|info|notice|warning|error|critical|alert|emergency)
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

###############################################################################
# Database
###############################################################################
DB_CONNECTION=pgsql               # (pgsql|mysql|sqlsrv)
DB_HOST=db.host.internal
DB_PORT=5432
DB_DATABASE=prodsecure
DB_USERNAME=prodsecure_user
DB_PASSWORD=secret

###############################################################################
# Caching / Queue / Session Storage
###############################################################################
CACHE_DRIVER=redis                # (redis|memcached|file|array)
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis.host.internal
REDIS_PASSWORD=null               # Set to null if no password
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_SESSION=2

###############################################################################
# Service Mesh / Discovery
###############################################################################
SERVICE_MESH_DISCOVERY_URL=https://consul.mesh.internal:8500
SERVICE_MESH_NAMESPACE=prodsecure
ORCHESTRATOR_NODE_ID=orchestrator-01
ORCHESTRATOR_CLUSTER_TOKEN=changemeClusterToken

###############################################################################
# External Micro-Services
###############################################################################
ALERTING_SERVICE_URL=https://alertmanager.internal/api
METRICS_SERVICE_URL=https://prometheus.internal/api
BACKUP_SERVICE_ENDPOINT=https://backup.api.internal/v1
DEPLOYMENT_API_BASE=https://deployment.engine.internal/v2
LOAD_BALANCER_TOKEN=CHANGEME_LOAD_BALANCER_API_TOKEN

SECURITY_SCAN_ENGINE_URL=https://clair.scanner.internal
SECURITY_SCAN_ENGINE_TOKEN=CHANGEME_CLAIR_JWT

# Real-time log aggregation (e.g. Loki)
LOG_AGGREGATOR_URL=https://loki.internal
LOG_AGGREGATOR_TOKEN=CHANGEME_LOKI_TOKEN

###############################################################################
# Authentication / Authorization
###############################################################################
AUTH_DRIVER=jwt                   # (jwt|oauth)
AUTH_JWT_SECRET=base64EncodedJwtSecretHere==
OAUTH_CLIENT_ID=changeme-oauth-client-id
OAUTH_CLIENT_SECRET=changeme-oauth-client-secret
OAUTH_REDIRECT_URI=${APP_URL}/oauth/callback

###############################################################################
# Notification & Messaging Channels
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.internal
MAIL_PORT=587
MAIL_USERNAME=alerts@prodsecure.local
MAIL_PASSWORD=changeMeEmailPwd
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alerts@prodsecure.local
MAIL_FROM_NAME="ProdSecure Notifier"

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
MS_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/abcd1234

###############################################################################
# TLS / Certificates
###############################################################################
TLS_CERT_PATH=/etc/ssl/certs/prodsecure.crt
TLS_KEY_PATH=/etc/ssl/private/prodsecure.key

###############################################################################
# Scheduler / Cron
###############################################################################
# Custom CRON_EXPRESSION if the built-in scheduler is used
CRON_EXPRESSION=*/1 * * * *       # Every minute

###############################################################################
# Feature Flags
###############################################################################
FEATURE_ALERTING_ENABLED=true
FEATURE_BACKUP_ENABLED=true
FEATURE_LOAD_BALANCING_ENABLED=true
FEATURE_SMART_SCHEDULING=true
FEATURE_CONTEXT_AWARE_REMEDIATION=true

###############################################################################
# Observability / Tracing
###############################################################################
OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcollector.internal:4317
OTEL_SERVICE_NAME=prodsecure-orchestrator
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.25

###############################################################################
# Backup Storage (S3 Compatible)
###############################################################################
BACKUP_STORAGE_DRIVER=s3
BACKUP_S3_ENDPOINT=https://s3-backup.internal
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=prodsecure-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
BACKUP_S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

###############################################################################
# Misc
###############################################################################
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=60

# When true, the system enters maintenance mode until disabled
MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# End of file
# ---------------------------------------------------------------------------