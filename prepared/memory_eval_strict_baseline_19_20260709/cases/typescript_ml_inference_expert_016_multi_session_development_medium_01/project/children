/**
 * Sleep helper that is aware of cancellation token.
 */
function sleep(ms: number, token: CancellationToken): Promise<void> {
    return new Promise((resolve, reject) => {
        const tid = setTimeout(() => {
            token.onCancel(() => void 0); // detach listener
            resolve();
        }, ms);

        token.onCancel(reason => {
            clearTimeout(tid);
            reject(new Error(`Cancelled during sleep: ${reason}`));
        });
    });
}
