// -- KPI ----------------------------------------------------------------------

export enum KPIType {
  CustomerLifetimeValue = 'CustomerLifetimeValue',
  MonthlyRecurringRevenue = 'MonthlyRecurringRevenue',
  ChurnRiskScore = 'ChurnRiskScore',
  NetPromoterScore = 'NetPromoterScore',
}

export type KPIId = Brand<string, 'KPIId'>;

export interface KPI {
  readonly id: KPIId;
  readonly type: KPIType;
  readonly description: string;
  readonly modelVersionId: ModelVersionId;
  readonly createdAt: ISODateString;
}

export type ISODateString = Brand<string, 'ISODateString'>;

export const ISODateString = {
  now(): ISODateString {
    return new Date().toISOString() as ISODateString;
  },
  validate(value: string): Result<ISODateString, TypeError> {
    const date = new Date(value);
    return !isNaN(date.getTime())
      ? Result.ok(value as ISODateString)
      : Result.err(
          new TypeError(`Invalid ISO-8601 date string: "${value}"`),
        );
  },
};

