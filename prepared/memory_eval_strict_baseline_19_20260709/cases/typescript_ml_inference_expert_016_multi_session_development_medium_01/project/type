import { v4 as uuidV4, validate as uuidValidate } from 'uuid';

// -----------------------------------------------------------------------------
// Section 1. Generic FP Helpers (Result, Option, Either, etc.)
// -----------------------------------------------------------------------------

/**
 * Lightweight, expressive Result implementation à la Rust.
 *   • `Ok`  – success branch wrapping a value
 *   • `Err` – failure branch wrapping a domain-specific error
 */
export type Result<T, E = Error> = Ok<T> | Err<E>;
export interface Ok<T> {
  readonly ok: true;
  readonly val: T;
}
export interface Err<E = Error> {
  readonly ok: false;
  readonly err: E;
}

export const Result = {
  ok<T>(val: T): Ok<T> {
    return { ok: true, val };
  },
  err<E = Error>(err: E): Err<E> {
    return { ok: false, err };
  },
  /**
   * Map over the success branch, leave failure untouched.
   */
  map<T, U, E = Error>(res: Result<T, E>, fn: (v: T) => U): Result<U, E> {
    return res.ok ? Result.ok(fn(res.val)) : res;
  },
  /**
   * Chain Result-producing functions (flatMap).
   */
  andThen<T, U, E = Error>(
    res: Result<T, E>,
    fn: (v: T) => Result<U, E>,
  ): Result<U, E> {
    return res.ok ? fn(res.val) : res;
  },
};

/**
 * Domain-level Option type (similar to Scala’s Option / Haskell’s Maybe).
 */
export type Option<T> = Some<T> | None;
export interface Some<T> {
  readonly _tag: 'Some';
  readonly value: T;
}
export interface None {
  readonly _tag: 'None';
}

export const Option = {
  some<T>(value: T): Option<T> {
    return { _tag: 'Some', value };
  },
  none(): Option<never> {
    return { _tag: 'None' };
  },
  fold<T, U>(opt: Option<T>, onNone: () => U, onSome: (v: T) => U): U {
    return opt._tag === 'Some' ? onSome(opt.value) : onNone();
  },
};

// -----------------------------------------------------------------------------
// Section 2. Type Branding for Nominal Safety (IDs, ISO Dates, Money, etc.)
// -----------------------------------------------------------------------------

/**
 * Use TS branding to give primitive strings a unique nominal type.
 * Prevents accidental mixing of IDs with plain strings.
 */
type Brand<K, T extends string> = K & { readonly __brand: T };

export type UUID = Brand<string, 'UUID'>;

export const UUID = {
  new(): UUID {
    return uuidV4() as UUID;
  },
  fromString(value: string): Result<UUID, TypeError> {
    return uuidValidate(value)
      ? Result.ok(value as UUID)
      : Result.err(new TypeError(`Invalid UUID format: "${value}"`));
  },
};

/**
 * Monetary amount represented in minor units following ISO-4217 (e.g. cents).
 * Always signed; currency is supplied elsewhere (MoneyAmount + CurrencyCode).
 */
export type MoneyAmount = Brand<number, 'MoneyAmount'>;

export const MoneyAmount = {
  of(amount: number): Result<MoneyAmount, RangeError> {
    if (!Number.isFinite(amount)) {
      return Result.err(
        new RangeError(`MoneyAmount expects a finite number, got ${amount}`),
      );
    }
    return Result.ok(amount as MoneyAmount);
  },
};

