export enum ModelStage {
  Experimental = 'Experimental',
  Staging = 'Staging',
  Production = 'Production',
  Archived = 'Archived',
}

export type ModelVersionId = Brand<string, 'ModelVersionId'>;

export interface ModelVersionMetadata {
  readonly id: ModelVersionId;
  readonly modelName: string;
  readonly stage: ModelStage;
  readonly createdAt: ISODateString;
  readonly parameters: Readonly<Record<string, unknown>>;
  readonly metrics: Readonly<Record<string, number>>;
  readonly trainingDatasetRef: DatasetRef;
}

export type DatasetRef = Brand<string, 'DatasetRef'>;

// -- Events (Observer Pattern) ------------------------------------------------

export interface DomainEvent {
  readonly eventId: UUID;
  readonly occurredAt: ISODateString;
  readonly kind: DomainEventKind;
  readonly payload: unknown; // Will be discriminated by handlers
}

export enum DomainEventKind {
  KPIShiftDetected = 'KPIShiftDetected',
  ModelVersionDeployed = 'ModelVersionDeployed',
  FeatureDriftAlert = 'FeatureDriftAlert',
  RetrainingPipelineCompleted = 'RetrainingPipelineCompleted',
  BillingPolicyChanged = 'BillingPolicyChanged',
}

// Event constructors
export const DomainEvents = {
  kpiShiftDetected(kpiId: KPIId, delta: number): DomainEvent {
    return {
      eventId: UUID.new(),
      occurredAt: ISODateString.now(),
      kind: DomainEventKind.KPIShiftDetected,
      payload: { kpiId, delta },
    };
  },

  modelVersionDeployed(
    modelVersionId: ModelVersionId,
    stage: ModelStage,
  ): DomainEvent {
    return {
      eventId: UUID.new(),
      occurredAt: ISODateString.now(),
      kind: DomainEventKind.ModelVersionDeployed,
      payload: { modelVersionId, stage },
    };
  },
};

