{
  "name": "@streampulse-nexus/service-transcoder",
  "version": "2.3.0",
  "description": "Carrier-grade media transcoding microservice for StreamPulse Nexus.",
  "keywords": [
    "streampulse",
    "nexus",
    "transcoder",
    "video",
    "audio",
    "ffmpeg",
    "hls",
    "dash",
    "webrtc"
  ],
  "homepage": "https://github.com/streampulse/streampulse-nexus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streampulse/streampulse-nexus.git",
    "directory": "packages/service-transcoder"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=16.14 <19",
    "npm": ">=8"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json,md,yaml}\"",
    "prepare": "husky install",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@streampulse-nexus/common": "^2.3.0",
    "bullmq": "^2.9.0",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "fluent-ffmpeg": "^2.1.2",
    "ffmpeg-static": "^5.1.0",
    "helmet": "^5.2.3",
    "kafkajs": "^2.2.4",
    "media-stream-library-node": "^5.0.0",
    "node-config": "^3.3.9",
    "pino": "^8.14.1",
    "prom-client": "^14.1.0",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.20",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.2",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "lint-staged": "^13.2.2",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "ffmpeg-static": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}