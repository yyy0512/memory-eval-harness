{
  "name": "@streampulse-nexus/lib-shared",
  "version": "2.3.1",
  "description": "Shared utilities, domain objects, and telemetry abstractions used across StreamPulse Nexus services and front-end dashboards.",
  "keywords": [
    "streampulse",
    "nexus",
    "shared",
    "utilities",
    "telemetry",
    "networking",
    "event-driven",
    "observer-pattern"
  ],
  "author": "StreamPulse Engineering <engineering@streampulse.io>",
  "license": "MIT",
  "homepage": "https://github.com/streampulse/nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streampulse/nexus.git",
    "directory": "packages/lib-shared"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "not dead",
    "maintained node versions"
  ],
  "dependencies": {
    "@streampulse-nexus/proto": "^1.4.0",
    "ajv": "^8.12.0",
    "dayjs": "^1.11.10",
    "eventemitter3": "^5.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^4.0.2",
    "rxjs": "^7.8.1",
    "semver": "^7.5.4",
    "tslib": "^2.6.2",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "peerDependencies": {
    "node-fetch": "^3.0.0 || ^2.6.0"
  },
  "optionalDependencies": {
    "fsevents": "~2.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.5.9",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsdoc": "^46.9.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.0",
    "semantic-release": "^22.0.12",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p ./tsconfig.build.json && npm run build:cjs",
    "build:cjs": "tsc -p ./tsconfig.build.json --module CommonJS --outDir dist --extension cjs --declaration false",
    "dev": "tsc --watch --incremental",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "prepare": "husky install",
    "docs": "typedoc --options ./typedoc.json",
    "release": "semantic-release",
    "postinstall": "node ./scripts/postinstall.js"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/streampulse"
  }
}