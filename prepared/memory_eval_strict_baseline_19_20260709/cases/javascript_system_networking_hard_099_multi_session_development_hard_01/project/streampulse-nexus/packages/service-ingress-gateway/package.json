{
  "name": "@streampulse/service-ingress-gateway",
  "version": "1.3.0",
  "private": true,
  "description": "Ingress Gateway service for StreamPulse Nexus. Terminates public traffic, applies zero-trust guards, and routes media, chat, and telemetry to internal micro-edges.",
  "author": "StreamPulse Engineering <engineering@streampulse.io>",
  "license": "MIT",
  "homepage": "https://github.com/streampulse/streampulse-nexus/tree/main/packages/service-ingress-gateway#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streampulse/streampulse-nexus.git",
    "directory": "packages/service-ingress-gateway"
  },
  "bugs": {
    "url": "https://github.com/streampulse/streampulse-nexus/issues"
  },
  "keywords": [
    "streampulse",
    "nexus",
    "ingress",
    "gateway",
    "edge",
    "networking",
    "streaming",
    "live-events",
    "microservices"
  ],
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.5.0"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "concurrently \"npm run build:watch\" \"npm run serve:watch\"",
    "serve:watch": "nodemon --watch dist --delay 1.5 dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "security:audit": "npm audit --production",
    "security:scan": "snyk test --all-projects",
    "prepare": "husky install",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@streampulse/config": "^2.4.1",
    "@streampulse/shared-logger": "^1.1.0",
    "ajv": "^8.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-jwt": "^7.7.9",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "http-proxy-middleware": "^2.0.6",
    "jwks-rsa": "^3.1.0",
    "morgan": "^1.10.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-jwt": "^6.1.5",
    "@types/jest": "^29.5.3",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.7.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "snyk": "^1.1206.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/*.d.ts"
    ]
  },
  "snyk": true,
  "publishConfig": {
    "access": "public"
  }
}