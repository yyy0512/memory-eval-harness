{
  "name": "@streampulse-nexus/service-media-orchestrator",
  "version": "2.3.0",
  "description": "Orchestrates media, telemetry, and audience interaction packets across StreamPulse Nexus clusters with carrier-grade reliability.",
  "author": "StreamPulse Engineering <engineering@streampulse.io>",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.6.6"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.json nodemon --config nodemon.json src/index.ts",
    "start": "node dist/index.js",
    "start:cluster": "pm2 start ecosystem.config.js --only media-orchestrator",
    "test": "jest --runInBand --ci",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --max-warnings=0",
    "format": "prettier --write \"{src,test}/**/*.{ts,js,md,json}\"",
    "security:scan": "npm audit --audit-level=moderate",
    "health:check": "node scripts/health-check.js",
    "docker:build": "docker build -t streampulse/service-media-orchestrator:latest .",
    "release": "semantic-release"
  },
  "dependencies": {
    "@types/ws": "^8.5.4",
    "ajv": "^8.12.0",
    "amqplib": "^0.10.3",
    "axios": "^1.4.0",
    "chalk": "^5.3.0",
    "cls-hooked": "^4.2.2",
    "dotenv": "^16.3.1",
    "fast-json-stable-stringify": "^2.1.0",
    "helmet": "^7.0.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "opentelemetry-api": "^1.4.1",
    "opentelemetry-sdk-node": "^0.34.0",
    "pino": "^8.14.0",
    "pino-pretty": "^10.2.0",
    "promise-retry": "^2.0.1",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/git": "^10.0.1",
    "@types/amqplib": "^0.10.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.2.5",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-jsdoc": "^46.9.1",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "pm2": "^5.3.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "semantic-release": "^21.1.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "optionalDependencies": {
    "newrelic": "^10.3.2"
  },
  "peerDependencies": {
    "@streampulse-nexus/core-telemetry": "^2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "streampulse",
    "media-orchestrator",
    "realtime",
    "networking",
    "live-streaming",
    "event-driven",
    "observer-pattern",
    "zero-trust",
    "orchestration",
    "esports"
  ]
}