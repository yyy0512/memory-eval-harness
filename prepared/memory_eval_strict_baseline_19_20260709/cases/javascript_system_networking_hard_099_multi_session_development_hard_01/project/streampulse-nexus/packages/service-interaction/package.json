{
  "name": "@streampulse-nexus/service-interaction",
  "version": "1.1.0",
  "description": "Real-time interaction micro-service powering chat, reactions, telemetry fan-outs, and synchronized XR effects for the StreamPulse Nexus platform.",
  "keywords": [
    "streampulse",
    "nexus",
    "interaction",
    "realtime",
    "websocket",
    "event-driven",
    "esports",
    "live-streaming"
  ],
  "homepage": "https://github.com/streampulse/nexus/tree/main/packages/service-interaction#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streampulse/nexus.git",
    "directory": "packages/service-interaction"
  },
  "license": "Apache-2.0",
  "author": "StreamPulse Engineering <engineering@streampulse.ai>",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/streampulse"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.16",
    "npm": ">=9.5"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow npm",
    "prepare": "husky install",
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "nodemon --config ./nodemon.json",
    "start": "node dist/index.js",
    "start:prod": "node --env-file=.env.production dist/index.js",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "coverage": "npm test -- --coverage",
    "type-check": "tsc --noEmit",
    "security": "npm audit --production",
    "release": "semantic-release"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/sdk-node": "^0.40.0",
    "@streampulse-nexus/common": "workspace:^1.0.0",
    "ajv": "^8.12.0",
    "bullmq": "^4.9.2",
    "dotenv": "^16.3.1",
    "redis": "^4.6.7",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "winson": "^3.10.0",
    "ws": "^8.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.7.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.9",
    "@types/ws": "^8.5.6",
    "commitlint": "^17.7.2",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^46.1.1",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "semantic-release": "^22.0.12",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "node": ">=18"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "moduleNameMapper": {
      "^(#.+)$": "<rootDir>/src/$1"
    }
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "import",
      "promise",
      "jsdoc"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "plugin:promise/recommended",
      "plugin:jsdoc/recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es2023": true,
      "jest": true
    },
    "reportUnusedDisableDirectives": true
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,css,scss}": "prettier --write"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}