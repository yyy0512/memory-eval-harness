{
  "name": "@streampulse/nexus",
  "version": "1.0.0",
  "description": "StreamPulse Nexus — component-based networking platform that powers large-scale, interactive entertainment streams with carrier-grade reliability.",
  "license": "Apache-2.0",
  "author": {
    "name": "StreamPulse Engineering",
    "email": "engineering@streampulse.io",
    "url": "https://streampulse.io"
  },
  "homepage": "https://github.com/streampulse/nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streampulse/nexus.git"
  },
  "bugs": {
    "url": "https://github.com/streampulse/nexus/issues"
  },
  "keywords": [
    "streampulse",
    "nexus",
    "networking",
    "media-streaming",
    "realtime",
    "event-driven",
    "observer-pattern",
    "command-pattern",
    "strategy-pattern",
    "chain-of-responsibility",
    "zero-trust",
    "backup-recovery",
    "system-monitoring",
    "security-scanning"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "config",
    "README.md"
  ],
  "engines": {
    "node": ">=18.13.0",
    "npm": ">=9.5.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon --exec ts-node --project tsconfig.json src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --max-warnings 0",
    "format": "prettier --write \"{src,test}/**/*.{ts,js,json,md}\"",
    "prepare": "husky install",
    "commit": "cz",
    "release": "semantic-release",
    "docker:build": "docker build -t streampulse/nexus .",
    "docker:compose": "docker-compose -f ./infra/docker-compose.yml up -d",
    "security:scan": "npm audit --production --audit-level=high",
    "analysis:dep": "depcheck --json",
    "clean": "rimraf dist coverage"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "ajv": "^8.12.0",
    "bcrypt": "^5.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "node-fetch": "^3.3.1",
    "pino": "^8.15.0",
    "pino-pretty": "^10.2.0",
    "prom-client": "^14.2.0",
    "prometheus-gc-stats": "^5.1.0",
    "redis": "^4.6.7",
    "rimraf": "^5.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.13.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.4.1",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "depcheck": "^1.4.3",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "semantic-release": "^22.0.12",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "node": ">=18.13.0"
  },
  "optionalDependencies": {
    "sharp": "^0.32.4" /* Used for optional thumbnail generation */
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2023": true,
      "jest": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "import",
      "promise"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:promise/recommended",
      "prettier"
    ],
    "rules": {
      "import/no-unresolved": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ]
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/streampulse"
  },
  "publishConfig": {
    "access": "public"
  }
}