/**
 * Use case for fetching direct children of a parent entity (e.g., replies
 * of a post). Responsible for validation, caching and orchestration.
 */
export class FetchChildrenUseCase {
  private static readonly CACHE_TTL_SECONDS = 30; // short-lived, volatile

  constructor(
    private readonly repo: ChildrenRepository,
    private readonly cache: CacheProvider,
    private readonly logger: Logger
  ) {}

  /**
   * Execute the use-case: validate, look in cache, fetch from repo if miss,
   * then cache the response.
   */
  async execute(
    rawInput: FetchChildrenRequest
  ): Promise<Paginated<ChildDTO>> {
    // 1. Validate
    const input = await fetchChildrenSchema.validate(rawInput, {
      abortEarly: false,
      stripUnknown: true
    });

    // 2. Generate deterministic cache key
    const cacheKey = FetchChildrenUseCase.buildCacheKey(input);

    // 3. Attempt cache hit
    const cached = await this.cache.get<Paginated<ChildDTO>>(cacheKey);
    if (cached) {
      this.logger.debug({ cacheKey }, 'Cache hit for children');
      return cached;
    }

    // 4. Fetch from repository
    const result = await this.repo.fetchChildren(input);

    // 5. Cache the result (fire-and-forget)
    void this.cache
      .set(cacheKey, result, FetchChildrenUseCase.CACHE_TTL_SECONDS)
      .catch(() => {
        /* handled internally in cache provider */
      });

    return result;
  }

  /**
   * Helper to build a stable cache key based on request params.
   * Excludes viewer-specific fields to avoid cache poisoning.
   */
  private static buildCacheKey(input: FetchChildrenRequest): string {
    const { parentId, cursor = '', limit = 20 } = input;
    const raw = JSON.stringify({ parentId, cursor, limit });

    // A short hash keeps the Redis key friendly and small
    const hash = createHash('md5').update(raw).digest('hex');
    return `children:${hash}`;
  }
}

