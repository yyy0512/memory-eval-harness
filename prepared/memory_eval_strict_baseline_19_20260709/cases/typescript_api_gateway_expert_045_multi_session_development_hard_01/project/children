export function buildFetchChildrenUseCase(
  {
    commentsServiceUrl,
    redis,
    logger
  }: {
    commentsServiceUrl: string;
    redis: Redis;
    logger: Logger;
  }
): FetchChildrenUseCase {
  const repository = new HttpChildrenRepository(commentsServiceUrl, logger);
  const cache = new RedisCacheProvider(redis, logger);

  return new FetchChildrenUseCase(repository, cache, logger);
