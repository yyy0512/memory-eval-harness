/**
 * Remote repository that delegates to the comments microservice
 * via HTTP REST.
 */
export class HttpChildrenRepository implements ChildrenRepository {
  private readonly http: AxiosInstance;

  constructor(baseURL: string, private readonly logger: Logger) {
    this.http = axios.create({
      baseURL,
      timeout: 3_000
    });
  }

  async fetchChildren(
    params: FetchChildrenRequest
  ): Promise<Paginated<ChildDTO>> {
    try {
      const response: AxiosResponse<Paginated<ChildDTO>> =
        await this.http.get('/children', {
          params
        });

      return response.data;
    } catch (err) {
      this.logger.error(
        { err, params },
        'Failed to fetch children from comments-service'
      );
      throw new Error('UNAVAILABLE_CHILDREN_SERVICE');
    }
  }
}

/**
 * Simple Redis cache provider implementation
 */
export class RedisCacheProvider implements CacheProvider {
  private readonly redis: Redis;

  constructor(redis: Redis, private readonly logger: Logger) {
    this.redis = redis;
  }

  async get<T>(key: string): Promise<T | null> {
    try {
      const cached = await this.redis.get(key);
      return cached ? (JSON.parse(cached) as T) : null;
    } catch (err) {
      this.logger.warn({ err, key }, 'Redis GET failed');
      return null;
    }
  }

  async set<T>(key: string, value: T, ttlSeconds: number): Promise<void> {
    try {
      await this.redis.set(key, JSON.stringify(value), 'EX', ttlSeconds);
    } catch (err) {
      this.logger.warn({ err, key }, 'Redis SET failed');
    }
  }

  async del(key: string): Promise<void> {
    try {
      await this.redis.del(key);
    } catch (err) {
      this.logger.warn({ err, key }, 'Redis DEL failed');
    }
  }
}

