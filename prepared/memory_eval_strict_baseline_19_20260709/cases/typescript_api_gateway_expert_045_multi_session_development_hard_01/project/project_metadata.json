    "dependencies": [
      "typescript (>=5.x)",
      "ts-node / esbuild-register (dev, runtime compilation)",
      "express 5 (HTTP transport layer)",
      "apollo-server-express (GraphQL schema & gateway stitching)",
      "graphql-tools & @graphql-codegen/cli (schema generation)",
      "swagger-ui-express & @nestjs/swagger or tsoa (REST docs)",
      "class-validator / class-transformer (request validation)",
      "ajv (JSON Schema validation for dynamic message payloads)",
      "redis & ioredis (response caching, rate-limit buckets)",
      "express-rate-limit & rate-limit-redis (rate limiting)",
      "helmet & cors (security middleware)",
      "passport, passport-jwt, passport-oauth2 (auth strategies)",
