//
// This module is intentionally kept dependency-light so it can be used from
// both the server-side (native) and client-side (WASM) crates. Conditional
// compilation is used to avoid pulling in heavy dependencies on the frontend.
//
#![allow(clippy::module_name_repetitions)]

