// ---------- Strongly-typed domain identifiers ----------

macro_rules! id_newtype {
    ($(#[$outer:meta])* $vis:vis struct $name:ident;) => {
        $(#[$outer])*
        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
        $vis struct $name(Uuid);

        impl $name {
            pub fn new() -> Self {
                Self(Uuid::new_v4())
            }

            pub fn from_uuid(value: Uuid) -> Self {
                Self(value)
            }

            pub fn into_inner(self) -> Uuid {
                self.0
            }
        }

        impl fmt::Display for $name {
            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
                self.0.fmt(f)
            }
        }

        impl From<Uuid> for $name {
            fn from(value: Uuid) -> Self {
                Self(value)
            }
        }

        #[cfg(feature = "backend")]
        impl<'r> sqlx::Decode<'r, sqlx::Postgres> for $name {
            fn decode(
                value: <sqlx::Postgres as sqlx::Database>::ValueRef<'r>,
            ) -> Result<Self, sqlx::error::BoxDynError> {
                <Uuid as sqlx::Decode<sqlx::Postgres>>::decode(value).map(Self)
            }
        }

        #[cfg(feature = "backend")]
        impl sqlx::Type<sqlx::Postgres> for $name {
            fn type_info() -> sqlx::postgres::PgTypeInfo {
                <Uuid as sqlx::Type<sqlx::Postgres>>::type_info()
            }
        }

        #[cfg(feature = "backend")]
        impl<'q> sqlx::Encode<'q, sqlx::Postgres> for $name {
            fn encode_by_ref(
                &self,
                buf: &mut <sqlx::Postgres as sqlx::database::HasArguments<'q>>::ArgumentBuffer,
            ) -> sqlx::encode::IsNull {
                <Uuid as sqlx::Encode<sqlx::Postgres>>::encode(&self.0, buf)
            }

            fn size_hint(&self) -> usize {
                <Uuid as sqlx::Encode<sqlx::Postgres>>::size_hint(&self.0)
            }
        }
    };
}

id_newtype!(
    /// Unique identifier for a user account.
    pub struct UserId;
);
id_newtype!(
    /// Unique identifier for an authenticated session.
    pub struct SessionId;
);
id_newtype!(
    /// Unique identifier for a dashboard component (“color swatch”).
    pub struct ComponentId;
);
id_newtype!(
    /// Unique identifier for an asset (artwork, file, media, etc.).
    pub struct AssetId;
);

// ---------- User & Session types ----------

/// Role-based access control descriptor.
#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
pub enum Role {
    Guest,
    Artist,
    StudioAdmin,
    SuperAdmin,
}

impl Role {
    /// Returns `true` when the current role has at least the privileges of the
    /// provided `required` role.
    ///
    /// The hierarchy from least to most privileged is:
    /// Guest < Artist < StudioAdmin < SuperAdmin.
    pub fn allows(self, required: Role) -> bool {
        matches!(
            (self, required),
            (Role::SuperAdmin, _)
                | (Role::StudioAdmin, Role::StudioAdmin | Role::Artist | Role::Guest)
                | (Role::Artist, Role::Artist | Role::Guest)
                | (Role::Guest, Role::Guest)
        )
    }
}

/// Public information that can be safely disclosed downstream.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PublicUserProfile {
    pub id: UserId,
    pub display_name: String,
    pub avatar_url: Option<String>,
}

/// Internal representation of an authenticated user session.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Session {
    pub id: SessionId,
    pub user_id: UserId,
    pub role: Role,
    pub issued_at: SystemTime,
    /// When the session should be considered invalid.
    pub expires_at: SystemTime,
}

impl Session {
    pub const DEFAULT_TTL: Duration = Duration::from_secs(60 * 60 * 8); // 8h

    /// Creates a new session expiring in [`Session::DEFAULT_TTL`].
    pub fn start(user_id: UserId, role: Role) -> Self {
        let now = SystemTime::now();
        Self {
            id: SessionId::new(),
            user_id,
            role,
            issued_at: now,
            expires_at: now + Self::DEFAULT_TTL,
        }
    }

    /// Returns `true` if the session is expired.
    pub fn is_expired(&self) -> bool {
        SystemTime::now() >= self.expires_at
    }
}

