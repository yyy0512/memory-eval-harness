{
  "name": "@chromaticcanvas/control-center",
  "version": "1.4.0",
  "private": true,
  "description": "ChromaticCanvas Control Center — A component-driven creative dashboard powered by Rust + Yew + Tailwind.",
  "keywords": [
    "rust",
    "wasm",
    "yew",
    "tailwind",
    "dashboard",
    "creative-tools",
    "chromaticcanvas"
  ],
  "homepage": "https://github.com/chromaticcanvas/control-center",
  "repository": {
    "type": "git",
    "url": "https://github.com/chromaticcanvas/control-center.git"
  },
  "license": "MIT",
  "author": "ChromaticCanvas Engineering <engineering@chromaticcanvas.io>",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n wasm,tailwind,server -c \"cyan.bold,magenta.bold,green.bold\" \"npm:dev:wasm\" \"npm:dev:tailwind\" \"npm:dev:server\"",
    "dev:wasm": "wasm-pack build --target web --out-dir ./static/pkg --dev -- --features frontend_interface,ssl_security",
    "dev:tailwind": "TAILWIND_MODE=watch postcss ./static/styles/tailwind.css -o ./static/dist/styles.css --watch",
    "dev:server": "basic-http-server ./static -a 0.0.0.0:8080",
    "build": "npm run clean && npm run build:wasm && npm run build:tailwind && npm run build:bundle",
    "build:wasm": "wasm-pack build --target web --out-dir ./static/pkg --release -- --features frontend_interface,ssl_security,responsive_design",
    "build:tailwind": "postcss ./static/styles/tailwind.css -o ./static/dist/styles.css",
    "build:bundle": "webpack --mode production",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx,json}\" --max-warnings=0",
    "format": "prettier \"**/*.{js,jsx,ts,tsx,json,md,css}\" --write",
    "clean": "rimraf ./static/pkg ./static/dist ./dist",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/line-clamp": "^0.4.3",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.16",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.1",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-typescript": "^7.23.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.7",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "basic-http-server": "^3.0.1",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "wasm-pack": "^0.12.1",
    "wasm-pack-plugin": "^2.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run format -- --check"
    }
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}