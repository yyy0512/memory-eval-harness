{
  "specification": {
    "unique_id": "c_data_streaming_hard_013",
    "name": "PulseSphere: Real-Time Social Pulse Streaming Platform",
    "description": "PulseSphere is a high-throughput, event-driven data-streaming platform written in C that captures, validates, transforms, and disseminates live \"social pulses\" (likes, comments, shares, follows, and reaction emojis) from multiple social networks, community forums, and in-house engagement widgets. Each pulse is modeled as an immutable event and published into a unified event fabric, enabling downstream microservices to continuously compute community sentiment, trending topics, and influence graphs in near real-time.\n\nDesigned around a microservice-oriented Data Lake and Pipeline Pattern, PulseSphere ingests millions of heterogeneous social events per second, performs schema-on-read validation, parallel enrichment (geo-tagging, language detection, toxicity scoring), and streams curated data into analytical sinks for data scientists while simultaneously driving interactive dashboards for moderators. Fault-tolerant batch windows reconcile late and out-of-order events, and Strategy Pattern plug-ins allow rapid experimentation with alternative enrichment, quality-check, and visualization strategies without redeploying the entire system.",
    "domain": "data_streaming",
    "complexity": "hard",
    "language": "c",
    "architecture": "event_driven",
    "theme": "social",
