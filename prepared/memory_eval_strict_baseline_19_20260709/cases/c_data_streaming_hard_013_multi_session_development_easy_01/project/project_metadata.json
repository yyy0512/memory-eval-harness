    ],
    "dependencies": [
      "librdkafka (C client for Apache Kafka) \u2013 Event streaming backbone",
      "libuv \u2013 High-performance event loop & async I/O",
      "Apache Arrow C Library \u2013 In-memory columnar representation for batch and stream interoperability",
      "Flatbuffers or Google Protobuf-C \u2013 Compact, schema-versioned message serialization",
      "jansson \u2013 JSON parsing/validation for schema-on-read",
      "libpq / PostgreSQL \u2013 Metadata & configuration store (Data Lake catalog)",
      "Redis Streams (hiredis) \u2013 Low-latency pub/sub for hot paths (e.g., moderator alert channels)",
      "OpenSSL \u2013 TLS encryption for cross-datacenter event transport",
      "Prometheus C Client & Grafana \u2013 Telemetry, health metrics, and data visualization endpoints",
      "Parquet-C and libhdfs \u2013 Batch off-loads to HDFS-backed Data Lake",
      "OpenMP / Intel TBB \u2013 Parallel processing of transformation stages",
      "cJSON / RapidJSON C wrappers \u2013 Lightweight JSON generation for UI APIs",
      "libarchive \u2013 Compressed batch file handling in cold-storage workflows"
    ],
