{
  "name": "@meditrade/pulse",
  "version": "1.0.0",
  "description": "MediTrade Pulse – a TypeScript-powered trading platform enabling hospital groups and insurers to exchange, hedge, and audit medical-grade commodities in a compliant, risk-aware manner.",
  "private": true,
  "license": "Apache-2.0",
  "author": "MediTrade Engineering <engineering@meditrade.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/meditrade/pulse.git"
  },
  "keywords": [
    "healthcare",
    "fintech",
    "trading",
    "cqrs",
    "event-sourcing",
    "saga-pattern",
    "typescript",
    "meditrade"
  ],
  "engines": {
    "node": ">=18.15.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rimraf dist coverage *.log",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --exit-child --transpile-only src/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky install",
    "commit": "cz",
    "release": "semantic-release"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.2.3",
    "@nestjs/cqrs": "^10.1.0",
    "@nestjs/event-emitter": "^1.0.0",
    "@nestjs/graphql": "^10.1.4",
    "@nestjs/platform-express": "^10.2.3",
    "@nestjs/websockets": "^10.2.3",
    "ajv": "^8.12.0",
    "axios": "^1.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "currency.js": "^2.0.4",
    "crypto-js": "^4.1.1",
    "eventstore-node": "^0.2.2",
    "inversify": "^6.0.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@nestjs/cli": "^10.2.5",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.5.6",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.1",
    "semantic-release": "^21.0.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.4",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(src)/(.*)$": "<rootDir>/src/$2"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts"
    ]
  }
}