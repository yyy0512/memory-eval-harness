      category: 'VACCINE',
      coldChain: true,
      shelfLifeMonths: 9,
      controlledSubstance: false,
    },
    quantity: 10_000,
    unitPrice: 12.5,
    currency: 'USD',
    deliveryDate: new Date(Date.now() + 7 * 864e5).toISOString(), // +7d
    batchExpiryDate: new Date(Date.now() + 25 * 864e5).toISOString(), // +25d
    complianceFlags: new Set<ClinicalComplianceFlag>([
      ClinicalComplianceFlag.TempExcursion,
    ]),
  };

  const result = RiskEngine.assess(order);
  console.assert(
    result.level === RiskLevel.High || result.level === RiskLevel.Critical,
    `Unexpected risk level: ${result.level}`,
  );
}

