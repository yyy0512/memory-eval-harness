package com.circleconnect.nexus.web_social.service;

import com.circleconnect.nexus.web_social.controller.dto.CircleResponseDto;
import com.circleconnect.nexus.web_social.controller.dto.CreateSubCircleRequest;
import com.circleconnect.nexus.web_social.exception.ResourceConflictException;
import com.circleconnect.nexus.web_social.exception.ResourceNotFoundException;
import com.circleconnect.nexus.web_social.repository.CircleRepository;
import jakarta.transaction.Transactional;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.time.Instant;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

/**
 * Encapsulates domain logic for parent-child circle relations.
 * All mutating operations run inside an ACID transaction boundary.
 */
@Service
@RequiredArgsConstructor
public class CircleHierarchyService {

    private final CircleRepository circleRepository;

    public List<CircleResponseDto> findChildren(UUID parentId, String orderBy) {
        if (!circleRepository.existsById(parentId)) {
            throw new ResourceNotFoundException("Parent circle not found: " + parentId);
        }

        return switch (orderBy) {
            case "createdAt" -> circleRepository.findAllChildrenOrderByCreatedAt(parentId);
            case "memberCount" -> circleRepository.findAllChildrenOrderByMemberCount(parentId);
            default -> circleRepository.findAllChildrenOrderByName(parentId);
        }.stream()
         .map(this::mapToDto)
         .collect(Collectors.toList());
    }

    @Transactional
    public CircleResponseDto createChild(UUID parentId, CreateSubCircleRequest req) {
        var parent = circleRepository.findById(parentId)
                .orElseThrow(() -> new ResourceNotFoundException("Parent circle not found: " + parentId));

        if (circleRepository.existsByNameAndParentId(req.name(), parentId)) {
            throw new ResourceConflictException("Child circle with the same name already exists");
        }

        var child = parent.spawnChild(req.name(), req.description(), Instant.now());
        circleRepository.save(child);

        return mapToDto(child);
    }

    @Transactional
    public void detachChild(UUID parentId, UUID childId) {
        var child = circleRepository.findById(childId)
                .orElseThrow(() -> new ResourceNotFoundException("Child circle not found: " + childId));

        if (!child.isChildOf(parentId)) {
            throw new ResourceConflictException("Circle " + childId + " is not a child of " + parentId);
        }

        child.detachFromParent();
        circleRepository.save(child);
    }

    /* Utility */

    private CircleResponseDto mapToDto(com.circleconnect.nexus.core.domain.Circle circle) {
        return new CircleResponseDto(
                circle.getId(),
                circle.getName(),
                circle.getDescription(),
                circle.getMemberCount(),
                circle.getCreatedAt()
        );
    }
}
