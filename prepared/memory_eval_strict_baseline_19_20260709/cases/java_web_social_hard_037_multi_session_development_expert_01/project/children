package com.circleconnect.nexus.web_social.controller;

import com.circleconnect.nexus.web_social.controller.dto.CircleResponseDto;
import com.circleconnect.nexus.web_social.controller.dto.CreateSubCircleRequest;
import com.circleconnect.nexus.web_social.exception.ResourceConflictException;
import com.circleconnect.nexus.web_social.exception.ResourceNotFoundException;
import com.circleconnect.nexus.web_social.service.CircleHierarchyService;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.UUID;

/**
 * REST-style controller that exposes hierarchy-related endpoints underneath the
 * circle resource. A “child” circle is a first-level sub-circle that inherits
 * visibility rules, payment settings, and administrative roles from its parent
 * but can have an independent membership roster.
 *
 * Path structure:
 *     /api/v1/circles/{circleId}/children
 *
 * Responsibilities:
 *  • Delegate intent to {@link CircleHierarchyService}
 *  • Translate domain exceptions to HTTP status codes
 *  • Layer validation and method-level security via annotations
 */
@Slf4j
@Validated
@RequiredArgsConstructor
@RestController
@RequestMapping("/api/v1/circles/{circleId}/children")
public class CircleChildrenController {

    private final CircleHierarchyService hierarchyService;

    /**
     * Returns an ordered list of children belonging to a circle.
     */
    @GetMapping
    @PreAuthorize("hasAuthority('CIRCLE_VIEW')")
    public ResponseEntity<List<CircleResponseDto>> list(
            @PathVariable UUID circleId,
            @RequestParam(defaultValue = "name") String orderBy) {

        log.debug("Fetching children for circle={} orderedBy={}", circleId, orderBy);
        List<CircleResponseDto> children = hierarchyService
                .findChildren(circleId, orderBy);

        return ResponseEntity.ok(children);
    }

    /**
     * Creates a new child circle beneath an existing parent.
     */
    @PostMapping
    @PreAuthorize("hasAuthority('CIRCLE_MANAGE')")
    public ResponseEntity<CircleResponseDto> create(
            @PathVariable UUID circleId,
            @Valid @RequestBody CreateSubCircleRequest request) {

        log.info("Creating child circle under parent={}, name={}", circleId, request.name());
        CircleResponseDto child = hierarchyService.createChild(circleId, request);

        return ResponseEntity.status(HttpStatus.CREATED).body(child);
    }

    /**
     * Deletes the relationship between a parent and a child circle.
     * The child circle itself is NOT deleted. It becomes an independent
     * top-level circle unless otherwise configured.
     */
    @DeleteMapping("/{childId}")
    @PreAuthorize("hasAuthority('CIRCLE_MANAGE')")
    public ResponseEntity<Void> detach(
            @PathVariable UUID circleId,
            @PathVariable UUID childId) {

        log.warn("Detaching child circle={} from parent={}", childId, circleId);
        hierarchyService.detachChild(circleId, childId);

        return ResponseEntity.noContent().build();
    }

    /* ---------------------------------------------------------------------
     * Exception Mappers
     * ------------------------------------------------------------------- */

    @ExceptionHandler(ResourceNotFoundException.class)
    public ResponseEntity<String> onNotFound(ResourceNotFoundException ex) {
        log.debug("Resource not found: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(ex.getMessage());
    }

    @ExceptionHandler(ResourceConflictException.class)
    public ResponseEntity<String> onConflict(ResourceConflictException ex) {
        log.debug("Resource conflict: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.CONFLICT).body(ex.getMessage());
    }

    @ExceptionHandler(IllegalArgumentException.class)
    public ResponseEntity<String> onBadRequest(IllegalArgumentException ex) {
        log.debug("Bad request: {}", ex.getMessage());
        return ResponseEntity.badRequest().body(ex.getMessage());
    }
}
