{
  "name": "circleconnect-nexus-web",
  "version": "1.4.0",
  "private": true,
  "description": "Front-end assets for the CircleConnect Nexus social platform – a community-driven, large-scale social network built on Spring Boot, React, and TypeScript.",
  "author": "CircleConnect Engineering <engineering@circleconnect.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --config ./webpack/webpack.dev.js --hot",
    "start:ssr": "cross-env NODE_ENV=development node server/ssr.js",
    "build": "npm run lint && npm run test && cross-env NODE_ENV=production webpack --config ./webpack/webpack.prod.js",
    "clean": "rimraf dist/*",
    "storybook": "start-storybook -p 6006 -s public",
    "build:storybook": "build-storybook -s public",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prepare": "husky install",
    "postinstall": "npm run generate:types && npm run patch:env",
    "generate:types": "graphql-codegen --config ./codegen.js",
    "patch:env": "node ./scripts/patchEnvironment.js",
    "analyze": "webpack --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting",
    "ci": "npm ci && npm run build"
  },
  "dependencies": {
    "@stripe/stripe-js": "^2.3.0",
    "axios": "^1.6.2",
    "classnames": "^2.3.2",
    "date-fns": "^2.31.1",
    "formik": "^2.4.2",
    "lodash": "^4.17.21",
    "notistack": "^2.0.8",
    "qs": "^6.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.15.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "socket.io-client": "^4.7.2",
    "styled-components": "^5.3.11",
    "uuid": "^9.0.0",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.2",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@storybook/addon-actions": "^7.6.15",
    "@storybook/addon-essentials": "^7.6.15",
    "@storybook/addon-links": "^7.6.15",
    "@storybook/react": "^7.6.15",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.5",
    "@types/lodash": "^4.14.198",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.27",
    "@types/react-dom": "^18.2.11",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "babel-jest": "^29.6.4",
    "babel-loader": "^9.1.4",
    "babel-plugin-styled-components": "^2.1.6",
    "commitlint-format-json": "^2.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "firebase-tools": "^12.5.9",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^8.3.1",
    "prettier": "^3.0.3",
    "react-refresh": "^0.14.0",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "sass-loader": "^14.2.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}