# ==============================================================================
# VitalOps Orchestrator – Environment Configuration Example
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the project root and provide real values where
# indicated.  NEVER commit `.env` (with secrets) to version control.
# ==============================================================================

# ----------------------------------------------------------------------
# Application Runtime
# ----------------------------------------------------------------------
APP_ENV=local                       # one of: local | staging | production
APP_DEBUG=true                      # set to "false" in production
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=CHANGE_ME                # 32+ random chars, used for session crypto

# ----------------------------------------------------------------------
# Service Discovery / Mesh Side-Car
# ----------------------------------------------------------------------
SIDECAR_GRPC_PORT=9900
SIDECAR_HEALTH_PORT=9901
SERVICE_MESH_NAMESPACE=vitalops-mesh

# ----------------------------------------------------------------------
# PostgreSQL – Primary Metadata Store
# ----------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vitalops
POSTGRES_USER=vitalops_rw
POSTGRES_PASSWORD=CHANGE_ME

# Connection pool tuning
POSTGRES_POOL_MIN_CONN=1
POSTGRES_POOL_MAX_CONN=20
POSTGRES_POOL_TIMEOUT_SEC=30

# ----------------------------------------------------------------------
# Redis – Fast KV Cache + Pub/Sub
# ----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                # leave blank if unauthenticated

# ----------------------------------------------------------------------
# RabbitMQ – Event Bus
# ----------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vitalops_bus
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/vitalops

# High-availability tuning
RABBITMQ_HEARTBEAT=30
RABBITMQ_PREFETCH_COUNT=200

# ----------------------------------------------------------------------
# Kubernetes Access
# ----------------------------------------------------------------------
KUBE_CONFIG_PATH=~/.kube/config
KUBE_NAMESPACE=vitalops-system
KUBE_CONTEXT=                     # leave blank to use current context

# ----------------------------------------------------------------------
# HIPAA Audit & Compliance
# ----------------------------------------------------------------------
ENABLE_HIPAA_AUDIT=true
HIPAA_AUDIT_LOG_PATH=/var/log/vitalops/audit.log
RETENTION_DAYS_AUDIT_LOG=365      # days before archiving

# ----------------------------------------------------------------------
# External Integrations
# ----------------------------------------------------------------------
# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=

# PagerDuty
PAGERDUTY_ROUTING_KEY=

# SMTP (email alerts)
SMTP_HOST=smtp.yourhospital.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vitalops@yourhospital.org

# ----------------------------------------------------------------------
# S3 / Object Storage for Backups & Artifacts
# ----------------------------------------------------------------------
BACKUP_BUCKET=emr-backups
BACKUP_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                 # optional for temporary creds
S3_ENDPOINT_URL=                   # set to MinIO or other custom endpoint

# ----------------------------------------------------------------------
# SLA / Load-Balancing Thresholds (defaults)
# ----------------------------------------------------------------------
SLA_RESPONSE_TIME_MS=250           # max p99 latency before scaling
SLA_ERROR_RATE_PERCENT=1           # max error percentage before failover
SLA_POD_CPU_THRESHOLD=0.80         # 80 % CPU triggers rebalance
SLA_POD_MEM_THRESHOLD=0.75         # 75 % memory triggers re-scheduling

# ----------------------------------------------------------------------
# ML Predictive Models
# ----------------------------------------------------------------------
MODEL_REGISTRY_URL=https://ml-registry.yourhospital.org
MODEL_REGISTRY_TOKEN=
MODEL_SERVING_GPU_ENABLED=false

# ----------------------------------------------------------------------
# TLS / Certificates
# ----------------------------------------------------------------------
TLS_CERT_PATH=/etc/vitalops/tls/cert.pem
TLS_KEY_PATH=/etc/vitalops/tls/key.pem
TLS_CA_PATH=/etc/vitalops/tls/ca-chain.pem
TLS_VERIFY_CLIENT=false            # set to true if mutual-TLS is enabled

# ----------------------------------------------------------------------
# CLI Defaults
# ----------------------------------------------------------------------
CLI_COLOR_OUTPUT=true
CLI_DEFAULT_FORMAT=table           # table | json | yaml

# ----------------------------------------------------------------------
# Time-outs & Retries
# ----------------------------------------------------------------------
HTTP_REQUEST_TIMEOUT_SEC=10
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SEC=5

# ----------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------
FEATURE_FLAG_EXPERIMENTAL_UI=false
FEATURE_FLAG_AUTO_ROLLOUT=true

# ----------------------------------------------------------------------
# End of File
# ----------------------------------------------------------------------