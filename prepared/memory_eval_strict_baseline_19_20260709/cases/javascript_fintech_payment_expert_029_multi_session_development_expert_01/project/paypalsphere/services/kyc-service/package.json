{
  "name": "@paypalsphere/kyc-service",
  "version": "1.2.0",
  "description": "KYC verification microservice for the PayPalsphere fintech social payment ecosystem.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/paypalsphere/paypalsphere.git",
    "directory": "services/kyc-service"
  },
  "bugs": {
    "url": "https://github.com/paypalsphere/paypalsphere/issues"
  },
  "keywords": [
    "fintech",
    "payments",
    "kyc",
    "event-sourcing",
    "cqrs",
    "microservice",
    "nodejs",
    "typescript"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "coverage": "npm run test -- --coverage",
    "prepare": "husky install",
    "commit": "cz"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.452.0",
    "@eventstore/db-client": "^3.0.1",
    "@fastify/helmet": "^8.4.2",
    "@fastify/rate-limit": "^8.4.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.37.0",
    "@paypalsphere/shared-lib": "workspace:*",
    "@sentry/node": "^7.100.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "fastify": "^4.22.2",
    "fastify-plugin": "^4.5.0",
    "helmet": "^7.0.0",
    "http-errors": "^2.0.0",
    "joi": "^17.11.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "node-fetch": "^3.3.2",
    "pino": "^8.14.0",
    "pino-pretty": "^10.2.0",
    "reflect-metadata": "^0.1.14",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.3",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.5.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}