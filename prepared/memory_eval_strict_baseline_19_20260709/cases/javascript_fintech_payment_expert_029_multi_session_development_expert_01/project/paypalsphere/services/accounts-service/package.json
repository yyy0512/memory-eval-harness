{
  "name": "@paypalsphere/accounts-service",
  "version": "1.3.0",
  "description": "Accounts bounded-context microservice for PayPalsphere – handles user wallets, account lifecycle, KYC state, and role mapping.",
  "private": true,
  "license": "Apache-2.0",
  "author": "PayPalsphere Engineering <engineering@paypalsphere.io>",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "babel src --extensions \".js,.jsx,.ts,.tsx\" --out-dir dist --copy-files --source-maps inline",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "NODE_ENV=development nodemon --legacy-watch --config ./nodemon.json",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint \"{src,test}/**/*.{js,ts}\" --max-warnings 0",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "migrate": "knex --knexfile ./src/infra/database/knexfile.js migrate:latest",
    "seed": "knex --knexfile ./src/infra/database/knexfile.js seed:run",
    "prepare": "husky install",
    "postinstall": "node ./scripts/postinstall.js",
    "preversion": "npm run lint && npm test",
    "release": "semantic-release"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "ajv": "^8.12.0",
    "amqplib": "^0.10.3",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.11.1",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "redis": "^4.6.7",
    "ulid": "^2.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/node": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.8.3",
    "@types/supertest": "^2.0.12",
    "cross-env": "^7.0.3",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "mockdate": "^3.0.5",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "semantic-release": "^23.0.5",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/index.js",
      "!src/**/contracts/**"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "config": {
    "service-name": "accounts-service",
    "service-port": "7060"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paypalsphere/accounts-service.git"
  },
  "keywords": [
    "fintech",
    "payments",
    "accounts",
    "microservice",
    "cqrs",
    "event-sourcing"
  ]
}