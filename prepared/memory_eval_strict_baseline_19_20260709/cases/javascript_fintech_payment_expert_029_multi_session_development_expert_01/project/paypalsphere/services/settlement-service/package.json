{
  "name": "@paypalsphere/settlement-service",
  "version": "1.3.0",
  "description": "Settlement micro-service for PayPalsphere — orchestrates multi-party settlements, FX conversion, and audit-grade ledger posting.",
  "private": true,
  "license": "Apache-2.0",
  "author": "PayPalsphere Engineering <engineering@paypalsphere.io>",
  "homepage": "https://github.com/paypalsphere/fintech_payment/tree/main/services/settlement-service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paypalsphere/fintech_payment.git",
    "directory": "services/settlement-service"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean && npm run lint",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon --config nodemon.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --max-warnings=0",
    "migrate": "typeorm-ts-node-commonjs migration:run -d ./src/infra/db/dataSource.ts",
    "seed": "ts-node -r tsconfig-paths/register ./scripts/seed.ts",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.6.0",
    "@opentelemetry/sdk-node": "^0.42.0",
    "@types/express": "^4.17.17",
    "ajv": "^8.12.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cls-hooked": "^4.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.18",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.2",
    "@commitlint/config-conventional": "^18.4.2",
    "@types/body-parser": "^1.19.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.13",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.11.9",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.12.1",
    "@typescript-eslint/parser": "^6.12.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.4.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/index.ts",
      "!src/**/types.ts",
      "!src/**/__tests__/**"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "env": {
      "es2022": true,
      "node": true,
      "jest": true
    },
    "plugins": [
      "@typescript-eslint",
      "import",
      "jest"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:jest/recommended",
      "prettier"
    ],
    "rules": {
      "import/order": [
        "error",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index"
          ],
          "newlines-between": "always"
        }
      ],
      "no-console": "warn",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}