{
  "name": "@paypalsphere/crypto-utils",
  "version": "1.0.0",
  "description": "Crypto utilities (field-level encryption, secure key derivation, signing helpers) used across the PayPalsphere fintech ecosystem.",
  "author": "PayPalsphere Engineering <engineering@paypalsphere.io>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/paypalsphere/fintech_payment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paypalsphere/fintech_payment.git",
    "directory": "packages/crypto-utils"
  },
  "bugs": {
    "url": "https://github.com/paypalsphere/fintech_payment/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/paypalsphere"
  },
  "keywords": [
    "fintech",
    "crypto",
    "encryption",
    "signing",
    "kyc",
    "pci-dss",
    "utilities"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.14",
    "npm": ">=8.3"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsup src/index.ts --format esm,cjs --dts --minify",
    "dev": "tsup src/index.ts --watch --onSuccess \"node ./dist/index.cjs\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --max-warnings=0",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "coverage": "npm run test -- --coverage",
    "prepare": "husky install",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^1.7.1",
    "@noble/hashes": "^1.3.0",
    "@noble/secp256k1": "^1.7.1",
    "argon2-browser": "^1.19.1",
    "base64-js": "^1.5.1",
    "buffer": "^6.0.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.0",
    "@paypalsphere/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.16.0",
    "@types/tweetnacl": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.3",
    "prettier": "^2.8.7",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsup": "^6.7.0",
    "typescript": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx,js}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}