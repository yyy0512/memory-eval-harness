{
  "name": "paypalsphere",
  "version": "1.0.0",
  "description": "PayPalsphere – A socially-driven fintech payment ecosystem (micro-frontend + micro-service monorepo).",
  "author": "PayPalsphere Engineering Team",
  "license": "BUSL-1.1",
  "private": true,
  "engines": {
    "node": ">=18.17",
    "npm": ">=9.6"
  },
  "packageManager": "npm@9.6.7",
  "type": "module",
  "funding": {
    "type": "github",
    "url": "https://github.com/paypalsphere"
  },

  /* -------------------------------------------------------------
   *  Monorepo Workspaces
   * ----------------------------------------------------------- */
  "workspaces": [
    "services/*",
    "packages/*",
    "frontends/*",
    "scripts"
  ],

  /* -------------------------------------------------------------
   *  Scripts – Shared Tasks for All Packages/Services
   * ----------------------------------------------------------- */
  "scripts": {
    "bootstrap": "npm run clean && npm install --workspaces --include-workspace-root",
    "clean": "rimraf node_modules .turbo && git clean -xfd --exclude=.idea --exclude=.vscode",
    "build": "turbo run build --parallel",
    "dev": "turbo run dev --parallel",
    "start": "turbo run start --parallel",
    "test": "turbo run test --parallel",
    "lint": "turbo run lint --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,yaml,md}\"",
    "commit": "cz",
    "release": "semantic-release",
    "audit": "npm audit --workspaces --audit-level=high",
    "security-check": "node ./scripts/security/check-vulnerabilities.mjs",
    "postinstall": "husky install",
    "generate": "prisma generate"
  },

  /* -------------------------------------------------------------
   *  Core Runtime Dependencies
   * ----------------------------------------------------------- */
  "dependencies": {
    "@apollo/server": "^4.7.4",
    "@fastify/rate-limit": "^8.10.0",
    "@fastify/secure-session": "^9.0.1",
    "@nestjs/common": "^10.2.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.2.3",
    "@nestjs/cqrs": "^10.1.2",
    "@nestjs/event-emitter": "^1.0.0",
    "@nestjs/microservices": "^10.2.3",
    "@nestjs/passport": "^10.2.3",
    "@nestjs/platform-express": "^10.2.3",
    "@nestjs/terminus": "^10.0.0",
    "@opentelemetry/instrumentation": "^0.43.0",
    "ajv": "^8.12.0",
    "argon2": "^0.31.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^4.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "eventstore-node": "^0.2.0",
    "graphql": "^16.7.1",
    "helmet": "^7.0.0",
    "jose": "^5.3.0",
    "jsonwebtoken": "^9.0.1",
    "luxon": "^3.3.0",
    "mqemitter-redis": "^0.5.0",
    "node-rdkafka": "^2.19.0",
    "pg": "^8.11.1",
    "pino": "^8.19.1",
    "pino-http": "^9.1.0",
    "pino-pretty": "^10.2.0",
    "prisma": "^5.4.0",
    "redis": "^4.6.11",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },

  /* -------------------------------------------------------------
   *  Development-Only Dependencies
   * ----------------------------------------------------------- */
  "devDependencies": {
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.5.0",
    "@shelf/jest-mongodb": "^4.2.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.7",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsdoc": "^46.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "lint-staged": "^15.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "semantic-release": "^23.0.8",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "turbo": "^1.10.12",
    "wait-on": "^7.1.2"
  },

  /* -------------------------------------------------------------
   *  Publish / Release Settings (via Semantic-Release)
   * ----------------------------------------------------------- */
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },

  /* -------------------------------------------------------------
   *  Husky & Lint-Staged – Pre-commit Gates
   * ----------------------------------------------------------- */
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },

  /* -------------------------------------------------------------
   *  Tooling Config – ESLint & Prettier to Keep Things Neat
   * ----------------------------------------------------------- */
  "eslintConfig": {
    "root": true,
    "env": {
      "es2023": true,
      "node": true,
      "jest": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "import",
      "prettier",
      "jsdoc"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "plugin:jsdoc/recommended",
      "plugin:prettier/recommended"
    ],
    "settings": {
      "import/parsers": {
        "@typescript-eslint/parser": [
          ".ts",
          ".tsx"
        ]
      },
      "import/resolver": {
        "typescript": {
          "alwaysTryTypes": true,
          "project": [
            "./tsconfig.json",
            "./services/*/tsconfig.json"
          ]
        }
      }
    },
    "rules": {
      "prettier/prettier": "error",
      "import/order": [
        "warn",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index"
          ],
          "newlines-between": "always"
        }
      ],
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  }
}