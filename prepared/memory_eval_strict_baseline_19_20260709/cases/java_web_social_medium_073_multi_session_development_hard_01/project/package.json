{
  "name": "@edupulse/live-learning-hub-web_social",
  "version": "1.0.0",
  "description": "EduPulse Live Learning Hub – Social-learning PWA with real-time micro-lessons, quizzes, and adaptive recommendations.",
  "private": true,
  "author": "EduPulse Engineering Team <engineering@edupulse.io>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "clean": "rimraf dist && rimraf coverage",
    "prepare": "husky install",
    "postinstall": "echo \"📦  Dependencies installed successfully.\""
  },
  "dependencies": {
    "@tanstack/react-query": "^4.29.1",
    "axios": "^1.6.2",
    "date-fns": "^2.31.0",
    "framer-motion": "^10.12.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.16.0",
    "socket.io-client": "^4.7.1",
    "styled-components": "^5.3.11",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cypress": "^13.5.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.33",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitlint": {
      "extends": [
        "@commitlint/config-conventional"
      ]
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 1 Edge versions",
    "not IE 11"
  ]
}