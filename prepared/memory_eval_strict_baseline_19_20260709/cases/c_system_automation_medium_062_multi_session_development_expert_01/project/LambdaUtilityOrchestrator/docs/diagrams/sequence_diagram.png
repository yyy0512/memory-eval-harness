/*
 * =====================================================================================
 *  Title        : generate_sequence_diagram.c
 *  Project      : LambdaUtility Orchestrator (system_automation)
 *  Description  : Stand-alone utility that generates an architectural sequence
 *                 diagram (PNG) for the LambdaUtility Orchestrator documentation.
 *                 It writes an embedded Graphviz DOT description to a temporary
 *                 file, calls the Graphviz “dot” renderer, and stores the final
 *                 PNG at: docs/diagrams/sequence_diagram.png
 *
 *  Build        : cc -Wall -Wextra -pedantic -std=c11 \
 *                      generate_sequence_diagram.c -o generate_sequence_diagram
 *
 *  Runtime deps : Graphviz (https://graphviz.org) – the “dot” executable must be
 *                 available in $PATH.
 *
 *  Usage        : ./generate_sequence_diagram             # default output path
 *                 ./generate_sequence_diagram /tmp/my.png # custom output path
 *
 *  License      : MIT
 * =====================================================================================
 */

#include <errno.h>
#include <fcntl.h>
#include <libgen.h>   /* dirname */
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

#define DEFAULT_OUTPUT "docs/diagrams/sequence_diagram.png"
#define DOT_BINARY     "dot"
#define DOT_FLAG       "-Tpng"

/* ----------------------------------------------------------------------------
 * Helper: Provide a robust, retrying mkdir -p implementation (POSIX).
 * --------------------------------------------------------------------------*/
static int mkdir_p(const char *path, mode_t mode)
{
    char *tmp = strdup(path);
    if (!tmp) return -1;

    char *p = tmp;

    /* Skip potential leading ‘/’ so dirname logic works */
    if (*p == '/') ++p;

    for (; *p; ++p)
    {
        if (*p == '/')
        {
            *p = '\0';
            if (mkdir(tmp, mode) == -1 && errno != EEXIST)
            {
                free(tmp);
                return -1;
            }
            *p = '/';
        }
    }

    if (mkdir(tmp, mode) == -1 && errno != EEXIST)
    {
        free(tmp);
        return -1;
    }

    free(tmp);
    return 0;
}

/* ----------------------------------------------------------------------------
 * Helper: Write DOT contents to a temporary file and return its path.
 * Caller must free() the returned string.
 * --------------------------------------------------------------------------*/
static char *write_dot_to_tmp(const char *dot_src)
{
    char tmp_template[] = "/tmp/lambda_seq_XXXXXX.dot";
    int fd = mkstemps(tmp_template, 4); /* suffix .dot */
    if (fd == -1)
    {
        perror("mkstemps");
        return NULL;
    }

    size_t len = strlen(dot_src);
    ssize_t wr = write(fd, dot_src, len);
    close(fd);

    if (wr == -1 || (size_t)wr != len)
    {
        perror("write");
        unlink(tmp_template);
        return NULL;
    }

    return strdup(tmp_template);
}

/* ----------------------------------------------------------------------------
 * Helper: Invoke Graphviz ‘dot’ to convert DOT -> PNG.
 * --------------------------------------------------------------------------*/
static int render_dot_to_png(const char *dot_file,
                             const char *output_png_path)
{
    /* Ensure destination folder exists */
    char *path_copy = strdup(output_png_path);
    if (!path_copy) return -1;
    char *dir = dirname(path_copy);

    if (mkdir_p(dir, 0755) == -1)
    {
        perror("mkdir_p");
        free(path_copy);
        return -1;
    }
    free(path_copy);

    /* Build command line string */
    char cmd[1024];
    int ret = snprintf(cmd, sizeof(cmd), "%s %s %s -o %s",
                       DOT_BINARY, DOT_FLAG, dot_file, output_png_path);

    if (ret < 0 || (size_t)ret >= sizeof(cmd))
    {
        fprintf(stderr, "Command line too long\n");
        return -1;
    }

    /* Execute command */
    int sys_ret = system(cmd);
    if (sys_ret == -1)
    {
        perror("system");
        return -1;
    }
    else if (WIFEXITED(sys_ret) && WEXITSTATUS(sys_ret) != 0)
    {
        fprintf(stderr, "'%s' exited with status %d.\n",
                DOT_BINARY, WEXITSTATUS(sys_ret));
        return -1;
    }

    return 0;
}

/* ----------------------------------------------------------------------------
 * Embedded Graphviz DOT source describing the main event-flow.
 * --------------------------------------------------------------------------*/
static const char DOT_SOURCE[] =
    "digraph LambdaUtilityOrchestrator {\n"
    "  rankdir=LR;\n"
    "  node[shape=box, style=\"rounded,filled\", fillcolor=\"#e3f2fd\"];\n"
    "  edge[fontname=\"Montserrat\", fontsize=10];\n"
    "\n"
    "  subgraph cluster_trigger {\n"
    "    label=\"Triggers\";\n"
    "    style=filled;\n"
    "    color=\"#bbdefb\";\n"
    "    Cron[label=\"Cron Schedule\"];\n"
    "    Topic[label=\"Message Bus Topic\"];\n"
    "    REST[label=\"REST Invoke\"];\n"
    "  }\n"
    "\n"
    "  Dispatcher[label=\"Event Dispatcher\", fillcolor=\"#c8e6c9\"];\n"
    "  Command[label=\"Command Factory\", fillcolor=\"#dcedc8\"];\n"
    "  Chain[label=\"Chain-of-Responsibility\", fillcolor=\"#fff9c4\"];\n"
    "  Observer[label=\"Observer Fan-out\", fillcolor=\"#ffe0b2\"];\n"
    "\n"
    "  Slack[label=\"Slack WebHook\", shape=component, fillcolor=\"#e1bee7\"];\n"
    "  Email[label=\"Email SMTP\", shape=component, fillcolor=\"#e1bee7\"];\n"
    "  SMS[label=\"SMS Gateway\", shape=component, fillcolor=\"#e1bee7\"];\n"
    "\n"
    "  Cron -> Dispatcher;\n"
    "  Topic -> Dispatcher;\n"
    "  REST -> Dispatcher;\n"
    "\n"
    "  Dispatcher -> Command;\n"
    "  Command -> Chain;\n"
    "  Chain -> Observer;\n"
    "\n"
    "  Observer -> Slack [label=\"notify\"];\n"
    "  Observer -> Email [label=\"notify\"];\n"
    "  Observer -> SMS   [label=\"notify\"];\n"
    "\n"
    "  {rank=same; Slack; Email; SMS}\n"
    "}\n";

/* ----------------------------------------------------------------------------
 * Entry point.
 * --------------------------------------------------------------------------*/
int main(int argc, char *argv[])
{
    const char *output_png = (argc > 1) ? argv[1] : DEFAULT_OUTPUT;

    /* Write DOT source */
    char *dot_tmp = write_dot_to_tmp(DOT_SOURCE);
    if (!dot_tmp)
    {
        fprintf(stderr, "Failed to create temporary DOT file.\n");
        return EXIT_FAILURE;
    }

    /* Render PNG */
    if (render_dot_to_png(dot_tmp, output_png) == -1)
    {
        fprintf(stderr, "Failed to render PNG to '%s'.\n", output_png);
        unlink(dot_tmp);
        free(dot_tmp);
        return EXIT_FAILURE;
    }

    printf("Diagram generated: %s\n", output_png);

    /* Clean up */
    unlink(dot_tmp);
    free(dot_tmp);
    return EXIT_SUCCESS;
}
```